{
  "name": "@rsgcsg/sts2-policy-runtime",
  "version": "0.1.0-rc.8",
  "description": "Small policy runtime over the strict STS2 Connector Player Environment",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./child-port": {
      "types": "./dist/policy-port-child.d.ts",
      "import": "./dist/policy-port-child.js"
    }
  },
  "bin": {
    "sts2-policy-runtime": "bin/policy-runtime.mjs",
    "sts2-policy-port": "bin/policy-port.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run test && npm run build && npm run check:package",
    "package": "npm run build && node tools/package.mjs",
    "check:package": "node tools/check-package.mjs"
  },
  "dependencies": {
    "@rsgcsg/sts2-connector-client": "https://github.com/rsgcsg/STS2-The-Pefect-Defect-Project/releases/download/compat/platform-import-v1/rsgcsg-sts2-connector-client-1.1.0-rc.1.tgz"
  },
  "devDependencies": {
    "@types/node": "^20.19.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rsgcsg/STS2-The-Pefect-Defect-Project.git",
    "directory": "components/policy-runtime"
  }
}
