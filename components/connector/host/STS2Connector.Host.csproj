<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- The disk artifact keeps the original Mod implementation ID so installs
         and rollback remain compatible. Product/source naming is Connector. -->
    <AssemblyName>STS2_MCP</AssemblyName>
    <RootNamespace>STS2Connector</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <SourceRevision Condition="'$(SourceRevision)' == ''">unavailable</SourceRevision>
    <!-- Component releases must not change when an unrelated monorepo component
         advances the workspace HEAD. The SDK uses SourceRevisionId in the
         informational version and, without this assignment, discovers the
         workspace revision from Git. -->
    <SourceRevisionId>$(SourceRevision)</SourceRevisionId>
    <!-- SDK SourceLink uses the monorepo HEAD and feeds its content ID back
         into both PDB and DLL. Public tags plus the embedded component revision
         are the authoritative source link for this Mod. -->
    <EnableSourceLink>false</EnableSourceLink>
    <PlayerEnvironmentSourceDigest Condition="'$(PlayerEnvironmentSourceDigest)' == ''">unavailable</PlayerEnvironmentSourceDigest>
    <STS2GameDir Condition="'$(STS2GameDir)' == '' and '$(STS2_GAME_DIR)' != ''">$(STS2_GAME_DIR)</STS2GameDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and '$(OS)' == 'Windows_NT'">$(STS2GameDir)/data_sts2_windows_x86_64</STS2GameDataDir>
    <!-- macOS support: DLLs live inside the .app bundle under Resources/data_sts2_macos_arm64 -->
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">$(STS2GameDir)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</STS2GameDataDir>
    <!-- Linux fallback (original behavior) -->
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == '' and '$(OS)' != 'Windows_NT' and !$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">$(STS2GameDir)/data_sts2_linuxbsd_x86_64</STS2GameDataDir>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SourceRevision" Value="$(SourceRevision)" />
    <AssemblyMetadata Include="PlayerEnvironmentSourceDigest" Value="$(PlayerEnvironmentSourceDigest)" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../contracts/native-logical-publication-profile-v1.json"
                      LogicalName="STS2Connector.NativeLogicalPublicationProfileV1" />
    <Compile Include="../../native-foundation/src/*.cs" Link="NativeFoundation/%(Filename)%(Extension)" />
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
