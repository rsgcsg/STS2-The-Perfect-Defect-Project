+namespace Sts2Headless;
+
+// Combines native owner facts only. Card legality remains in STS2's validators.
+internal static class NativePlayWindowAdmission
+{
+    internal static bool IsOpen(
+        bool combatRoomCurrent,
+        bool currentRunOwned,
+        bool combatInProgress,
+        bool playerAlive,
+        bool playerPlayPhase,
+        bool partOfPlayerTurn,
+        bool playerActionsEnabled,
+        bool notReadyToEndTurn,
+        bool actionQueuePlayPhase) =>
+        combatRoomCurrent
+        && currentRunOwned
+        && combatInProgress
+        && playerAlive
+        && playerPlayPhase
+        && partOfPlayerTurn
+        && playerActionsEnabled
+        && notReadyToEndTurn
+        && actionQueuePlayPhase;
+}
diff --git a/src/Sts2Headless/PerformanceLab.cs b/src/Sts2Headless/PerformanceLab.cs
new file mode 100644
index 0000000..aeeb8a2
--- /dev/null
+++ b/src/Sts2Headless/PerformanceLab.cs
@@ -0,0 +1,357 @@
+using System.Diagnostics;
+using System.Text.Json;
+
+namespace Sts2Headless;
+
+internal static class PerformanceLab
+{
+    private sealed record ActionRequest(string Action, Dictionary<string, object?>? Args);
+    private static readonly JsonSerializerOptions CompactJson = new()
+    {
+        WriteIndented = false,
+    };
+
+    public static Dictionary<string, object?> ProcessMetrics()
+    {
+        using var process = Process.GetCurrentProcess();
+        return new Dictionary<string, object?>
+        {
+            ["type"] = "process_metrics",
+            ["process_id"] = Environment.ProcessId,
+            ["cpu_total_ms"] = process.TotalProcessorTime.TotalMilliseconds,
+            ["working_set_bytes"] = process.WorkingSet64,
+            ["private_bytes"] = process.PrivateMemorySize64,
+            ["managed_heap_bytes"] = GC.GetTotalMemory(forceFullCollection: false),
+            ["allocated_bytes_total"] = GC.GetTotalAllocatedBytes(precise: false),
+            ["gen0_collections"] = GC.CollectionCount(0),
+            ["gen1_collections"] = GC.CollectionCount(1),
+            ["gen2_collections"] = GC.CollectionCount(2),
+        };
+    }
+
+    public static Dictionary<string, object?> Run(ref RunSimulator simulator, JsonElement command)
+    {
+        var episodes = Positive(command, "episodes", 5);
+        var warmupEpisodes = NonNegative(command, "warmup_episodes", 1);
+        var maxActions = Positive(command, "max_actions", 600);
+        var seedPrefix = Text(command, "seed_prefix", "H1ENGINE");
+        var character = Text(command, "character", "Ironclad");
+        var language = Text(command, "lang", "en");
+        var serializeEachDecision = Toggle(command, "serialize_each_decision", false);
+
+        var process = Process.GetCurrentProcess();
+        var cpuBefore = TimeSpan.Zero;
+        long allocatedBefore = 0;
+        var collectionsBefore = new int[3];
+        var measuredWall = Stopwatch.StartNew();
+        measuredWall.Stop();
+        long policyTicks = 0;
+        long executionTicks = 0;
+        double decisionProjectionMs = 0;
+        double serializationMs = 0;
+        long serializedBytes = 0;
+        double resetMs = 0;
+        var delivered = 0;
+        var terminalCounts = new Dictionary<string, int>(StringComparer.Ordinal);
+        var failure = (string?)null;
+
+        var previousError = Console.Error;
+        RunSimulator.PerformanceDiagnosticsSuppressed = true;
+        Console.SetError(TextWriter.Null);
+        try
+        {
+            var totalEpisodes = warmupEpisodes + episodes;
+            for (var episodeIndex = 0; episodeIndex < totalEpisodes; episodeIndex++)
+            {
+                if (episodeIndex > 0)
+                {
+                    simulator.CleanUp();
+                    simulator = new RunSimulator();
+                }
+
+                var measured = episodeIndex >= warmupEpisodes;
+                if (measured && !measuredWall.IsRunning)
+                {
+                    cpuBefore = process.TotalProcessorTime;
+                    allocatedBefore = GC.GetTotalAllocatedBytes(precise: false);
+                    collectionsBefore = new[] { GC.CollectionCount(0), GC.CollectionCount(1), GC.CollectionCount(2) };
+                    measuredWall.Start();
+                }
+                var resetStarted = Stopwatch.GetTimestamp();
+                var episodeSeed = measured
+                    ? $"{seedPrefix}E{episodeIndex - warmupEpisodes + 1:D3}"
+                    : $"{seedPrefix}W{episodeIndex + 1:D3}";
+                var state = simulator.StartRun(
+                    character,
+                    seed: episodeSeed,
+                    lang: language);
+                var resetElapsedMs = ElapsedMilliseconds(resetStarted);
+                if (measured)
+                {
+                    resetMs += resetElapsedMs;
+                }
+
+                var terminal = "action_limit";
+                for (var actionIndex = 0; actionIndex < maxActions; actionIndex++)
+                {
+                    var policyStarted = Stopwatch.GetTimestamp();
+                    var request = ChooseAction(state);
+                    var policyElapsed = Stopwatch.GetTimestamp() - policyStarted;
+                    if (request == null)
+                    {
+                        terminal = String(state, "decision") == "game_over"
+                            ? "game_over"
+                            : $"no_action:{String(state, "decision") ?? "unknown"}";
+                        break;
+                    }
+
+                    simulator.BeginDecisionProjectionTiming();
+                    var actionStarted = Stopwatch.GetTimestamp();
+                    state = simulator.ExecuteAction(request.Action, request.Args);
+                    var actionElapsed = Stopwatch.GetTimestamp() - actionStarted;
+                    var projectionElapsed = simulator.EndDecisionProjectionTimingMilliseconds();
+                    if (String(state, "type") != "decision")
+                    {
+                        terminal = $"execution_error:{String(state, "message") ?? "unknown"}";
+                        failure = terminal;
+                        break;
+                    }
+                    if (measured && serializeEachDecision)
+                    {
+                        var serializationStarted = Stopwatch.GetTimestamp();
+                        var serialized = JsonSerializer.SerializeToUtf8Bytes(state, CompactJson);
+                        serializationMs += ElapsedMilliseconds(serializationStarted);
+                        serializedBytes += serialized.LongLength;
+                    }
+                    if (measured)
+                    {
+                        policyTicks += policyElapsed;
+                        executionTicks += actionElapsed;
+                        decisionProjectionMs += projectionElapsed;
+                        delivered += 1;
+                    }
+                }
+
+                if (measured)
+                    terminalCounts[terminal] = terminalCounts.GetValueOrDefault(terminal) + 1;
+                if (failure != null) break;
+            }
+        }
+        finally
+        {
+            if (measuredWall.IsRunning) measuredWall.Stop();
+            RunSimulator.PerformanceDiagnosticsSuppressed = false;
+            Console.SetError(previousError);
+        }
+
+        var cpuAfter = process.TotalProcessorTime;
+        var allocatedAfter = GC.GetTotalAllocatedBytes(precise: false);
+        var executionMs = executionTicks * 1000.0 / Stopwatch.Frequency;
+        var policyMs = policyTicks * 1000.0 / Stopwatch.Frequency;
+        var nativeAndSettlingMs = Math.Max(0, executionMs - decisionProjectionMs);
+        var measuredWallMs = measuredWall.Elapsed.TotalMilliseconds;
+        var cpuMs = Math.Max(0, (cpuAfter - cpuBefore).TotalMilliseconds);
+
+        return new Dictionary<string, object?>
+        {
+            ["type"] = "engine_benchmark",
+            ["status"] = failure == null ? "measured_exact_game_owned_loop" : "benchmark_failed",
+            ["profile"] = "engine_in_process_raw_decision",
+            ["episodes"] = episodes,
+            ["warmup_episodes"] = warmupEpisodes,
+            ["max_actions_per_episode"] = maxActions,
+            ["seed_prefix"] = seedPrefix,
+            ["character"] = character,
+            ["language"] = language,
+            ["delivered_decisions"] = delivered,
+            ["terminal_counts"] = terminalCounts,
+            ["failure"] = failure,
+            ["wall_ms"] = measuredWallMs,
+            ["cpu_ms"] = cpuMs,
+            ["average_cpu_cores"] = measuredWallMs > 0 ? cpuMs / measuredWallMs : null,
+            ["reset_ms"] = resetMs,
+            ["policy_ms"] = policyMs,
+            ["execution_ms"] = executionMs,
+            ["decision_detection_and_raw_projection_ms"] = decisionProjectionMs,
+            ["json_serialization_shadow_enabled"] = serializeEachDecision,
+            ["json_serialization_shadow_ms"] = serializationMs,
+            ["json_serialization_shadow_bytes"] = serializedBytes,
+            ["json_serialization_shadow_bytes_per_decision"] = delivered > 0
+                ? serializedBytes / (double)delivered
+                : null,
+            ["native_commit_settling_and_host_lifecycle_ms"] = nativeAndSettlingMs,
+            ["hot_loop_decisions_per_second"] = executionMs > 0 ? delivered * 1000.0 / executionMs : null,
+            ["reset_inclusive_decisions_per_second"] = measuredWallMs > 0 ? delivered * 1000.0 / measuredWallMs : null,
+            ["allocated_bytes"] = Math.Max(0, allocatedAfter - allocatedBefore),
+            ["allocated_bytes_per_decision"] = delivered > 0
+                ? Math.Max(0, allocatedAfter - allocatedBefore) / (double)delivered
+                : null,
+            ["gc_collections"] = new Dictionary<string, object?>
+            {
+                ["gen0"] = GC.CollectionCount(0) - collectionsBefore[0],
+                ["gen1"] = GC.CollectionCount(1) - collectionsBefore[1],
+                ["gen2"] = GC.CollectionCount(2) - collectionsBefore[2],
+            },
+            ["semantic_boundary"] = "exact STS2 rules/RNG/effects/Commit plus managed decision detection; no Player Environment, SDK, JSON-per-step, Node policy, Reads or evidence",
+        };
+    }
+
+    private static ActionRequest? ChooseAction(Dictionary<string, object?> state)
+    {
+        switch (String(state, "decision"))
+        {
+            case "map_select":
+            {
+                var choice = Rows(state, "choices")
+                    .OrderBy(row => Integer(row, "row"))
+                    .ThenBy(row => Integer(row, "col"))
+                    .FirstOrDefault();
+                return choice == null ? null : Request("select_map_node",
+                    ("col", Integer(choice, "col")),
+                    ("row", Integer(choice, "row")),
+                    ("map_point_ref", String(choice, "native_ref")));
+            }
+            case "combat_play":
+            {
+                var playable = Rows(state, "hand")
+                    .Where(card => Boolean(card, "can_play"))
+                    .OrderBy(card => String(card, "id"), StringComparer.Ordinal)
+                    .ThenBy(card => Integer(card, "index"))
+                    .ToList();
+                if (playable.Count == 0)
+                    return Request("end_turn", ("player_ref", String(Row(state, "player"), "native_ref")));
+                var card = playable[0];
+                var args = new Dictionary<string, object?>
+                {
+                    ["card_ref"] = String(card, "native_ref")
+                };
+                if (String(card, "target_type") == "AnyEnemy")
+                {
+                    var valid = Strings(card, "valid_target_refs").ToHashSet(StringComparer.Ordinal);
+                    var target = Rows(state, "enemies")
+                        .Where(enemy => Integer(enemy, "hp") > 0 && valid.Contains(String(enemy, "native_ref") ?? ""))
+                        .OrderBy(enemy => String(enemy, "id"), StringComparer.Ordinal)
+                        .ThenBy(enemy => Integer(enemy, "index"))
+                        .FirstOrDefault();
+                    if (target == null) return null;
+                    args["target_ref"] = String(target, "native_ref");
+                }
+                return new ActionRequest("play_card", args);
+            }
+            case "event_choice":
+            {
+                var option = Rows(state, "options")
+                    .Where(row => !Boolean(row, "is_locked"))
+                    .OrderBy(row => Integer(row, "index"))
+                    .FirstOrDefault();
+                return option == null
+                    ? Request("leave_room")
+                    : Request("choose_option", ("option_index", Integer(option, "index")));
+            }
+            case "rest_site":
+            {
+                if (Boolean(state, "can_proceed"))
+                    return RequestWithRequired("proceed", "room_ref", String(state, "room_ref"));
+                var options = Rows(state, "options").Where(row => !row.ContainsKey("is_enabled") || Boolean(row, "is_enabled")).ToList();
+                var option = options.FirstOrDefault(row => String(row, "option_id") == "HEAL")
+                    ?? options.OrderBy(row => String(row, "option_id"), StringComparer.Ordinal).FirstOrDefault();
+                return option == null ? null : Request("choose_option",
+                    ("option_index", Integer(option, "index")),
+                    ("option_ref", String(option, "native_ref")));
+            }
+            case "treasure_chest":
+                return RequestWithRequired("open_treasure", "room_ref", String(state, "room_ref"));
+            case "treasure_relic":
+            {
+                var relic = Rows(state, "relics").FirstOrDefault();
+                return relic != null
+                    ? RequestWithRequired("select_treasure_relic", "relic_ref", String(relic, "native_ref"))
+                    : Boolean(state, "can_skip")
+                        ? RequestWithRequired("skip_treasure_relic", "room_ref", String(state, "room_ref"))
+                        : null;
+            }
+            case "treasure_complete":
+                return RequestWithRequired("leave_room", "room_ref", String(state, "room_ref"));
+            case "reward_set":
+            {
+                var reward = Rows(state, "rewards").FirstOrDefault();
+                if (reward != null)
+                    return RequestWithRequired("select_reward", "reward_ref", String(reward, "native_ref"));
+                if (Boolean(state, "is_terminal") && Boolean(state, "can_proceed"))
+                    return RequestWithRequired("proceed", "room_ref", String(state, "room_ref"));
+                return Boolean(state, "can_skip") ? Request("skip_rewards") : null;
+            }
+            case "card_reward":
+                return Rows(state, "cards").Count == 0
+                    ? Request("skip_card_reward")
+                    : Request("select_card_reward", ("card_index", 0));
+            case "combat_rewards_complete":
+                return RequestWithRequired("proceed", "room_ref", String(state, "room_ref"));
+            case "bundle_select":
+                return Request("select_bundle", ("bundle_index", 0));
+            case "card_select":
+                return Rows(state, "cards").Count == 0
+                    ? Request("skip_select")
+                    : Request("select_cards", ("indices", "0"));
+            case "shop":
+                return RequestWithRequired("leave_shop", "room_ref", String(state, "room_ref"));
+            case "game_over":
+                return null;
+            default:
+                return null;
+        }
+    }
+
+    private static ActionRequest Request(string action, params (string Key, object? Value)[] pairs) =>
+        new(action, pairs.Length == 0 ? null : pairs.ToDictionary(pair => pair.Key, pair => pair.Value));
+
+    private static ActionRequest? RequestWithRequired(string action, string key, string? value) =>
+        string.IsNullOrEmpty(value) ? null : Request(action, (key, value));
+
+    private static IReadOnlyList<Dictionary<string, object?>> Rows(Dictionary<string, object?> row, string key) =>
+        row.TryGetValue(key, out var value) && value is IEnumerable<Dictionary<string, object?>> values
+            ? values.ToList()
+            : Array.Empty<Dictionary<string, object?>>();
+
+    private static Dictionary<string, object?> Row(Dictionary<string, object?> row, string key) =>
+        row.TryGetValue(key, out var value) && value is Dictionary<string, object?> nested
+            ? nested
+            : new Dictionary<string, object?>();
+
+    private static IReadOnlyList<string> Strings(Dictionary<string, object?> row, string key) =>
+        row.TryGetValue(key, out var value) && value is IEnumerable<string> values
+            ? values.ToList()
+            : Array.Empty<string>();
+
+    private static string? String(Dictionary<string, object?> row, string key) =>
+        row.TryGetValue(key, out var value) ? value?.ToString() : null;
+
+    private static int Integer(Dictionary<string, object?> row, string key) =>
+        row.TryGetValue(key, out var value) && value != null ? Convert.ToInt32(value) : 0;
+
+    private static bool Boolean(Dictionary<string, object?> row, string key) =>
+        row.TryGetValue(key, out var value) && value is bool boolean && boolean;
+
+    private static int Positive(JsonElement command, string name, int fallback)
+    {
+        var value = command.TryGetProperty(name, out var element) ? element.GetInt32() : fallback;
+        if (value < 1) throw new ArgumentOutOfRangeException(name, "Must be positive.");
+        return value;
+    }
+
+    private static int NonNegative(JsonElement command, string name, int fallback)
+    {
+        var value = command.TryGetProperty(name, out var element) ? element.GetInt32() : fallback;
+        if (value < 0) throw new ArgumentOutOfRangeException(name, "Must be non-negative.");
+        return value;
+    }
+
+    private static string Text(JsonElement command, string name, string fallback) =>
+        command.TryGetProperty(name, out var element) ? element.GetString() ?? fallback : fallback;
+
+    private static bool Toggle(JsonElement command, string name, bool fallback) =>
+        command.TryGetProperty(name, out var element) ? element.GetBoolean() : fallback;
+
+    private static double ElapsedMilliseconds(long started) =>
+        (Stopwatch.GetTimestamp() - started) * 1000.0 / Stopwatch.Frequency;
+}
