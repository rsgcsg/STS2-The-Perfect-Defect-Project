+        && FixedConstructorsUnpatched(typeof(DynamicVarSet)) && CloneLambdaUnpatched(typeof(DynamicVarSet))
+        && MethodsUnpatched(typeof(DynamicVar), "Clone", "ResetToBase", "SetOwner", "get_Name", "get_BaseValue", "set_BaseValue",
+            "get_EnchantedValue", "set_EnchantedValue", "get_PreviewValue", "set_PreviewValue", "get_WasJustUpgraded", "set_WasJustUpgraded")
+        && MethodsUnpatched(typeof(CardEnergyCost), "Clone", "get_Canonical", "get_CostsX", "get_WasJustUpgraded", "set_WasJustUpgraded")
+        && FixedConstructorsUnpatched(typeof(CardEnergyCost)) && CloneLambdaUnpatched(typeof(CardEnergyCost))
+        && MethodsUnpatched(typeof(LocalCostModifier), "Clone", "get_Amount", "set_Amount", "get_Type", "get_Expiration", "get_IsReduceOnly")
+        && FixedConstructorsUnpatched(typeof(LocalCostModifier));
+
+    internal static bool TryPreflightCopy(CardModel card, out string? gap)
+    {
+        gap = "native_preview_copy_closure_unqualified";
+        try
+        {
+            if (typeof(CardModel).Assembly.ManifestModule.ModuleVersionId != AuditedGameMvid
+                || card.GetType().Assembly != typeof(CardModel).Assembly
+                || card.GetType().Namespace != "MegaCrit.Sts2.Core.Models.Cards"
+                || Mutable?.GetValue(card) is not true || !CopyClosureUnpatched()
+                || !BaseImplementation(card.GetType(), typeof(CardModel), "DeepCloneFields")
+                || !BaseImplementation(card.GetType(), typeof(CardModel), "AfterCloned")
+                || !BaseImplementation(card.GetType(), typeof(CardModel), "get_CanonicalEnergyCost")
+                || !BaseImplementation(card.GetType(), typeof(CardModel), "get_HasEnergyCostX")) return false;
+            if (!CopiedDelegatesQualified(card) || !AttachmentCopyQualified(card))
+            { gap = "native_preview_existing_attachment_copy_callbacks_unqualified"; return false; }
+            if (Canonical?.GetValue(card) is not CardModel canonical || canonical.GetType() != card.GetType()
+                || Mutable.GetValue(canonical) is not false || Keywords?.GetValue(card) is not HashSet<CardKeyword> keywords
+                || keywords.GetType() != typeof(HashSet<CardKeyword>) || !ReferenceEquals(keywords.Comparer, EqualityComparer<CardKeyword>.Default)
+                || typeof(CardModel).GetField("_temporaryStarCosts", NativeMembers)?.GetValue(card) is not List<TemporaryCardCost> temporary
+                || temporary.GetType() != typeof(List<TemporaryCardCost>)
+                || CardVars?.GetValue(card) is not DynamicVarSet vars || !CopyVariablesQualified(card, vars) || !CopyCostQualified(card))
+            { gap = "native_preview_initialized_card_copy_facts_unqualified"; return false; }
+            gap = null;
+            return true;
+        }
+        catch { return false; }
+    }
+
+    internal static bool TryPreflightCanonicalHover(CardModel canonical, out string? gap)
+    {
+        gap = "native_canonical_hover_copy_closure_unqualified";
+        try
+        {
+            if (typeof(CardModel).Module.ModuleVersionId != AuditedGameMvid || canonical.GetType() != typeof(Shiv)
+                || Mutable?.GetValue(canonical) is not false || !CopyClosureUnpatched()
+                || !BaseImplementation(canonical.GetType(), typeof(CardModel), "DeepCloneFields")
+                || !BaseImplementation(canonical.GetType(), typeof(CardModel), "AfterCloned")
+                || !MethodsUnpatched(typeof(CardModel), "get_CanonicalKeywords")
+                || !MethodsUnpatched(typeof(Shiv), "get_CanonicalVars", "get_CanonicalKeywords")
+                || !FixedConstructorsUnpatched(typeof(DynamicVar)) || !FixedConstructorsUnpatched(typeof(DamageVar))
+                || !MethodsUnpatched(typeof(DamageVar), "set_Props")
+                || !SingletonVariableListUnpatched() || !SingletonListUnpatched(typeof(CardKeyword)) || !CopiedDelegatesQualified(canonical)
+                || Enchantment?.GetValue(canonical) != null || Affliction?.GetValue(canonical) != null
+                || !CopyCostQualified(canonical)) return false;
+            if (CardVars?.GetValue(canonical) is DynamicVarSet initialized && !CopyVariablesQualified(canonical, initialized)) return false;
+            if (Keywords?.GetValue(canonical) is { } keywords
+                && (keywords is not HashSet<CardKeyword> set || set.GetType() != typeof(HashSet<CardKeyword>)
+                    || !ReferenceEquals(set.Comparer, EqualityComparer<CardKeyword>.Default))) return false;
+            if (typeof(CardModel).GetField("_temporaryStarCosts", NativeMembers)?.GetValue(canonical) is not List<TemporaryCardCost> temporary
+                || temporary.GetType() != typeof(List<TemporaryCardCost>)) return false;
+            if (Canonical?.GetValue(canonical) is { } parent && !ReferenceEquals(parent, canonical)) return false;
+            if (!CanonicalRegistryBindingQualified(canonical))
+            { gap = "native_canonical_hover_registry_binding_unqualified"; return false; }
+            gap = null;
+            return true;
+        }
+        catch { return false; }
+    }
+
+    private static bool CanonicalRegistryBindingQualified(CardModel canonical)
+    {
+        if (!MethodsUnpatched(typeof(AbstractModel), "get_Id")
+            || !MethodsUnpatched(typeof(ModelDb), "GetById", "GetByIdOrNull")
+            || !MethodsUnpatched(typeof(ModelId), "GetHashCode", "Equals", "get_EqualityContract", "get_Category", "get_Entry")
+            || !IsUnpatched(typeof(ModelDb).GetMethod("GetById", NativeMembers)?.MakeGenericMethod(typeof(CardModel)))
+            || !IsUnpatched(typeof(ModelDb).GetMethod("GetByIdOrNull", NativeMembers)?.MakeGenericMethod(typeof(CardModel)))) return false;
+        // No arbitrary dictionary comparer or derived ModelId equality can run
+        // during this lookup. Enumeration of these definition keys invokes no
+        // model methods and exposes no catalog/world data to the consumer.
+        if (typeof(ModelDb).GetField("_contentById", NativeMembers)?.GetValue(null) is not Dictionary<ModelId, AbstractModel> registry
+            || registry.GetType() != typeof(Dictionary<ModelId, AbstractModel>)
+            || !ReferenceEquals(registry.Comparer, EqualityComparer<ModelId>.Default)
+            || registry.Keys.Any(key => key is null || key.GetType() != typeof(ModelId))) return false;
+        ModelId id = canonical.Id;
+        return id.GetType() == typeof(ModelId) && registry.TryGetValue(id, out AbstractModel? current)
+            && ReferenceEquals(current, canonical);
+    }
+
+    internal static bool TryPreflightUpgrade(CardModel card, out string? gap)
+    {
+        if (!TryPreflightCopy(card, out gap)) return false;
+        gap = "native_preview_upgrade_closure_unqualified";
+        try
+        {
+            // Explicit exact-build method inventory; it contains no costs,
+            // damage values or other reimplementation of native upgrade rules.
+            if (card.GetType().GetMethod("OnUpgrade", NativeMembers) is not { } upgrade
+                || !(upgrade.DeclaringType == typeof(CardModel)
+                    || upgrade.DeclaringType == card.GetType() && NativeUpgradeMethodInventory.Contains(card.GetType().Name))
+                // Harmony keys inherited methods by their actual declaration.
+                || !IsUnpatched(upgrade.DeclaringType?.GetMethod("OnUpgrade", NativeMembers | BindingFlags.DeclaredOnly))
+                || !BaseImplementation(card.GetType(), typeof(CardModel), "get_MaxUpgradeLevel")
+                || !MethodsUnpatched(typeof(CardModel), "UpgradeInternal", "get_IsUpgradable", "get_CurrentUpgradeLevel",
+                    "set_CurrentUpgradeLevel", "get_MaxUpgradeLevel", "AddKeyword", "RemoveKeyword", "InvokeEnergyCostChanged",
+                    "get_UpgradePreviewType", "set_UpgradePreviewType")
+                || !MethodsUnpatched(typeof(DynamicVar), "UpgradeValueBy", "get_WasJustUpgraded", "set_WasJustUpgraded")
+                || !NativeUpgradeMethodInventory.VariableGetters.All(name => MethodsUnpatched(typeof(DynamicVarSet), name))
+                || !MethodsUnpatched(typeof(CardEnergyCost), "UpgradeBy", "SetCustomBaseCost")
+                || !MethodsUnpatched(typeof(LocalCostModifier), "set_Amount")) return false;
+            if (!card.IsUpgradable) { gap = "native_preview_card_not_upgradable"; return false; }
+            gap = null;
+            return true;
+        }
+        catch { return false; }
+    }
+
+    internal static bool TryPreflightSingleEnchant(CardModel card, EnchantmentModel canonical, out string? gap)
+    {
+        if (!TryPreflightCopy(card, out gap)) return false;
+        gap = "native_preview_enchantment_closure_unqualified";
+        try
+        {
+            Type type = canonical.GetType();
+            if (type.Assembly != typeof(CardModel).Assembly || type.Namespace != "MegaCrit.Sts2.Core.Models.Enchantments"
+                || !NativeEnchantmentMethodInventory.Types.Contains(type.Name) || Mutable?.GetValue(canonical) is not false
+                || !MethodsUnpatched(typeof(AbstractModel), "AssertCanonical")
+                || !MethodsUnpatched(typeof(EnchantmentModel), "ToMutable", "DeepCloneFields", "get_DynamicVars", "get_CanonicalVars",
+                    "set_CanonicalInstance", "ApplyInternal", "get_Card", "set_Card", "get_Amount", "set_Amount",
+                    "ModifyCard", "OnEnchant", "RecalculateValues")
+                || !MethodsUnpatched(typeof(CardModel), "EnchantInternal", "set_Enchantment", "set_IsEnchantmentPreview", "AddKeyword", "RemoveKeyword")
+                || !BaseImplementation(type, typeof(EnchantmentModel), "DeepCloneFields")
+                || !BaseImplementation(type, typeof(AbstractModel), "AfterCloned")
+                || typeof(AbstractModel).GetField("ExecutionFinished", NativeMembers)?.GetValue(canonical) != null
+                || typeof(EnchantmentModel).GetField("StatusChanged", NativeMembers)?.GetValue(canonical) != null) return false;
+            if (typeof(EnchantmentModel).GetField("_dynamicVars", NativeMembers)?.GetValue(canonical) is DynamicVarSet existing
+                && !CopyVariablesQualified(canonical, existing)) return false;
+            MethodInfo? onEnchant = type.GetMethod("OnEnchant", NativeMembers);
+            if (!IsUnpatched(onEnchant)) return false;
+            if (onEnchant!.DeclaringType != typeof(EnchantmentModel)
+                && !NativeEnchantmentMethodInventory.KeywordUpdates.Contains(type.Name)
+                && type != typeof(TezcatarasEmber))
+            {
+                // SoulsPower invokes CardCmd.RemoveKeyword -> FindOnTable,
+                // rather than the model-only primitive. Its native UI lookup
+                // closure is an explicit remaining row, never executed here.
+                gap = "native_preview_enchantment_command_ui_lookup_unqualified";
+                return false;
+            }
+            MethodInfo? recalculate = type.GetMethod("RecalculateValues", NativeMembers);
+            if (!IsUnpatched(recalculate) || recalculate!.DeclaringType != typeof(EnchantmentModel) && type != typeof(Adroit)) return false;
+            MethodInfo? factory = type.GetMethod("get_CanonicalVars", NativeMembers);
+            if (!IsUnpatched(factory) || factory!.DeclaringType != typeof(EnchantmentModel)
+                && !NativeEnchantmentMethodInventory.VariableFactories.Contains(type.Name)) return false;
+            if (factory.DeclaringType != typeof(EnchantmentModel)
+                && (!FixedConstructorsUnpatched(typeof(DynamicVar)) || !FixedConstructorsUnpatched(typeof(BlockVar))
+                    || !FixedConstructorsUnpatched(typeof(DamageVar)) || !MethodsUnpatched(typeof(DamageVar), "set_Props") || !FixedConstructorsUnpatched(typeof(IntVar))
+                    || !FixedConstructorsUnpatched(typeof(PowerVar<WeakPower>)) || !SingletonVariableListUnpatched())) return false;
+            if (type == typeof(Adroit) && !MethodsUnpatched(typeof(DynamicVarSet), "get_Block")) return false;
+            if (type == typeof(TezcatarasEmber)
+                && (!MethodsUnpatched(typeof(AbstractModel), "get_IsCanonical")
+                    || !MethodsUnpatched(typeof(CardEnergyCost), "GetWithModifiers", "UpgradeBy", "SetCustomBaseCost")
+                    || !MethodsUnpatched(typeof(CardModel), "InvokeEnergyCostChanged")
+                    || !MethodsUnpatched(typeof(LocalCostModifier), "set_Amount"))) return false;
+            gap = null;
+            return true;
+        }
+        catch { return false; }
+    }
+
+    private static bool SingletonVariableListUnpatched() => SingletonListUnpatched(typeof(DynamicVar));
+
+    private static bool SingletonListUnpatched(Type element)
+    {
+        Type? fixedType = typeof(CardModel).Assembly.GetType("<>z__ReadOnlySingleElementList`1")?.MakeGenericType(element);
+        return fixedType != null && fixedType.GetMethods(NativeMembers).All(IsUnpatched)
+            && FixedConstructorsUnpatched(fixedType)
+            && fixedType.GetNestedTypes(NativeMembers).All(type => type.GetMethods(NativeMembers).All(IsUnpatched)
+                && FixedConstructorsUnpatched(type));
+    }
+}
diff --git a/src/Sts2Headless/NativeCardRenderTransaction.cs b/src/Sts2Headless/NativeCardRenderTransaction.cs
new file mode 100644
index 0000000..9398ed0
--- /dev/null
+++ b/src/Sts2Headless/NativeCardRenderTransaction.cs
@@ -0,0 +1,82 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Localization.DynamicVars;
+using MegaCrit.Sts2.Core.Models;
+
+namespace STS2Platform.NativeFoundation;
+
+// Only the pinned native Normal card renderer is invoked. Keep the actual card's
+// owner/pile context; a detached clone would change native preview calculations.
+// This transaction restores arbitrary prior preview values, not just base values.
+internal sealed class NativeRenderStateViolationException(string message, Exception? inner) : Exception(message, inner);
+
+internal static class NativeCardRenderTransaction
+{
+    private sealed record Saved(DynamicVar Variable, decimal Base, bool Upgraded,
+        decimal Enchanted, decimal Preview, string? EnergyPrefix)
+    {
+        internal static Saved Capture(DynamicVar value) => new(value, value.BaseValue,
+            value.WasJustUpgraded, value.EnchantedValue, value.PreviewValue,
+            value is EnergyVar energy ? energy.ColorPrefix : null);
+        internal void Restore()
+        {
+            Variable.EnchantedValue = Enchanted;
+            Variable.PreviewValue = Preview;
+            if (Variable is EnergyVar energy) energy.ColorPrefix = EnergyPrefix!;
+        }
+        internal bool Exact => Variable.BaseValue == Base && Variable.WasJustUpgraded == Upgraded
+            && Variable.EnchantedValue == Enchanted && Variable.PreviewValue == Preview
+            && (Variable is not EnergyVar energy || energy.ColorPrefix == EnergyPrefix);
+    }
+
+    private static readonly HashSet<Type> KnownVariables = new()
+    {
+        typeof(DynamicVar), typeof(BlockVar), typeof(BoolVar), typeof(CalculatedBlockVar),
+        typeof(CalculatedDamageVar), typeof(CalculatedVar), typeof(CalculationBaseVar),
+        typeof(CalculationExtraVar), typeof(CardsVar), typeof(DamageVar), typeof(EnergyVar),
+        typeof(ExtraDamageVar), typeof(ForgeVar), typeof(GoldVar), typeof(HealVar),
+        typeof(HpLossVar), typeof(IfUpgradedVar), typeof(IntVar), typeof(MaxHpVar),
+        typeof(OstyDamageVar), typeof(RepeatVar), typeof(StarsVar), typeof(StringVar), typeof(SummonVar)
+    };
+
+    private static bool Known(DynamicVar value) => KnownVariables.Contains(value.GetType())
+        || value.GetType().IsGenericType
+            && value.GetType().GetGenericTypeDefinition() == typeof(PowerVar<>);
+
+    internal static T Run<T>(CardModel card, PileType displayPile, Func<T> capture, CardPreviewMode mode = CardPreviewMode.Normal)
+    {
+        NativeCardPreviewReadQualification.InvokePreflight(card, mode, displayPile);
+        DynamicVar[] cardVars = card.DynamicVars.Values.ToArray();
+        DynamicVar[] enchantVars = card.Enchantment?.DynamicVars.Values.ToArray() ?? [];
+        DynamicVar[] all = cardVars.Concat(enchantVars).ToArray();
+        if (all.Any(value => !Known(value)) || all.Distinct(ReferenceEqualityComparer.Instance).Count() != all.Length)
+            throw new InvalidOperationException("Unqualified native preview variable type or alias");
+        Saved[] saved = all.Select(Saved.Capture).ToArray();
+        var enchantment = card.Enchantment;
+        Exception? primary = null;
+        try
+        {
+            card.DynamicVars.ClearPreview();
+            card.UpdateDynamicVarPreview(mode, card.CurrentTarget, card.DynamicVars);
+            if (enchantment != null)
+            {
+                enchantment.DynamicVars.ClearPreview();
+                card.UpdateDynamicVarPreview(mode, card.CurrentTarget, enchantment.DynamicVars);
+            }
+            return capture();
+        }
+        catch (Exception error) { primary = error; throw; }
+        finally
+        {
+            foreach (Saved value in saved) value.Restore();
+            if (!ReferenceEquals(card.Enchantment, enchantment)
+                || !card.DynamicVars.Values.SequenceEqual(cardVars, ReferenceEqualityComparer.Instance)
+                || !(enchantment?.DynamicVars.Values ?? Array.Empty<DynamicVar>())
+                    .SequenceEqual(enchantVars, ReferenceEqualityComparer.Instance)
+                || saved.Any(value => !value.Exact))
+                throw new NativeRenderStateViolationException("Native card rendering changed its owned preview state", primary);
+        }
+    }
+}
diff --git a/src/Sts2Headless/NativeCardRewardAlternativePreview.cs b/src/Sts2Headless/NativeCardRewardAlternativePreview.cs
new file mode 100644
index 0000000..18e9db0
--- /dev/null
+++ b/src/Sts2Headless/NativeCardRewardAlternativePreview.cs
@@ -0,0 +1,161 @@
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Entities.CardRewardAlternatives;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Entities.Rewards;
+using MegaCrit.Sts2.Core.Hooks;
+using MegaCrit.Sts2.Core.Modding;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Relics;
+using MegaCrit.Sts2.Core.Rewards;
+using MegaCrit.Sts2.Core.Runs;
+
+namespace STS2Platform.NativeFoundation;
+
+public sealed record NativeCardRewardAlternativePreviewFact(string OptionId, string Title, string AfterSelected)
+{ public bool IsNativeSkip { get; init; } }
+public sealed record NativeCardRewardAlternativePreviewResult(bool Complete,
+    IReadOnlyList<NativeCardRewardAlternativePreviewFact>? Alternatives,
+    bool? CanSkipSelection, bool? CanReroll, bool? SelectionCompletesReward, string? Gap);
+
+/// <summary>
+/// Bounded purity qualification for the inspected native alternative factory.
+/// Generate remains the choice authority. No selection delegate is invoked,
+/// and no unknown mod subscriber is enumerated to discover whether it is safe.
+/// The same source is compiled into both exact Host implementations.
+/// </summary>
+public static class NativeCardRewardAlternativePreview
+{
+    private static readonly Type[] AlternativeSignature =
+        { typeof(Player), typeof(CardReward), typeof(List<CardRewardAlternative>) };
+    private static readonly Type[] CompletionSignature = { typeof(Player), typeof(CardReward) };
+    private static MethodInfo? Effective(Type type, string name, Type[] signature) =>
+        type.GetMethod(name, BindingFlags.Instance | BindingFlags.Public, null, signature, null);
+    private static bool Unpatched(MethodBase? method) => NativeRunHookReadQualification.IsUnpatched(method);
+    private static bool GetterIsUnpatched(Type owner, string name) =>
+        Unpatched(owner.GetProperty(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)?.GetMethod);
+    private static bool CardsProjectionIsUnpatched()
+    {
+        MethodInfo[] lambdas = typeof(CardReward).GetNestedType("<>c", BindingFlags.NonPublic)?
+            .GetMethods(BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic)
+            .Where(method => method.Name.StartsWith("<get_Cards>b__", StringComparison.Ordinal)).ToArray()
+            ?? Array.Empty<MethodInfo>();
+        return lambdas.Length == 1 && Unpatched(lambdas[0]);
+    }
+
+    public static string? Outcome(PostAlternateCardRewardAction value) => value switch
+    {
+        PostAlternateCardRewardAction.DoNothing => "do_nothing",
+        PostAlternateCardRewardAction.EndSelectionAndCompleteReward => "end_selection_and_complete_reward",
+        PostAlternateCardRewardAction.EndSelectionAndDoNotCompleteReward => "end_selection_and_do_not_complete_reward",
+        _ => null
+    };
+
+    private static readonly MethodInfo? EmptySelection = typeof(CardRewardAlternative)
+        .GetNestedType("<>c", BindingFlags.NonPublic)?.GetMethod("<.ctor>b__16_0", BindingFlags.Instance | BindingFlags.NonPublic);
+    /// <summary>Only the currently attached native handler is observed. Absence
+    /// is not history: manually offered rewards may start without this handler.</summary>
+    public static string NativeRelicRefreshSubscription(CardReward reward)
+    {
+        try
+        {
+            var flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly;
+            FieldInfo? field = typeof(Player).GetField("RelicObtained", flags);
+            MethodInfo? handler = typeof(CardReward).GetMethod("OnRelicObtained", flags, null, new[] { typeof(RelicModel) }, null);
+            PropertyInfo? playerGetter = typeof(Reward).GetProperty("Player", BindingFlags.Instance | BindingFlags.Public);
+            if (typeof(CardReward).Module.ModuleVersionId != new Guid("57785517-0b16-42b9-8b36-bad6fb28384b")
+                || reward.GetType() != typeof(CardReward) || !Unpatched(playerGetter?.GetMethod)
+                || !Unpatched(handler) || field?.FieldType != typeof(Action<RelicModel>)) return "unavailable";
+            Player player = reward.Player;
+            if (player.GetType() != typeof(Player)) return "unavailable";
+            object? current = field.GetValue(player);
+            if (current == null) return "absent";
+            if (current is not Action<RelicModel> listeners) return "unavailable";
+            int count = listeners.GetInvocationList().Count(callback => callback.Method == handler && ReferenceEquals(callback.Target, reward));
+            return count == 0 ? "absent" : count == 1 ? "attached" : "unavailable";
+        }
+        catch { return "unavailable"; }
+    }
+    public static bool IsNativeSkip(CardRewardAlternative alternative)
+    {
+        if (typeof(CardRewardAlternative).Module.ModuleVersionId != new Guid("57785517-0b16-42b9-8b36-bad6fb28384b")
+            || !FactoryIsAudited() || alternative.GetType() != typeof(CardRewardAlternative)
+            || alternative.OptionId != "Skip"
+            || alternative.AfterSelected != PostAlternateCardRewardAction.EndSelectionAndDoNotCompleteReward)
+            return false;
+        Delegate[] callbacks = alternative.OnSelect.GetInvocationList();
+        return callbacks.Length == 1 && EmptySelection != null && callbacks[0].Method == EmptySelection;
+    }
+
+    private static bool FactoryIsAudited() => new[] { "Player", "Cards", "IsPopulated", "CanSkip", "CanReroll" }
+            .All(name => GetterIsUnpatched(typeof(CardReward), name))
+        && GetterIsUnpatched(typeof(Player), "RunState") && CardsProjectionIsUnpatched()
+        && new[] { "OptionId", "AfterSelected", "Title", "OnSelect" }.All(name => GetterIsUnpatched(typeof(CardRewardAlternative), name))
+        && Unpatched(EmptySelection)
+        && Unpatched(typeof(CardRewardAlternative).GetMethod(nameof(CardRewardAlternative.Generate), new[] { typeof(CardReward) }))
+        && Unpatched(typeof(CardRewardAlternative).GetConstructor(new[] { typeof(string), typeof(PostAlternateCardRewardAction) }))
+        && Unpatched(typeof(CardRewardAlternative).GetConstructor(new[] { typeof(string), typeof(Func<System.Threading.Tasks.Task>), typeof(PostAlternateCardRewardAction) }))
+        && Unpatched(typeof(Hook).GetMethod(nameof(Hook.ModifyCardRewardAlternatives)))
+        && Unpatched(typeof(Hook).GetMethod(nameof(Hook.ShouldAllowSelectingMoreCardRewards)))
+        && Unpatched(typeof(RunState).GetMethod(nameof(RunState.IterateHookListeners)))
+        && Unpatched(typeof(ModHelper).GetMethod(nameof(ModHelper.IterateAllRunStateSubscribers)))
+        && Unpatched(Effective(typeof(AbstractModel), nameof(AbstractModel.TryModifyCardRewardAlternatives), AlternativeSignature))
+        && Unpatched(Effective(typeof(PaelsWing), nameof(AbstractModel.TryModifyCardRewardAlternatives), AlternativeSignature))
+        && Unpatched(Effective(typeof(AbstractModel), nameof(AbstractModel.ShouldAllowSelectingMoreCardRewards), CompletionSignature));
+
+    private static bool ListenersAreAudited(IEnumerable<AbstractModel> listeners) => listeners.All(model =>
+    {
+        Type type = model.GetType();
+        if (type.Assembly != typeof(CardReward).Assembly) return false;
+        MethodInfo? alternative = Effective(type, nameof(AbstractModel.TryModifyCardRewardAlternatives), AlternativeSignature);
+        MethodInfo? completion = Effective(type, nameof(AbstractModel.ShouldAllowSelectingMoreCardRewards), CompletionSignature);
+        return alternative?.DeclaringType is { } declaration && (declaration == typeof(AbstractModel) || declaration == typeof(PaelsWing))
+            && completion?.DeclaringType == typeof(AbstractModel) && Unpatched(alternative) && Unpatched(completion);
+    });
+
+    private static NativeCardRewardAlternativePreviewResult Missing(string gap) => new(false, null, null, null, null, gap);
+
+    public static NativeCardRewardAlternativePreviewResult Capture(CardReward reward)
+    {
+        try
+        {
+            // These checks precede IterateHookListeners, whose mod-subscriber
+            // branch can invoke arbitrary delegates in an otherwise exact DLL.
+            if (!FactoryIsAudited() || !NativeRunHookReadQualification.Preflight(reward.Player.RunState))
+                return Missing("native_alternative_factory_not_pure_qualified");
+            if (reward.GetType() != typeof(CardReward) || reward.Player.RunState is not RunState run
+                || run.GetType() != typeof(RunState) || !reward.IsPopulated
+                || !run.Players.Any(player => ReferenceEquals(player, reward.Player)))
+                return Missing("native_alternative_reward_owner_not_qualified");
+            if (!NativeRunHookReadQualification.TryCaptureListeners(run, out var listeners, out string? gap))
+                return Missing(gap!);
+            if (!ListenersAreAudited(listeners)) return Missing("native_alternative_listener_not_pure_qualified");
+            CardModel[] cards = reward.Cards.ToArray();
+            bool canSkip = reward.CanSkip, canReroll = reward.CanReroll;
+            IReadOnlyList<CardRewardAlternative> alternatives = CardRewardAlternative.Generate(reward);
+            bool selectionCompletes = !Hook.ShouldAllowSelectingMoreCardRewards(run, reward.Player, reward);
+            var facts = new List<NativeCardRewardAlternativePreviewFact>();
+            foreach (CardRewardAlternative alternative in alternatives)
+            {
+                string title = alternative.Title.GetFormattedText();
+                string? outcome = Outcome(alternative.AfterSelected);
+                if (string.IsNullOrWhiteSpace(alternative.OptionId) || string.IsNullOrWhiteSpace(title) || outcome == null)
+                    return Missing("native_alternative_public_fact_unavailable");
+                facts.Add(new(alternative.OptionId, title, outcome) { IsNativeSkip = IsNativeSkip(alternative) });
+            }
+            if (facts.Select(value => value.OptionId).Distinct(StringComparer.Ordinal).Count() != facts.Count)
+                return Missing("native_alternative_duplicate_option_id");
+            if (!FactoryIsAudited() || !ListenersAreAudited(listeners)
+                || !NativeRunHookReadQualification.StillCurrent(run, listeners)
+                || !cards.SequenceEqual(reward.Cards, ReferenceEqualityComparer.Instance)
+                || reward.CanSkip != canSkip || reward.CanReroll != canReroll)
+                return Missing("native_alternative_capture_changed");
+            return new(true, facts.ToArray(), canSkip, canReroll, selectionCompletes, null);
+        }
+        catch (Exception) { return Missing("native_alternative_capture_failed"); }
+    }
+}
diff --git a/src/Sts2Headless/NativeCardRewardParentPresentation.cs b/src/Sts2Headless/NativeCardRewardParentPresentation.cs
new file mode 100644
index 0000000..ede9099
--- /dev/null
+++ b/src/Sts2Headless/NativeCardRewardParentPresentation.cs
@@ -0,0 +1,27 @@
+using System.Reflection;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Rewards;
+using STS2Platform.NativeFoundation;
+
+namespace Sts2Headless;
+
+// Observe the original synchronous OnSelect call. Its native body, choice
+// callback, alternatives, native synchronizer and effects remain unchanged.
+internal static class NativeCardRewardParentPresentation
+{
+    public static void Prefix(CardReward __instance, out IDisposable __state) =>
+        __state = NativeCardRewardSelectionObservation.BeginSynchronousOnSelect(__instance);
+    public static Exception? Finalizer(IDisposable? __state, Exception? __exception)
+    {
+        __state?.Dispose();
+        return __exception;
+    }
+    internal static void Install(Harmony harmony)
+    {
+        MethodInfo original = AccessTools.DeclaredMethod(typeof(CardReward), "OnSelect")
+            ?? throw new MissingMethodException("Exact native card reward OnSelect changed");
+        harmony.Patch(original,
+            prefix: new HarmonyMethod(typeof(NativeCardRewardParentPresentation), nameof(Prefix)),
+            finalizer: new HarmonyMethod(typeof(NativeCardRewardParentPresentation), nameof(Finalizer)));
+    }
+}
diff --git a/src/Sts2Headless/NativeCardRewardSelectionObservation.cs b/src/Sts2Headless/NativeCardRewardSelectionObservation.cs
new file mode 100644
index 0000000..381119e
--- /dev/null
+++ b/src/Sts2Headless/NativeCardRewardSelectionObservation.cs
@@ -0,0 +1,120 @@
+using System;
+using System.Collections.Generic;
+using System.Reflection;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Rewards;
+
+namespace STS2Platform.NativeFoundation;
+
+/// <summary>
+/// Exact synchronous CardReward.OnSelect observation, shared by native UI and
+/// TestMode presentation adapters. It does not flow into async continuations,
+/// discover an ambient reward, execute selection, or manufacture an operand.
+/// </summary>
+public static class NativeCardRewardSelectionObservation
+{
+    private sealed class SynchronousSelectionScope : IDisposable
+    {
+        internal SynchronousSelectionScope(CardReward reward, SynchronousSelectionScope? previous)
+        {
+            Reward = reward;
+            Previous = previous;
+            ThreadId = Environment.CurrentManagedThreadId;
+        }
+
+        internal CardReward Reward { get; }
+        internal SynchronousSelectionScope? Previous { get; }
+        internal int ThreadId { get; }
+        internal Action<string>? InvalidatePresentation { get; set; }
+        internal object? BoundPresentation { get; set; }
+        internal int ShowCalls { get; set; }
+        internal bool Ambiguous { get; set; }
+        internal bool IsDisposed => _disposed;
+        private volatile bool _disposed;
+
+        public void Dispose()
+        {
+            if (_disposed)
+            {
+                if (Environment.CurrentManagedThreadId == ThreadId
+                    && ReferenceEquals(CurrentSelection, this))
+                    CurrentSelection = Previous is { IsDisposed: false } ? Previous : null;
+                return;
+            }
+            _disposed = true;
+            if (Environment.CurrentManagedThreadId != ThreadId)
+            {
+                InvalidatePresentation?.Invoke("selection_scope_cross_thread_disposal");
+                return;
+            }
+            if (!ReferenceEquals(CurrentSelection, this))
+            {
+                SynchronousSelectionScope? nested = CurrentSelection;
+                CurrentSelection = null;
+                while (nested != null)
+                {
+                    nested._disposed = true;
+                    nested.InvalidatePresentation?.Invoke("selection_scope_out_of_order");
+                    nested = nested.Previous;
+                }
+                InvalidatePresentation?.Invoke("selection_scope_out_of_order");
+                return;
+            }
+            CurrentSelection = Previous is { IsDisposed: false } ? Previous : null;
+        }
+    }
+
+    [ThreadStatic]
+    private static SynchronousSelectionScope? CurrentSelection;
+
+    private static readonly FieldInfo? NativeCardsField = typeof(CardReward).GetField(
+        "_cards", BindingFlags.Instance | BindingFlags.NonPublic);
+
+    public static IDisposable BeginSynchronousOnSelect(CardReward reward)
+    {
+        ArgumentNullException.ThrowIfNull(reward);
+        var scope = new SynchronousSelectionScope(reward, CurrentSelection);
+        CurrentSelection = scope;
+        return scope;
+    }
+
+    public static CardReward? BindCurrent(
+        IReadOnlyList<CardCreationResult> options,
+        object presentation,
+        Action<string> invalidatePresentation,
+        out string status,
+        bool allowSequentialCallback = false)
+    {
+        ArgumentNullException.ThrowIfNull(options);
+        ArgumentNullException.ThrowIfNull(presentation);
+        ArgumentNullException.ThrowIfNull(invalidatePresentation);
+        SynchronousSelectionScope? scope = CurrentSelection;
+        if (scope == null || scope.IsDisposed || scope.ThreadId != Environment.CurrentManagedThreadId)
+        {
+            if (scope is { IsDisposed: true }) CurrentSelection = null;
+            status = "parent_not_bound";
+            return null;
+        }
+        scope.ShowCalls++;
+        if (scope.Ambiguous || (scope.ShowCalls != 1 && !(allowSequentialCallback
+                && ReferenceEquals(scope.BoundPresentation, presentation)))
+            || !MatchesNativeOptions(scope.Reward, options))
+        {
+            scope.Ambiguous = true;
+            scope.InvalidatePresentation?.Invoke("ambiguous_show_screen");
+            status = "ambiguous_show_screen";
+            return null;
+        }
+        scope.BoundPresentation = presentation;
+        scope.InvalidatePresentation = invalidatePresentation;
+        status = "exact_synchronous_parent";
+        return scope.Reward;
+    }
+
+    public static bool MatchesNativeOptions(CardReward parent, IReadOnlyList<CardCreationResult> options)
+    {
+        try { return NativeCardsField?.GetValue(parent) is IReadOnlyList<CardCreationResult> native
+            && ReferenceEquals(native, options); }
+        catch { return false; }
+    }
+}
diff --git a/src/Sts2Headless/NativeDetachedCardCopy.cs b/src/Sts2Headless/NativeDetachedCardCopy.cs
new file mode 100644
index 0000000..2b9887b
--- /dev/null
+++ b/src/Sts2Headless/NativeDetachedCardCopy.cs
@@ -0,0 +1,47 @@
+using System;
+using System.Runtime.CompilerServices;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Nodes.Cards;
+
+namespace STS2Platform.NativeFoundation;
+
+/// <summary>Fixed exact-build structural bridge for presentation only. The
+/// caller must first qualify the effective native copy closure and every
+/// copied delegate. Only the newly allocated copy is changed. All native field
+/// copying and rules remain in DeepCloneFields/AfterCloned and the real native
+/// upgrade/enchantment methods. Never register or dispatch this copy.</summary>
+internal static class NativeDetachedCardCopy
+{
+    internal static CardModel CreateQualifiedCopy(CardModel original)
+    {
+        // Native AbstractModel.MutableClone performs these three structural
+        // steps. Its DeepCloneFields reattaches enchantment/affliction before
+        // AfterCloned clears copied card UI delegates. Isolate those two on
+        // the NEW copy first; never clear/restore an event on the original.
+        var copy = (CardModel)MemberwiseClone(original);
+        SetMutable(copy, true);
+        EnchantmentChanged(copy) = null;
+        AfflictionChanged(copy) = null;
+        DeepCloneFields(copy);
+        AfterCloned(copy);
+        return copy;
+    }
+
+    [UnsafeAccessor(UnsafeAccessorKind.Field, Name = "_model")]
+    internal static extern ref CardModel? UiModel(NCard node);
+    [UnsafeAccessor(UnsafeAccessorKind.Field, Name = "_subscribedEnchantment")]
+    internal static extern ref EnchantmentModel? UiSubscribedEnchantment(NCard node);
+
+    [UnsafeAccessor(UnsafeAccessorKind.Method, Name = "MemberwiseClone")]
+    private static extern object MemberwiseClone(object original);
+    [UnsafeAccessor(UnsafeAccessorKind.Method, Name = "set_IsMutable")]
+    private static extern void SetMutable(AbstractModel copy, bool value);
+    [UnsafeAccessor(UnsafeAccessorKind.Field, Name = "EnchantmentChanged")]
+    private static extern ref Action? EnchantmentChanged(CardModel copy);
+    [UnsafeAccessor(UnsafeAccessorKind.Field, Name = "AfflictionChanged")]
+    private static extern ref Action? AfflictionChanged(CardModel copy);
+    [UnsafeAccessor(UnsafeAccessorKind.Method, Name = "DeepCloneFields")]
+    private static extern void DeepCloneFields(CardModel copy);
+    [UnsafeAccessor(UnsafeAccessorKind.Method, Name = "AfterCloned")]
+    private static extern void AfterCloned(CardModel copy);
+}
diff --git a/src/Sts2Headless/NativeDetachedCardPreview.cs b/src/Sts2Headless/NativeDetachedCardPreview.cs
new file mode 100644
index 0000000..f42207a
--- /dev/null
+++ b/src/Sts2Headless/NativeDetachedCardPreview.cs
@@ -0,0 +1,176 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Text.Json.Serialization;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Localization.DynamicVars;
+using MegaCrit.Sts2.Core.Models;
+
+namespace STS2Platform.NativeFoundation;
+
+internal enum NativeDetachedPreviewKind { DeckUpgrade, SingleEnchantment }
+
+/// <summary>Process-local presentation only. Original is the game-owned
+/// subject; Display is never added to a scope/pile or used as an input operand.
+/// Public formatting has its own mandatory read preflight.</summary>
+internal sealed record NativeDetachedCardPreview([property: JsonIgnore] CardModel Original, [property: JsonIgnore] CardModel Display,
+    NativeDetachedPreviewKind Kind, PileType DisplayPile, CardPreviewMode PreviewMode);
+
+internal sealed class NativePreviewReadStateViolationException(string message) : Exception(message);
+
+internal static class NativeDetachedCardPreviewFactory
+{
+    internal static bool TryCanonicalHoverCopy(CardModel canonical, out CardModel? copy, out string? gap)
+    {
+        copy = null;
+        if (!NativeCardPreviewReadQualification.TryPreflightCanonicalHover(canonical, out gap)) return false;
+        SourceStamp before = SourceStamp.Card(canonical);
+        try
+        {
+            CardModel display = NativeDetachedCardCopy.CreateQualifiedCopy(canonical);
+            before.AssertUnchanged();
+            if (!NativeCardPreviewReadQualification.TryPreflightCanonicalHover(canonical, out gap)) return false;
+            copy = display;
+            gap = null;
+            return true;
+        }
+        catch (NativePreviewReadStateViolationException) { throw; }
+        catch
+        {
+            before.AssertUnchanged();
+            gap = "native_canonical_hover_copy_failed";
+            return false;
+        }
+    }
+
+    internal static bool TryDeckUpgrade(CardModel original, out NativeDetachedCardPreview? result, out string? gap)
+    {
+        result = null;
+        if (!NativeCardPreviewReadQualification.TryPreflightUpgrade(original, out gap)) return false;
+        SourceStamp before = SourceStamp.Card(original);
+        try
+        {
+            // Use the qualified structural native copy bridge, then the same
+            // native grid UpgradeInternal. Scope.CloneCard would register the
+            // temporary model into live _allCards and is never a read path.
+            CardModel display = NativeDetachedCardCopy.CreateQualifiedCopy(original);
+            display.UpgradeInternal();
+            display.UpgradePreviewType = CardUpgradePreviewType.Deck;
+            before.AssertUnchanged();
+            if (!NativeCardPreviewReadQualification.TryPreflightUpgrade(original, out gap)) return false;
+            result = new(original, display, NativeDetachedPreviewKind.DeckUpgrade, PileType.None, CardPreviewMode.Upgrade);
+            gap = null;
+            return true;
+        }
+        catch (NativePreviewReadStateViolationException) { throw; }
+        catch
+        {
+            before.AssertUnchanged();
+            gap = "native_detached_upgrade_preview_failed";
+            return false;
+        }
+    }
+
+    internal static bool TrySingleEnchant(CardModel original, EnchantmentModel canonicalEnchantment, int amount,
+        out NativeDetachedCardPreview? result, out string? gap)
+    {
+        result = null;
+        if (!NativeCardPreviewReadQualification.TryPreflightSingleEnchant(original, canonicalEnchantment, out gap)) return false;
+        SourceStamp before = SourceStamp.Card(original);
+        SourceStamp enchantmentBefore = SourceStamp.Model(canonicalEnchantment, typeof(EnchantmentModel));
+        try
+        {
+            CardModel display = NativeDetachedCardCopy.CreateQualifiedCopy(original);
+            EnchantmentModel enchantment = canonicalEnchantment.ToMutable();
+            // Native NEnchantPreview.Init model sequence, on the detached copy.
+            // Do not replace it with guessed arithmetic or finalized upgrades.
+            display.EnchantInternal(enchantment, amount);
+            display.IsEnchantmentPreview = true;
+            enchantment.ModifyCard();
+            before.AssertUnchanged();
+            enchantmentBefore.AssertUnchanged();
+            if (!NativeCardPreviewReadQualification.TryPreflightSingleEnchant(original, canonicalEnchantment, out gap)) return false;
+            result = new(original, display, NativeDetachedPreviewKind.SingleEnchantment, PileType.None, CardPreviewMode.Normal);
+            gap = null;
+            return true;
+        }
+        catch (NativePreviewReadStateViolationException) { throw; }
+        catch
+        {
+            before.AssertUnchanged();
+            enchantmentBefore.AssertUnchanged();
+            gap = "native_detached_enchantment_preview_failed";
+            return false;
+        }
+    }
+
+    // An assertion of the audited invocation's original-object footprint. It
+    // does not permit unknown code to run and does not restore/roll back state.
+    // Only fixed native owner fields and plain CLR containers are inspected.
+    private sealed class SourceStamp
+    {
+        private const BindingFlags Fields = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.DeclaredOnly;
+        private readonly List<(object Owner, FieldInfo Field, object? Value)> fields = new();
+        private readonly List<(System.Collections.IList List, object?[] Items)> lists = new();
+        private readonly List<(HashSet<CardKeyword> Set, CardKeyword[] Items)> keywordSets = new();
+
+        internal static SourceStamp Model(object model, Type owner)
+        {
+            var stamp = new SourceStamp();
+            stamp.Add(model, owner);
+            if (owner.GetField("_dynamicVars", Fields)?.GetValue(model) is DynamicVarSet vars) stamp.AddVariables(vars);
+            return stamp;
+        }
+
+        internal static SourceStamp Card(CardModel card)
+        {
+            SourceStamp stamp = Model(card, typeof(CardModel));
+            if (typeof(CardModel).GetField("<Enchantment>k__BackingField", Fields)?.GetValue(card) is EnchantmentModel enchantment)
+            {
+                stamp.Add(enchantment, typeof(EnchantmentModel));
+                if (typeof(EnchantmentModel).GetField("_dynamicVars", Fields)?.GetValue(enchantment) is DynamicVarSet vars) stamp.AddVariables(vars);
+            }
+            if (typeof(CardModel).GetField("<Affliction>k__BackingField", Fields)?.GetValue(card) is AfflictionModel affliction)
+                stamp.Add(affliction, typeof(AfflictionModel));
+            if (typeof(CardModel).GetField("_keywords", Fields)?.GetValue(card) is HashSet<CardKeyword> keywords)
+                stamp.keywordSets.Add((keywords, keywords.ToArray()));
+            if (typeof(CardModel).GetField("_temporaryStarCosts", Fields)?.GetValue(card) is System.Collections.IList temporary)
+                stamp.lists.Add((temporary, temporary.Cast<object?>().ToArray()));
+            if (typeof(CardModel).GetField("_energyCost", Fields)?.GetValue(card) is CardEnergyCost cost)
+            {
+                stamp.Add(cost, typeof(CardEnergyCost));
+                if (typeof(CardEnergyCost).GetField("_localModifiers", Fields)?.GetValue(cost) is System.Collections.IList modifiers)
+                {
+                    stamp.lists.Add((modifiers, modifiers.Cast<object?>().ToArray()));
+                    foreach (object modifier in modifiers) stamp.Add(modifier, typeof(LocalCostModifier));
+                }
+            }
+            return stamp;
+        }
+
+        private void AddVariables(DynamicVarSet vars)
+        {
+            Add(vars, typeof(DynamicVarSet));
+            if (typeof(DynamicVarSet).GetField("_vars", Fields)?.GetValue(vars) is Dictionary<string, DynamicVar> values)
+                foreach (DynamicVar value in values.Values) Add(value, typeof(DynamicVar));
+        }
+
+        private void Add(object owner, Type declaring) => fields.AddRange(declaring.GetFields(Fields)
+            .Where(field => !field.IsStatic).Select(field => (owner, field, field.GetValue(owner))));
+
+        private static bool Same(object? left, object? right) => ReferenceEquals(left, right)
+            || left != null && right != null && left.GetType() == right.GetType()
+                && (left is bool or int or uint or decimal or float or double or long or ulong || left.GetType().IsEnum)
+                && left.Equals(right);
+
+        internal void AssertUnchanged()
+        {
+            if (fields.Any(value => !Same(value.Value, value.Field.GetValue(value.Owner)))
+                || lists.Any(value => value.List.Count != value.Items.Length
+                    || value.List.Cast<object?>().Zip(value.Items).Any(pair => !Same(pair.First, pair.Second)))
+                || keywordSets.Any(value => !value.Set.SetEquals(value.Items)))
+                throw new NativePreviewReadStateViolationException("Native detached preview changed its original model footprint");
+        }
+    }
+}
