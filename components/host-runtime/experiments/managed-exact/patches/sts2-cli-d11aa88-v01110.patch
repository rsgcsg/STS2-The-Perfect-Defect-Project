+    private static void TestCardReward(Player player, RunState run, PlayerChoiceSynchronizer synchronizer)
+    {
+        int before=checks;
+        Set(player,"<IsActiveForHooks>k__BackingField",false);
+        Set(run,"<Modifiers>k__BackingField",Array.Empty<ModifierModel>());
+        Set(run,"<BadgeModels>k__BackingField",Array.Empty<BadgeModel>());
+        Set(run,"<MultiplayerScalingModel>k__BackingField",Bare<MultiplayerScalingModel>());
+        var reward=Bare<CardReward>();Set(reward,"<Player>k__BackingField",player);
+        Set(reward,"_synchronizer",synchronizer);Set(reward,"<CanSkip>k__BackingField",true);
+        ModelDb.Inject(typeof(MegaCrit.Sts2.Core.Models.Cards.StrikeIronclad));
+        var card=ModelDb.Card<MegaCrit.Sts2.Core.Models.Cards.StrikeIronclad>().ToMutable();
+        ModelDb.Inject(typeof(MegaCrit.Sts2.Core.Models.CardPools.IroncladCardPool));
+        Set(card,"_pool",ModelDb.CardPool<MegaCrit.Sts2.Core.Models.CardPools.IroncladCardPool>());
+        var simulatorType=typeof(NativeCardRewardAlternativePreview).Assembly.GetType("Sts2Headless.RunSimulator")!;
+        object simulator=RuntimeHelpers.GetUninitializedObject(simulatorType);
+        var render=simulatorType.GetMethod("RewardCardOption",BindingFlags.Instance|BindingFlags.NonPublic)!;
+        var outer=(Dictionary<string,object?>)render.Invoke(simulator,new object[]{card,0})!;
+        Check(outer["render_complete"] is true,"actual native reward renderer completes: "+JsonSerializer.Serialize(outer));
+        var original=new List<CardCreationResult>{new(card)};Set(reward,"_cards",original);
+        Type selectorType=typeof(NativeCardRewardAlternativePreview).Assembly.GetType("Sts2Headless.RunSimulator+HeadlessCardSelector")!;
+        var selector=(ICardSelector)Activator.CreateInstance(selectorType)!;
+        using var selectorScope=CardSelectCmd.UseSelector(selector);
+        try
+        {
+            var method=typeof(CardReward).GetMethod("OnSelect",BindingFlags.Instance|BindingFlags.NonPublic)!;
+            var operation=Task.Run(async()=>await (Task<bool>)method.Invoke(reward,null)!);
+            object? observed=null;
+            var current=selectorType.GetProperty("CurrentRewardOptions")!;
+            var until=DateTime.UtcNow+TimeSpan.FromSeconds(2);
+            while((observed=current.GetValue(selector))==null && !operation.IsCompleted && DateTime.UtcNow<until)Thread.Sleep(1);
+            Check(observed!=null&&!operation.IsCompleted,"actual native OnSelect blocks only on original TestMode callback");
+            Type tuple=observed!.GetType();
+            Check(ReferenceEquals(tuple.GetField("Item3")!.GetValue(observed),reward),"shared synchronous observation identifies actual native reward parent");
+            Check((string)tuple.GetField("Item4")!.GetValue(observed)! == "exact_synchronous_parent","exact native parent qualification");
+            var options=(IReadOnlyList<CardCreationResult>)tuple.GetField("Item1")!.GetValue(observed)!;
+            var alternatives=(IReadOnlyList<CardRewardAlternative>)tuple.GetField("Item2")!.GetValue(observed)!;
+            Check(ReferenceEquals(options.Single(),original.Single())&&ReferenceEquals(options.Single().Card,card),"opened callback retains original creation result and real card entity separately");
+            Check(NativeCardRewardAlternativePreview.IsNativeSkip(alternatives.Single()),"actual native Skip is qualified by its exact empty delegate");
+            int customEffects=0;var custom=new CardRewardAlternative("Skip",()=>{customEffects++;return Task.CompletedTask;},
+                PostAlternateCardRewardAction.EndSelectionAndDoNotCompleteReward);
+            Check(!NativeCardRewardAlternativePreview.IsNativeSkip(custom)&&customEffects==0,"same-label custom Skip is not a native Skip witness and is never invoked");
+            var opened=(Dictionary<string,object?>)render.Invoke(simulator,new object[]{options.Single().Card,0})!;
+            Check(JsonSerializer.Serialize(outer)==JsonSerializer.Serialize(opened),"actual original native opened callback matches full outer reward renderer DTO");
+            Console.WriteLine("native-reward-card-pair="+JsonSerializer.Serialize(new{outer,opened}));
+            var nativeRef=typeof(NativeCardRewardAlternativePreview).Assembly.GetType("Sts2Headless.NativeObjectIdentity")!;
+            string reference=(string)nativeRef.GetMethod("Get",BindingFlags.Static|BindingFlags.Public|BindingFlags.NonPublic)!.Invoke(null,new object[]{alternatives.Single()})!;
+            Check(!(bool)selectorType.GetMethod("ResolveAlternative")!.Invoke(selector,new object[]{"foreign-alternative"})!,"foreign native callback binding refuses");
+            original.Add(new(card));
+            Check(!(bool)selectorType.GetMethod("ResolveAlternative")!.Invoke(selector,new object[]{reference})!,"changed original native card list refuses before synchronizing");
+            object changed=current.GetValue(selector)!;
+            Check(changed.GetType().GetField("Item3")!.GetValue(changed)==null,"changed original callback list invalidates public parent identity");
+            original.RemoveAt(1);
+            Set(reward,"_cards",new List<CardCreationResult>(original));
+            Check(!(bool)selectorType.GetMethod("ResolveAlternative")!.Invoke(selector,new object[]{reference})!,"replaced actual native parent list refuses before synchronization");
+            Set(reward,"_cards",original);
+            Check((bool)selectorType.GetMethod("ResolveAlternative")!.Invoke(selector,new object[]{reference})!,"original native Skip binding completes callback");
+            Check(!operation.WaitAsync(TimeSpan.FromSeconds(2)).GetAwaiter().GetResult(),"native Skip returns false without claiming reward completion");
+            Check(current.GetValue(selector)==null,"completed native reward callback releases parent observation");
+        }
+        finally {selectorType.GetMethod("CancelAllPending")!.Invoke(selector,null);}
+        Console.WriteLine($"{checks-before} exact native card parent checks passed");
+    }
+
+    private static void TestRelic()
+    {
+        int before=checks;
+        TestMode.IsOn=true;
+        var screen=new NChooseARelicSelection();
+        Check(screen!=null,"typed native relic presentation constructor under current stubs");
+        var run=Bare<RunState>();var player=Bare<Player>();
+        Set(player,"_runState",run);Set(player,"<NetId>k__BackingField",1UL);
+        Set(player,"<DiscoveredRelics>k__BackingField",new List<ModelId>());
+        Set(run,"_players",new List<Player>{player});
+        var net=Bare<NetSingleplayerGameService>();
+        var manager=RunManager.Instance;
+        Set(manager,"<State>k__BackingField",run);Set(manager,"<NetService>k__BackingField",net);
+        var synchronizer=new PlayerChoiceSynchronizer(net,run);
+        Set(manager,"<PlayerChoiceSynchronizer>k__BackingField",synchronizer);
+        LocalContext.NetId=1;
+        var progress=Bare<ProgressState>();Set(progress,"_discoveredRelics",new HashSet<ModelId>());
+        var progressManager=Bare<ProgressSaveManager>();Set(progressManager,"<Progress>k__BackingField",progress);
+        var saves=Bare<SaveManager>();Set(saves,"_progressSaveManager",progressManager);
+        SaveManager.MockInstanceForTesting(saves);
+        RelicModel Relic(string id)
+        {
+            var relic=Bare<PaelsWing>();Set(relic,"<IsMutable>k__BackingField",true);Set(relic,"_owner",player);
+            Set(relic,"<Id>k__BackingField",new ModelId("relic",id));return relic;
+        }
