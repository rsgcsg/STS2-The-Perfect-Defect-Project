+using MegaCrit.Sts2.Core.CardSelection;
+using MegaCrit.Sts2.Core.Commands;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.TestSupport;
+
+namespace Sts2Headless;
+
+// In the pinned build FromDeckForEnchantment(cards, enchantment, amount, prefs)
+// invokes ICardSelector before its first suspension. Retain only this exact
+// invocation frame so the callback can be presented as the native enchant
+// selection; it never authorizes a different selector or later callback.
+internal static class DeckEnchantCallScope
+{
+    internal static bool HookReady { get; set; }
+    internal sealed class Frame
+    {
+        internal Frame(Player? player, CardSelectorPrefs preferences, EnchantmentModel enchantment,
+            int amount, ICardSelector? selector, Frame? previous)
+        {
+            Player = player;
+            Preferences = preferences;
+            Enchantment = enchantment;
+            Amount = amount;
+            Selector = selector;
+            Previous = previous;
+        }
+        internal Player? Player { get; }
+        internal CardSelectorPrefs Preferences { get; }
+        internal EnchantmentModel Enchantment { get; }
+        internal int Amount { get; }
+        internal ICardSelector? Selector { get; }
+        internal Frame? Previous { get; }
+        internal bool Consumed { get; set; }
+        internal bool Closed { get; set; }
+    }
+
+    [ThreadStatic] private static Frame? _current;
+
+    public static void Prefix(IReadOnlyList<CardModel> cards, EnchantmentModel enchantment, int amount,
+        CardSelectorPrefs prefs, out Frame __state)
+    {
+        __state = new Frame(cards.Count > 0 ? cards[0].Owner : null, prefs, enchantment, amount,
+            CardSelectCmd.Selector, _current);
+        _current = __state;
+    }
+
+    public static Exception? Finalizer(Frame? __state, Exception? __exception)
+    {
+        if (__state != null)
+        {
+            __state.Closed = true;
+            if (ReferenceEquals(_current, __state)) _current = __state.Previous;
+            else _current = null;
+        }
+        return __exception;
+    }
+
+    internal static bool TryTake(ICardSelector selector, int minSelect, int maxSelect,
+        out Player? player, out CardSelectorPrefs preferences,
+        out EnchantmentModel? enchantment, out int amount, out bool mismatch)
+    {
+        player = null;
+        preferences = default;
+        enchantment = null;
+        amount = 0;
+        Frame? frame = _current;
+        mismatch = frame != null;
+        if (frame == null || frame.Closed || frame.Consumed || frame.Player == null
+            || !ReferenceEquals(frame.Selector, selector)
+            || frame.Preferences.MinSelect != minSelect
+            || frame.Preferences.MaxSelect != maxSelect)
+            return false;
+        frame.Consumed = true;
+        player = frame.Player;
+        preferences = frame.Preferences;
+        enchantment = frame.Enchantment;
+        amount = frame.Amount;
+        mismatch = false;
+        return true;
+    }
+}
