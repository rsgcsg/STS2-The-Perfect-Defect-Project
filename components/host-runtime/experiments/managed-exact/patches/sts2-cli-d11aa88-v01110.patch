+            Log($"Abandoned Host operation ended with: {operation.Exception?.GetBaseException().Message}");
+        _pendingHostOperation = null;
+        _syncCtx.Pump();
+    }
+
+    private void WaitForExecutorToStop(MegaCrit.Sts2.Core.GameActions.ActionExecutor? executor)
+    {
+        if (executor == null) return;
+        for (int i = 0; i < 5000 && executor.IsRunning; i++)
+        {
+            _syncCtx.Pump();
+            Thread.Sleep(1);
+        }
+        if (executor.IsRunning)
+            throw new TimeoutException("The previous run ActionExecutor did not stop during cleanup.");
+    }
+
+    private void AttachCombatHandlers()
+    {
+        if (_combatHandlersAttached) return;
+        CombatManager.Instance.TurnStarted += OnTurnStarted;
+        CombatManager.Instance.CombatEnded += OnCombatEnded;
+        _combatHandlersAttached = true;
+    }
+
+    private void DetachCombatHandlers()
+    {
+        if (!_combatHandlersAttached) return;
+        CombatManager.Instance.TurnStarted -= OnTurnStarted;
+        CombatManager.Instance.CombatEnded -= OnCombatEnded;
+        _combatHandlersAttached = false;
+    }
+
+    private void OnTurnStarted(CombatState _) => _turnStarted.Set();
+
+    private void OnCombatEnded(CombatRoom _) => _combatEnded.Set();
+
     #endregion
 }
