diff --git a/src/Sts2Headless/NativeSelectorHud.cs b/src/Sts2Headless/NativeSelectorHud.cs
new file mode 100644
index 0000000..5852e97
--- /dev/null
+++ b/src/Sts2Headless/NativeSelectorHud.cs
@@ -0,0 +1,159 @@
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Entities.Creatures;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.HoverTips;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Entities.Potions;
+using MegaCrit.Sts2.Core.Rooms;
+using STS2Platform.NativeFoundation;
+
+namespace Sts2Headless;
+
+// Current post-prefix public combat facts only. Does not pump, wait, advertise
+// play actions, or borrow a parent observation. Draw is an unordered read.
+internal static class NativeSelectorHud
+{
+    internal static string HealthDisplay(HpDisplay mode) => mode switch
+    {
+        HpDisplay.Normal => "normal",
+        HpDisplay.InfiniteWithNumbers => "infinite_with_numbers",
+        HpDisplay.InfiniteWithoutNumbers => "infinite_without_numbers",
+        _ => throw new InvalidOperationException("Unknown native HP display mode")
+    };
+    private static string OrbDescription(OrbModel orb)
+    {
+        var text = orb.SmartDescription;
+        text.Add("energyPrefix", orb.Owner.Character.CardPool.Title);
+        text.Add("Passive", orb.PassiveVal);
+        text.Add("Evoke", orb.EvokeVal);
+        return text.GetFormattedText();
+    }
+    private static bool PotionCanUse(PotionModel potion, Player player, bool playPhase)
+    {
+        if (!playPhase || potion.Usage == PotionUsage.Automatic || potion.IsQueued
+            || potion.Owner.Creature.IsDead || !potion.PassesCustomUsabilityCheck) return false;
+        if (potion.TargetType == TargetType.AnyEnemy)
+            return player.Creature.CombatState?.HittableEnemies.Any(potion.IsValidTarget) == true;
+        if (potion.TargetType == TargetType.AnyAlly)
+            return player.Creature.CombatState?.PlayerCreatures.Any(potion.IsValidTarget) == true;
+        return potion.IsValidTarget(potion.TargetType is TargetType.Self or TargetType.AnyPlayer ? player.Creature : null);
+    }
+    private static Dictionary<string,object?> Card(CardModel card, PileType pile, bool identity)
+    {
+        var display = NativePublicCardDetails.CaptureWithUpgradePreview(card, pile);
+        if (!display.Complete)
+            throw new InvalidOperationException("Current native combat card display is incomplete: " + card.Id.Entry + " " + string.Join(",", display.Missing));
+        var result = new Dictionary<string,object?>(display.Card);
+        result["public_details"] = display.PublicDetail;
+        result["public_details_complete"] = display.Complete;
+        result["public_details_missing"] = display.Missing;
+        result["render_complete"] = true;
+        if (identity) result["native_ref"] = NativeObjectIdentity.Get(card);
+        if (pile == PileType.Hand)
+        {
+            card.CanPlay(out var reason, out _);
+            result["can_play"] = reason == UnplayableReason.None;
+            result["unplayable_reason"] = reason == UnplayableReason.None ? null : reason.ToString();
+        }
+        return result;
+    }
+
+    private static Dictionary<string,object?> Pile(string name, PileType type, CardModel[] cards)
+    {
+        var visible = cards.Select(card => Card(card, type, false));
+        return new()
+        {
+            ["pile"] = name,
+            ["ordering_semantics"] = type == PileType.Draw ? "unordered_multiset" : "native_visible_order",
+            ["cards"] = (type == PileType.Draw
+                ? visible.OrderBy(card => System.Text.Json.JsonSerializer.Serialize(card), StringComparer.Ordinal)
+                : visible).ToArray()
+        };
+    }
+    private static List<Dictionary<string,object?>> Statuses(Creature creature)
+    {
+        var result=new List<Dictionary<string,object?>>();
+        foreach(var power in creature.Powers.Where(power=>power.IsVisible))
+        {
+            var tips=power.HoverTips.OfType<HoverTip>().Where(tip=>tip.Id==power.Id.ToString()).ToArray();
+            if(tips.Length!=1 || string.IsNullOrWhiteSpace(tips[0].Title) || string.IsNullOrWhiteSpace(tips[0].Description))
+                throw new InvalidOperationException("Current native power hover is incomplete");
+            result.Add(new(){["id"]=power.Id.Entry,["name"]=tips[0].Title,["description"]=tips[0].Description,
+                ["amount"]=power.DisplayAmount,["type"]=power.Type.ToString()});
+        }
+        return result;
+    }
+    internal static Dictionary<string,object?> Capture(Player player, ICombatState combat)
+    {
+        var pcs=player.PlayerCombatState ?? throw new InvalidOperationException("Current player combat context is unavailable");
+        if(!ReferenceEquals(player.Creature.CombatState,combat))throw new InvalidOperationException("Current combat owner changed");
+        CardModel[] hand = pcs.Hand.Cards.ToArray(), draw = pcs.DrawPile.Cards.ToArray(),
+            discard = pcs.DiscardPile.Cards.ToArray(), exhaust = pcs.ExhaustPile.Cards.ToArray();
+        var enemies=combat.Enemies.Where(enemy=>enemy.IsAlive).Select(enemy=>new Dictionary<string,object?>
+        {
+            ["native_ref"]=NativeObjectIdentity.Get(enemy),["id"]=enemy.Monster!.Id.Entry,
+            ["combat_id"]=enemy.CombatId,
+            ["name"]=enemy.Monster.Title.GetFormattedText(),["hp"]=enemy.Monster.IsHealthBarVisible && enemy.HpDisplay.ShowsNumbers() ? enemy.CurrentHp : null,
+            ["max_hp"]=enemy.Monster.IsHealthBarVisible && enemy.HpDisplay.ShowsNumbers() ? enemy.MaxHp : null,
+            ["health_bar_visible"]=enemy.Monster.IsHealthBarVisible,["health_display"]=enemy.HpDisplay.ToString(),["block"]=enemy.Block,
+            ["hp_display_mode"]=HealthDisplay(enemy.HpDisplay),
+            ["hp_numbers_available"]=enemy.Monster.IsHealthBarVisible && enemy.HpDisplay.ShowsNumbers(),
+            ["statuses"]=Statuses(enemy),
+            ["intents"]=(enemy.Monster.NextMove?.Intents ?? []).Select(intent=>
+            {
+                var tip=intent.GetHoverTip(combat.PlayerCreatures,enemy);
+                return new Dictionary<string,object?>{["type"]=intent.IntentType.ToString(),
+                    ["label"]=intent.GetIntentLabel(combat.PlayerCreatures,enemy).GetFormattedText(),
+                    ["title"]=tip.Title,["description"]=tip.Description};
+            }).ToArray()
+        }).ToArray();
+        var result=new Dictionary<string,object?>
+        {
+            ["encounter_type"]=player.RunState.CurrentRoom?.RoomType switch
+            { RoomType.Monster => "normal", RoomType.Elite => "elite", RoomType.Boss => "boss", _ => "unknown" },
+            ["is_play_phase"]=pcs.Phase == PlayerTurnPhase.Play
+                && CombatManager.Instance.IsPartOfPlayerTurn(player) && !CombatManager.Instance.PlayerActionsDisabled,
+            ["round"]=combat.RoundNumber,["turn_owner"]=combat.CurrentSide.ToString().ToLowerInvariant(),
+            ["player_ref"]=NativeObjectIdentity.Get(player),["hp"]=player.Creature.CurrentHp,["max_hp"]=player.Creature.MaxHp,
+            ["block"]=player.Creature.Block,["energy"]=pcs.Energy,["max_energy"]=pcs.MaxEnergy,["stars"]=player.Character.ShouldAlwaysShowStarCounter || pcs.Stars > 0 ? pcs.Stars : null,
+            ["draw_pile_count"]=pcs.DrawPile.Cards.Count,["discard_pile_count"]=pcs.DiscardPile.Cards.Count,
+            ["exhaust_pile_count"]=pcs.ExhaustPile.Cards.Count,["statuses"]=Statuses(player.Creature),["enemies"]=enemies,
+            ["hand"]=hand.Select(card => Card(card, PileType.Hand, true)).ToArray(),
+            ["combat_piles"]=new[] { Pile("draw", PileType.Draw, draw),
+                Pile("discard", PileType.Discard, discard), Pile("exhaust", PileType.Exhaust, exhaust) },
+            ["orb_slots"]=pcs.OrbQueue.Capacity,
+            ["orbs"]=pcs.OrbQueue.Orbs.Select((orb,index)=>new Dictionary<string,object?>{["id"]=orb.Id.Entry,
+                ["native_ref"]=NativeObjectIdentity.Get(orb),["name"]=orb.Title.GetFormattedText(),
+                ["passive"]=orb.PassiveVal,["evoke"]=orb.EvokeVal,
+                ["description"]=OrbDescription(orb),["passive_value"]=orb.PassiveVal,["evoke_value"]=orb.EvokeVal,
+                ["queue_index"]=index,["is_next_to_evoke"]=index==0,
+                ["keywords"]=orb.HoverTips.Select(tip=>tip is HoverTip text
+                    ? new Dictionary<string,object?>{["name"]=text.Title,["description"]=text.Description}
+                    : throw new InvalidOperationException("Unqualified native orb hover")).ToArray()}).ToArray(),
+            ["companions"]=pcs.Pets.Select(pet=>new Dictionary<string,object?>{["native_ref"]=NativeObjectIdentity.Get(pet),
+                ["id"]=pet.Monster!.Id.Entry,["name"]=pet.Monster.Title.GetFormattedText(),
+                ["hp"]=pet.Monster.IsHealthBarVisible && pet.HpDisplay.ShowsNumbers() ? pet.CurrentHp : null,
+                ["max_hp"]=pet.Monster.IsHealthBarVisible && pet.HpDisplay.ShowsNumbers() ? pet.MaxHp : null,
+                ["health_bar_visible"]=pet.Monster.IsHealthBarVisible,["health_display"]=pet.HpDisplay.ToString(),
+                ["hp_display_mode"]=HealthDisplay(pet.HpDisplay),
+                ["hp_numbers_available"]=pet.Monster.IsHealthBarVisible && pet.HpDisplay.ShowsNumbers(),
+                ["block"]=pet.IsAlive ? pet.Block : 0m,
+                ["alive"]=pet.IsAlive,["is_alive"]=pet.IsAlive,["statuses"]=pet.IsAlive ? Statuses(pet) : []}).ToArray(),
+            ["potion_states"]=player.PotionSlots.Where(potion=>potion!=null).Select(potion=>new Dictionary<string,object?>
+            {
+                ["native_ref"]=NativeObjectIdentity.Get(potion!),["target_type"]=potion!.TargetType.ToString(),
+                ["automatic"]=potion.Usage==PotionUsage.Automatic,
+                ["can_use"]=PotionCanUse(potion,player,pcs.Phase==PlayerTurnPhase.Play
+                    && CombatManager.Instance.IsPartOfPlayerTurn(player) && !CombatManager.Instance.PlayerActionsDisabled)
+            }).ToArray(),
+        };
+        if(!ReferenceEquals(player.PlayerCombatState,pcs) || !ReferenceEquals(player.Creature.CombatState,combat)
+            || !hand.SequenceEqual(pcs.Hand.Cards, ReferenceEqualityComparer.Instance)
+            || !draw.SequenceEqual(pcs.DrawPile.Cards, ReferenceEqualityComparer.Instance)
+            || !discard.SequenceEqual(pcs.DiscardPile.Cards, ReferenceEqualityComparer.Instance)
+            || !exhaust.SequenceEqual(pcs.ExhaustPile.Cards, ReferenceEqualityComparer.Instance))
+            throw new InvalidOperationException("Current combat context changed during capture");
+        return result;
+    }
+}
diff --git a/src/Sts2Headless/NativeSelectorSelection.cs b/src/Sts2Headless/NativeSelectorSelection.cs
new file mode 100644
index 0000000..9b3d33b
--- /dev/null
+++ b/src/Sts2Headless/NativeSelectorSelection.cs
@@ -0,0 +1,141 @@
+using MegaCrit.Sts2.Core.Commands;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Localization;
+using MegaCrit.Sts2.Core.Models;
+
+namespace Sts2Headless;
+
+// Tentative presentation only. Terminal delivery returns original offered card
+// objects to the suspended native command; native callers retain effects/Commit.
+internal sealed class NativeSelectorSelection
+{
+    internal NativeSelectorSelection(NativeSelectorCallScope.Context context, List<CardModel> options)
+    { Context=context; Options=options; Run=context.Player.RunState; Combat=context.Player.Creature.CombatState; }
+    internal object Identity { get; } = new();
+    internal Task? Completion { get; set; }
+    internal NativeSelectorCallScope.Context Context { get; }
+    internal List<CardModel> Options { get; }
+    internal List<CardModel> Selected { get; } = new();
+    internal object? Run { get; }
+    internal MegaCrit.Sts2.Core.Combat.ICombatState? Combat { get; }
+    internal bool IsChoose => Context.Kind==NativeSelectorCallScope.Kind.Choose;
+    internal bool Manual => !IsChoose && Context.Preferences.RequireManualConfirmation;
+    internal bool CanSkip => IsChoose && Context.CanSkip;
+    internal int Min => IsChoose ? (CanSkip ? 0 : 1) : Context.Preferences.MinSelect;
+    internal int Max => IsChoose ? 1 : Context.Preferences.MaxSelect;
+    internal PileType DisplayPile => IsChoose ? PileType.None : Context.Pile!.Type;
+    internal string Prompt => IsChoose ? new LocString("gameplay_ui","CHOOSE_CARD_HEADER").GetFormattedText()
+        : Context.Preferences.Prompt.GetFormattedText();
+    internal bool CanConfirm => Manual && Selected.Count==1;
+    internal bool RenderReady { get; set; }
+    internal string? DisplaySignature { get; set; }
+
+    internal bool Current(Player player)
+    {
+        if (Completion is not { IsCompleted: false } || Combat==null || Run==null || !player.Creature.IsAlive || !ReferenceEquals(Context.Player,player) || !ReferenceEquals(player.RunState,Run)
+            || !ReferenceEquals(player.Creature.CombatState,Combat)
+            || !ReferenceEquals(CardSelectCmd.Selector,Context.Selector)
+            || Options.Count==0 || Options.Distinct(ReferenceEqualityComparer.Instance).Count()!=Options.Count
+            || Options.Any(card=>!card.IsMutable || !ReferenceEquals(card.Owner,player))) return false;
+        if (IsChoose)
+            return Options.SequenceEqual(Context.Offered!,ReferenceEqualityComparer.Instance)
+                && Options.All(card=>Combat?.ContainsCard(card)==true || player.RunState.ContainsCard(card));
+        var p=Context.Preferences;
+        // Bounded native 1-of-1 mechanics, including manual single-option input.
+        // Other preferences remain captured but unavailable until native mapping exists.
+        if (Context.Pile!.Type is not (PileType.Draw or PileType.Discard or PileType.Exhaust)
+            || !ReferenceEquals(Context.Pile,Context.Pile.Type.GetPile(player))
+            || p.MinSelect!=1 || p.MaxSelect!=1 || p.Cancelable || p.Comparison!=null
+            || p.UnpoweredPreviews || p.PretendCardsCanBePlayed || p.ShouldGlowGold!=null) return false;
+        CardModel[] current=Context.Pile.Cards.Where(card=>Context.Filter==null || Context.Filter(card)).ToArray();
+        return current.Length==Options.Count && current.All(card=>Options.Any(option=>ReferenceEquals(option,card)))
+            && Options.All(card=>current.Any(value=>ReferenceEquals(value,card)));
+    }
+    private (List<(CardModel Native, NativeSelectorCardDisplay.Result Display)> Cards, string Signature) Render()
+    {
+        var values=Options.Select(card=>(Native:card,Display:NativeSelectorCardDisplay.Capture(card,DisplayPile))).ToList();
+        if(DisplayPile==PileType.Draw)
+            values=values.OrderBy(value=>System.Text.Json.JsonSerializer.Serialize(value.Display.Card),StringComparer.Ordinal).ToList();
+        return (values,System.Text.Json.JsonSerializer.Serialize(values.Select(value=>value.Display.Card)));
+    }
+    internal Dictionary<string,object?> Capture(Player player)
+    {
+        RenderReady=false;
+        var missing=new List<string>();
+        var rendered=Render();
+        foreach(var entry in rendered.Cards) missing.AddRange(entry.Display.Missing);
+        Dictionary<string,object?>? hud=null;
+        string? prompt=null;
+        try
+        {
+            if(!Current(player)) missing.Add("exact_native_selector_current_domain");
+            else hud=NativeSelectorHud.Capture(player,Combat!);
+            prompt=Prompt;
+            if(string.IsNullOrWhiteSpace(prompt))missing.Add("native_selector_prompt");
+            if(!Current(player))missing.Add("exact_native_selector_changed_during_capture");
+        }
+        catch { missing.Add("current_native_selector_context"); }
+        RenderReady=missing.Count==0;
+        DisplaySignature=RenderReady ? rendered.Signature : null;
+        var cards=rendered.Cards.Select(value=>
+        {
+            var card=new Dictionary<string,object?>(value.Display.Card);
+            bool selected=Selected.Any(item=>ReferenceEquals(item,value.Native));
+            card["native_ref"]=NativeObjectIdentity.Get(value.Native);
+            card["is_selected"]=selected;
+            card["is_selectable"]=!selected && Selected.Count<Max;
+            card["is_deselectable"]=Manual && selected;
+            card["render_complete"]=value.Display.Complete;
+            card["public_details"]=value.Display.PublicDetail;
+            card["public_details_missing"]=value.Display.Missing;
+            return card;
+        }).ToArray();
+        var publicCapture = IsChoose ? null : ManagedSelectorPublicCapture.Capture(Identity, Completion, "combat_pile",
+            Context.Preferences, rendered.Cards.Select(value => value.Native).ToArray(), Selected,
+            preview: false, mechanicsQualified: RenderReady, canPreview: false,
+            canConfirm: CanConfirm, canCancel: false,
+            selectable: card => Selected.Count < Max && !Selected.Contains(card, ReferenceEqualityComparer.Instance),
+            displayPile: DisplayPile);
+        return new()
+        {
+            ["selector_public"] = publicCapture?.Facts,
+            ["selector_ref"]=NativeObjectIdentity.Get(Identity),["origin"]=IsChoose ? "choose_card" : "combat_pile",
+            ["stage"]=IsChoose ? "choosing" : "selecting",["prompt"]=prompt,["cards"]=publicCapture?.Cards ?? (object)cards,["min_select"]=Min,["max_select"]=Max,
+            ["selected_refs"]=Selected.Select(NativeObjectIdentity.Get).ToArray(),["can_skip"]=CanSkip,
+            ["require_manual_confirmation"]=Manual,["can_confirm"]=CanConfirm,["cancelable"]=false,
+            ["display_pile"]=DisplayPile.ToString().ToLowerInvariant(),["combat_context"]=hud,
+            ["combat_piles"]=hud?.GetValueOrDefault("combat_piles"),
+            ["native_selector_complete"]=RenderReady,["native_selector_missing"]=missing.Distinct().ToArray()
+        };
+    }
+    internal string? Validate(Player player, object? selectorRef)
+    {
+        if(!NativeObjectIdentity.Matches(Identity,selectorRef) || !Current(player) || !RenderReady)
+            return "The exact native selector, current domain or strict display is unavailable";
+        var rendered=Render();
+        return rendered.Cards.All(value=>value.Display.Complete) && rendered.Signature==DisplaySignature && Current(player)
+            ? null : "The exact native selector display or complete candidate domain changed";
+    }
+    internal string? Change(object? cardRef, bool deselect, out bool completed)
+    {
+        completed=false;
+        CardModel[] matches=Options.Where(card=>NativeObjectIdentity.Matches(card,cardRef)).ToArray();
+        if(matches.Length!=1) return "The exact offered card is unavailable";
+        CardModel card=matches[0];
+        if(deselect)
+        {
+            if(!Manual || !Selected.Any(value=>ReferenceEquals(value,card))) return "Native deselection is unavailable";
+            Selected.Remove(card);return null;
+        }
+        if(Selected.Count!=0) return "The native selector already has its one tentative card";
+        Selected.Add(card);completed=!Manual;return null;
+    }
+    internal string? Complete(object? selectedRefs, bool skip)
+    {
+        if(skip) return CanSkip && Selected.Count==0 ? null : "Native choose-card skip is unavailable";
+        if(!CanConfirm) return "Native manual confirmation is unavailable";
+        string expected=string.Join(",",Selected.Select(NativeObjectIdentity.Get));
+        return selectedRefs is string value && value==expected ? null : "The exact tentative native selection changed";
+    }
+}
diff --git a/src/Sts2Headless/NativeTreasureChestAdmission.cs b/src/Sts2Headless/NativeTreasureChestAdmission.cs
