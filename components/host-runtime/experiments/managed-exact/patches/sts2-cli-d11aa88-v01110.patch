+        Check(sacrifice.Complete,"actual PaelsWing preview: "+sacrifice.Gap);
+        Check(sacrifice.Alternatives!.Select(x=>x.OptionId).SequenceEqual(new[]{"Skip","SACRIFICE"}),"native PaelsWing alternative");
+        Check(sacrifice.Alternatives![1].AfterSelected=="end_selection_and_complete_reward","native sacrifice outcome");
