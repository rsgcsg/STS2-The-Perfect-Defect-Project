@@ -0,0 +1,20 @@
+namespace Sts2Headless;
+
+internal static class NativeMerchantRemovalAdmission
+{
+    public static Task InvokeCurrentAsync(
+        Func<(object? Room, object? Entry, bool Stocked, bool EnoughGold)> readCurrent,
+        object selectedRoom, object selectedEntry, object? expectedRoom, object? expectedEntry,
+        Func<object, object?, bool> matches, Func<Task> purchase)
+    {
+        var current = readCurrent();
+        if (!ReferenceEquals(current.Room, selectedRoom)
+            || !ReferenceEquals(current.Entry, selectedEntry)
+            || !matches(selectedRoom, expectedRoom)
+            || !matches(selectedEntry, expectedEntry)
+            || !current.Stocked || !current.EnoughGold)
+            throw new InvalidOperationException(
+                "The bound merchant card-removal entry changed before native purchase.");
+        return purchase();
+    }
+}
