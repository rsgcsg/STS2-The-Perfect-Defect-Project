+        Check(reroll.Complete,"actual native reroll preview: "+reroll.Gap);
+        Check(reroll.Alternatives!.Select(x=>x.OptionId).SequenceEqual(new[]{"Skip","REROLL"}),"actual reroll domain");
+        Check(reroll.Alternatives![1].AfterSelected=="do_nothing","native reroll outcome");
+        Check(reward.CanReroll&&ReferenceEquals(original,typeof(CardReward).GetField("_cards",BindingFlags.Instance|BindingFlags.NonPublic)!.GetValue(reward))
+            &&ReferenceEquals(reward.Cards.Single(),card),"preview must not reroll or replace original card list");
