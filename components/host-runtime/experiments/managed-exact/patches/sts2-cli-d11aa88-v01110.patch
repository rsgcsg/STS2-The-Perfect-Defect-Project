+using MegaCrit.Sts2.Core.CardSelection;
+using MegaCrit.Sts2.Core.Commands;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Models;
+
+namespace Sts2Headless;
+
+// Presentation state for the exact FromSimpleGrid[ForRewards] callback.
+// NSimpleCardSelectScreen.OnCardClicked selects originals and completes at Max;
+// the suspended original CardSelectCmd/event retains deck additions and RNG.
+internal sealed class SimpleGridSelection
+{
+    private readonly NativeSelectorCallScope.Context _context;
+    private readonly List<CardModel> _originals;
+    private readonly List<CardModel> _display;
+    private readonly object _run;
+    internal object Identity { get; } = new();
+    internal Task? Completion { get; set; }
+    internal List<CardModel> Selected { get; } = new();
+    private CardSelectorPrefs Prefs => _context.Preferences;
+
+    internal SimpleGridSelection(NativeSelectorCallScope.Context context, List<CardModel> originals)
+    {
+        _context = context; _originals = originals; _run = context.Player.RunState;
+        _display = originals.ToList();
+        // Exact NSimpleCardSelectScreen.Create display ordering; the callback
+        // still returns original instances, in the actual selection order.
+        if (Prefs.Comparison != null) _display.Sort(Prefs.Comparison);
+    }
+
+    private bool Current(Player player) => NativeSelectorCallScope.SimpleHookReady
+        && Completion is { IsCompleted: false } && ReferenceEquals(player, _context.Player)
+        && ReferenceEquals(player.RunState, _run) && ReferenceEquals(CardSelectCmd.Selector, _context.Selector)
+        && _originals.SequenceEqual(_context.Offered!, ReferenceEqualityComparer.Instance)
+        && _originals.Count > 0 && _originals.Distinct(ReferenceEqualityComparer.Instance).Count() == _originals.Count
+        && _originals.All(card => card.IsMutable && ReferenceEquals(card.Owner, player))
+        && Prefs.MinSelect > 0 && Prefs.MaxSelect >= Prefs.MinSelect && Prefs.MaxSelect <= _originals.Count
+        && !Prefs.Cancelable && !Prefs.UnpoweredPreviews && !Prefs.PretendCardsCanBePlayed && Prefs.ShouldGlowGold == null
+        && Selected.Count <= Prefs.MaxSelect && Selected.All(card => _originals.Contains(card, ReferenceEqualityComparer.Instance));
+
+    private bool CanConfirm => Prefs.RequireManualConfirmation
+        && Selected.Count >= Prefs.MinSelect && Selected.Count <= Prefs.MaxSelect;
+
+    internal Dictionary<string, object?> Capture(Player player)
+    {
+        var capture = ManagedSelectorPublicCapture.Capture(Identity, Completion, "simple", Prefs, _display, Selected,
+            preview: false, mechanicsQualified: Current(player), canPreview: false,
+            canConfirm: CanConfirm, canCancel: false,
+            selectable: card => Selected.Count < Prefs.MaxSelect && !Selected.Contains(card, ReferenceEqualityComparer.Instance));
+        return new()
+        {
+            ["selector_ref"] = NativeObjectIdentity.Get(Identity), ["origin"] = "simple",
+            ["stage"] = "selecting", ["prompt"] = Prefs.Prompt.GetFormattedText(),
+            ["cards"] = capture.Cards, ["selector_public"] = capture.Facts,
+            ["min_select"] = Prefs.MinSelect, ["max_select"] = Prefs.MaxSelect,
+            ["require_manual_confirmation"] = Prefs.RequireManualConfirmation,
+            ["selected_refs"] = Selected.Select(NativeObjectIdentity.Get).ToArray(),
+            ["cancelable"] = false, ["can_confirm"] = CanConfirm
+        };
+    }
+
+    internal string? Validate(Player player, object? selectorRef) =>
+        NativeObjectIdentity.Matches(Identity, selectorRef) && Current(player)
+            ? null : "The exact current native simple-grid request or original roster changed";
+
+    internal string? Change(object? cardRef, bool deselect, out bool completed)
+    {
+        completed = false;
+        var matches = _originals.Where(card => NativeObjectIdentity.Matches(card, cardRef)).ToArray();
+        if (matches.Length != 1) return "The exact simple-grid card is unavailable";
+        CardModel card = matches[0];
+        if (deselect)
+        {
+            if (!Selected.Remove(card)) return "The original simple-grid card is not selected";
+            return null;
+        }
+        if (Selected.Contains(card, ReferenceEqualityComparer.Instance) || Selected.Count >= Prefs.MaxSelect)
+            return "The native simple-grid selection is already present or full";
+        Selected.Add(card);
+        completed = !Prefs.RequireManualConfirmation && Selected.Count >= Prefs.MaxSelect;
+        return null;
+    }
+
+    internal string? Confirm(object? selectedRefs) => CanConfirm
+        && selectedRefs is string refs && refs == string.Join(",", Selected.Select(NativeObjectIdentity.Get))
+            ? null : "The exact native simple-grid selected set cannot be confirmed";
+}
