--- /dev/null
+++ b/src/Sts2Headless/NativePotionTargetAdmission.cs
@@ -0,0 +1,30 @@
+namespace Sts2Headless;
+
+// A bounded domain adapter, not potion legality: callers retain native
+// CanUsePotionNow and supply PotionModel.IsValidTarget for the actual Creature.
+internal static class NativePotionTargetAdmission
+{
+    public static bool HasCompleteDomain<TPlayer>(
+        IReadOnlyList<TPlayer>? currentPlayers, TPlayer currentPlayer, TPlayer potionOwner)
+        where TPlayer : class => currentPlayers?.Count == 1
+            && ReferenceEquals(currentPlayers[0], currentPlayer)
+            && ReferenceEquals(potionOwner, currentPlayer);
+
+    public static IReadOnlyList<TPlayer> ValidTargets<TPlayer>(
+        IReadOnlyList<TPlayer>? currentPlayers, TPlayer currentPlayer, TPlayer potionOwner,
+        Func<TPlayer, bool> nativeIsValidTarget) where TPlayer : class =>
+        HasCompleteDomain(currentPlayers, currentPlayer, potionOwner)
+            && nativeIsValidTarget(currentPlayer) ? [currentPlayer] : [];
+
+    public static TPlayer? Resolve<TPlayer>(
+        IReadOnlyList<TPlayer>? currentPlayers, TPlayer currentPlayer, TPlayer potionOwner,
+        object? expectedTarget, Func<object, object?, bool> matches,
+        Func<TPlayer, bool> nativeIsValidTarget) where TPlayer : class
+    {
+        if (!HasCompleteDomain(currentPlayers, currentPlayer, potionOwner)
+            || expectedTarget == null || !matches(currentPlayer, expectedTarget)
+            || !nativeIsValidTarget(currentPlayer))
+            return null;
+        return currentPlayer;
+    }
+}
diff --git a/src/Sts2Headless/NativePublicCardDetails.cs b/src/Sts2Headless/NativePublicCardDetails.cs
new file mode 100644
index 0000000..1586939
--- /dev/null
+++ b/src/Sts2Headless/NativePublicCardDetails.cs
@@ -0,0 +1,196 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.HoverTips;
+using MegaCrit.Sts2.Core.Models;
+
+namespace STS2Platform.NativeFoundation;
+
+// Read-only, typed native card rendering and qualified upgrade previews. No raw
+// localization template, manual variable substitution or fallback can be complete.
+public static class NativePublicCardDetails
+{
+    public sealed record Result(Dictionary<string, object?> Card, string[] Missing)
+    {
+        public bool Complete => Missing.Length == 0;
+        public Dictionary<string, object?> PublicCard => NativePublicCardDetails.ToPublicCard(Card);
+        public Dictionary<string, object?>? UpgradePreview { get; init; }
+        public Dictionary<string, object?> PublicDetail
+        {
+            get
+            {
+                var detail = new Dictionary<string, object?>
+                {
+                    ["keywords"] = Card.GetValueOrDefault("keywords"),
+                    ["card_previews"] = Card.GetValueOrDefault("card_previews") is List<Dictionary<string, object?>> previews
+                        ? previews.Select(ToPublicCard).ToArray() : null
+                };
+                if (UpgradePreview != null) detail["upgrade_preview"] = UpgradePreview;
+                return detail;
+            }
+        }
+    }
+
+    // Shape conversion only. Native owns every value and recursive hover-card
+    // source; these display-only cards are not gameplay operands or action IDs.
+    private static Dictionary<string, object?> ToPublicCard(Dictionary<string, object?> card)
+    {
+        var value = new Dictionary<string, object?>
+        {
+            ["entity_id"] = null, ["definition_id"] = card.GetValueOrDefault("id"),
+            ["name"] = card.GetValueOrDefault("name"), ["type"] = card.GetValueOrDefault("type"),
+            ["cost"] = card.GetValueOrDefault("cost"), ["star_cost"] = card.GetValueOrDefault("star_cost"),
+            ["description"] = card.GetValueOrDefault("description"), ["rarity"] = card.GetValueOrDefault("rarity"),
+            ["is_upgraded"] = card.GetValueOrDefault("is_upgraded"), ["is_selected"] = false,
+            ["target_type"] = card.GetValueOrDefault("target_type"), ["can_play"] = null,
+            ["keywords"] = card.GetValueOrDefault("keywords"),
+            ["card_previews"] = card.GetValueOrDefault("card_previews") is List<Dictionary<string, object?>> previews
+                ? previews.Select(ToPublicCard).ToArray() : null
+        };
+        if (card.GetValueOrDefault("enchantment") != null)
+            value["existing_enchantment"] = new Dictionary<string, object?>
+            {
+                ["definition_id"] = card.GetValueOrDefault("enchantment_id"), ["name"] = card.GetValueOrDefault("enchantment"),
+                ["description"] = card.GetValueOrDefault("enchantment_description"), ["amount"] = card.GetValueOrDefault("enchantment_amount"),
+                ["visibility_basis"] = "card_hover_semantics"
+            };
+        return value;
+    }
+
+    public static Result Capture(CardModel card, PileType displayPile, CardPreviewMode mode = CardPreviewMode.Normal) =>
+        Capture(card, displayPile, new HashSet<CardModel>(ReferenceEqualityComparer.Instance), mode);
+
+    // The same game-owned detached deck-upgrade display used by native selectors.
+    // It is public presentation, never a replacement live card or input operand.
+    public static Result CaptureWithUpgradePreview(CardModel card, PileType displayPile)
+    {
+        Result current = Capture(card, displayPile);
+        if (!current.Complete)
+            return current with { UpgradePreview = new() { ["status"] = "unavailable", ["card"] = null } };
+        if (!NativeDetachedCardPreviewFactory.TryDeckUpgrade(card, out var preview, out string? gap))
+        {
+            if (gap == "native_preview_card_not_upgradable")
+                return current with { UpgradePreview = new() { ["status"] = "not_applicable", ["card"] = null } };
+            return current with {
+                Missing = current.Missing.Append(gap ?? "native_public_upgrade_preview_unavailable").Distinct(StringComparer.Ordinal).ToArray(),
+                UpgradePreview = new() { ["status"] = "unavailable", ["card"] = null } };
+        }
+        Result upgraded = Capture(preview!.Display, preview.DisplayPile, preview.PreviewMode);
+        return current with {
+            Missing = current.Missing.Concat(upgraded.Missing).Distinct(StringComparer.Ordinal).ToArray(),
+            UpgradePreview = new() { ["status"] = upgraded.Complete ? "available" : "unavailable",
+                ["card"] = upgraded.Complete ? upgraded.PublicCard : null } };
+    }
+
+    private static Result Capture(CardModel card, PileType displayPile, HashSet<CardModel> path, CardPreviewMode mode = CardPreviewMode.Normal)
+    {
+        var visible = new Dictionary<string, object?>();
+        var missing = new List<string>();
+        bool addedToPath = false;
+        CardModel subject = card;
+        string stage = "canonical_copy";
+        try
+        {
+            if (path.Count >= 16 || !(addedToPath = path.Add(card)))
+                throw new InvalidOperationException("Unqualified recursive native hover-card display");
+            // A native CardHoverTip may refer to a readonly canonical card.
+            // Initialize/render only a qualified detached presentation copy;
+            // retain the original reference in cycle detection throughout.
+            if (typeof(AbstractModel).GetField("<IsMutable>k__BackingField", BindingFlags.Instance | BindingFlags.NonPublic)?.GetValue(card) is false)
+            {
+                if (!NativeDetachedCardPreviewFactory.TryCanonicalHoverCopy(card, out CardModel? display, out string? gap)
+                    || display == null) throw new InvalidOperationException(gap ?? "native_canonical_hover_copy_unavailable");
+                card = display;
+            }
+            stage = "preflight";
+            NativeCardPreviewReadQualification.InvokePreflight(card, mode, displayPile);
+            stage = "card_identity";
+            visible["id"] = card.Id.Entry; visible["type"] = card.Type.ToString();
+            visible["rarity"] = card.Rarity.ToString(); visible["is_upgraded"] = card.IsUpgraded;
+            visible["name"] = null; visible["description"] = null;
+            stage = "preview_update";
+            NativeCardRenderTransaction.Run(card, displayPile, () =>
+            {
+                stage = "title";
+                visible["name"] = card.Title;
+                stage = "description";
+                visible["description"] = mode == CardPreviewMode.Upgrade ? card.GetDescriptionForUpgradePreview()
+                    : card.GetDescriptionForPile(displayPile, card.CurrentTarget);
+                stage = "energy_cost";
+                visible["cost"] = card.EnergyCost.CostsX ? "X" : card.EnergyCost.GetWithModifiers(CostModifiers.All).ToString();
+                stage = "star_cost";
+                visible["star_cost"] = card.HasStarCostX ? "X"
+                    : card.CurrentStarCost >= 0 ? card.GetStarCostWithModifiers().ToString() : null;
+                stage = "target_type";
+                visible["target_type"] = card.TargetType.ToString();
+                stage = "enchantment";
+                if (card.Enchantment != null)
+                {
+                    visible["enchantment_id"] = card.Enchantment.Id.Entry;
+                    visible["enchantment"] = card.Enchantment.Title.GetFormattedText();
+                    visible["enchantment_description"] = card.Enchantment.DynamicDescription.GetFormattedText();
+                    visible["enchantment_amount"] = card.Enchantment.Amount;
+                }
+                stage = "hover_tips";
+                var keywords = new List<Dictionary<string, object?>>();
+                var previews = new List<Dictionary<string, object?>>();
+                foreach (IHoverTip tip in IHoverTip.RemoveDupes(card.HoverTips))
+                {
+                    if (tip is HoverTip text)
+                        keywords.Add(new() { ["name"] = text.Title, ["description"] = text.Description });
+                    else if (tip is CardHoverTip preview)
+                    {
+                        Result child = Capture(preview.Card, PileType.None, path);
+                        previews.Add(child.Card);
+                        if (!child.Complete) missing.Add("native_selector_hover_card_incomplete");
+                    }
+                    else missing.Add("unqualified_native_card_hover_preview");
+                }
+                visible["keywords"] = keywords;
+                visible["card_previews"] = previews;
+                return true;
+            }, mode);
+            stage = "visible_text_projection";
+            // Same public text as the Reference surface readers: rich-text tags removed,
+            // inline icons as [file.png], description newlines as spaces.
+            foreach (string key in new[] { "name", "description", "enchantment", "enchantment_description" })
+                if (visible.GetValueOrDefault(key) is string raw)
+                    visible[key] = key.EndsWith("description", StringComparison.Ordinal)
+                        ? NativeVisibleText.Strip(raw).Replace("\n", " ") : NativeVisibleText.Strip(raw);
+            if (visible.GetValueOrDefault("keywords") is List<Dictionary<string, object?>> plain)
+                foreach (var tip in plain)
+                    foreach (string field in new[] { "name", "description" })
+                        if (tip.GetValueOrDefault(field) is string raw) tip[field] = NativeVisibleText.Strip(raw);
+            foreach (string key in new[] { "name", "description", "cost", "target_type" })
+                if (visible.GetValueOrDefault(key) is not string value || string.IsNullOrWhiteSpace(value))
+                    missing.Add("native_selector_card_" + key);
+            // The text profile has no qualified inline-icon projection yet. Do not
+            // erase an icon and retain a misleading allegedly complete description.
+            foreach (string? value in visible.Values.OfType<string>())
+                if (value.Contains('{') || value.Contains('}'))
+                    missing.Add("unqualified_native_selector_rich_text");
+            if (visible.GetValueOrDefault("keywords") is List<Dictionary<string, object?>> tips)
+                foreach (var tip in tips)
+                    if (tip.Values.Any(value => value is not string text || string.IsNullOrWhiteSpace(text))
+                        || tip.Values.OfType<string>().Any(value => value.Contains('{') || value.Contains('}')))
+                        missing.Add("native_selector_hover_text");
+            if (card.Enchantment != null
+                && (visible.GetValueOrDefault("enchantment_description") is not string text || string.IsNullOrWhiteSpace(text)))
+                missing.Add("native_selector_enchantment_description");
+        }
+        catch (Exception error) when (error is not NativeRenderStateViolationException)
+        {
+            // Private, opt-in diagnosis of an actual render failure. Type metadata
+            // avoids invoking a model getter after preflight has rejected it.
+            if (Environment.GetEnvironmentVariable("STS2_NATIVE_CARD_RENDER_DIAGNOSTICS") == "1")
+                Console.Error.WriteLine($"[native-card-render] {subject.GetType().FullName} stage={stage}: {error}");
+            missing.Add(error is InvalidOperationException && error.Message.StartsWith("native_", StringComparison.Ordinal)
+                ? error.Message : "native_selector_card_render_failed");
+            visible["description"] = null;
+        }
+        finally { if (addedToPath) path.Remove(subject); }
+        return new(visible, missing.Distinct(StringComparer.Ordinal).ToArray());
+    }
+}
diff --git a/src/Sts2Headless/NativeRelicPresentation.cs b/src/Sts2Headless/NativeRelicPresentation.cs
new file mode 100644
index 0000000..8c139eb
--- /dev/null
+++ b/src/Sts2Headless/NativeRelicPresentation.cs
@@ -0,0 +1,180 @@
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Commands;
+using MegaCrit.Sts2.Core.Context;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.GameActions.Multiplayer;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Multiplayer;
+using MegaCrit.Sts2.Core.Nodes.Screens;
+using MegaCrit.Sts2.Core.Runs;
+using MegaCrit.Sts2.Core.TestSupport;
+
+namespace Sts2Headless;
+
+// TestMode supplies no relic screen. Replace that presentation only, scoped to
+// the exact synchronous native command. Native reservation, seen bookkeeping,
+// selected-index synchronization, return value and caller effects stay native.
+internal static class NativeRelicPresentation
+{
+    internal static bool HookReady { get; private set; }
+    private static readonly ConditionalWeakTable<Player, Binding> Owners = new();
+    private static readonly ConditionalWeakTable<NChooseARelicSelection, Pending> Screens = new();
+    [ThreadStatic] private static Frame? _current;
+
+    internal sealed class Binding : IDisposable
+    {
+        internal Binding(Player player, RunState run, Func<bool> noOtherSelection)
+        { Player=player; Run=run; NoOtherSelection=noOtherSelection; }
+        internal Player Player { get; }
+        internal RunState Run { get; }
+        internal Func<bool> NoOtherSelection { get; }
+        internal readonly object Gate = new();
+        internal Pending? Choice;
+        internal bool Disposed;
+        internal bool Current() => !Disposed && TestMode.IsOn && ReferenceEquals(Player.RunState,Run)
+            && ReferenceEquals(RunManager.Instance.DebugOnlyGetState(),Run)
+            && Run.Players.Count==1 && ReferenceEquals(Run.Players[0],Player)
+            && RunManager.Instance.NetService is NetSingleplayerGameService && LocalContext.IsMe(Player);
+        internal bool HasPending { get { lock(Gate) return Choice is { Completion.Task.IsCompleted:false }; } }
+        internal Pending? Observe()
+        {
+            lock(Gate) return Choice is { Completion.Task.IsCompleted:false } choice ? choice : null;
+        }
+        public void Dispose()
+        {
+            lock(Gate)
+            {
+                Disposed=true;
+                Choice?.Completion.TrySetCanceled();
+                Choice=null;
+                if(Owners.TryGetValue(Player,out var current)&&ReferenceEquals(current,this)) Owners.Remove(Player);
+            }
+        }
+    }
+    internal sealed class Pending
+    {
+        internal Pending(Binding owner, IReadOnlyList<RelicModel> original, PlayerChoiceSynchronizer synchronizer, uint choiceId)
+        { Owner=owner; Original=original; Options=original.ToArray(); Synchronizer=synchronizer; ChoiceId=choiceId; Screen=new NChooseARelicSelection(); }
+        internal Binding Owner { get; }
+        internal IReadOnlyList<RelicModel> Original { get; }
+        internal RelicModel[] Options { get; }
+        internal object Identity { get; } = new();
+        internal NChooseARelicSelection Screen { get; }
+        internal PlayerChoiceSynchronizer Synchronizer { get; }
+        internal uint ChoiceId { get; }
+        internal TaskCompletionSource<IEnumerable<RelicModel>> Completion { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        internal bool Current() => Owner.Current() && !Completion.Task.IsCompleted
+            && ReferenceEquals(Owner.Choice,this) && Owner.NoOtherSelection()
+            && ReferenceEquals(RunManager.Instance.PlayerChoiceSynchronizer,Synchronizer)
+            && Synchronizer.ChoiceIds.Count==1 && ChoiceId<uint.MaxValue && Synchronizer.ChoiceIds[0]==ChoiceId+1
+            && Options.Length>0 && Options.Distinct(ReferenceEqualityComparer.Instance).Count()==Options.Length
+            && Options.SequenceEqual(Original,ReferenceEqualityComparer.Instance);
+        internal bool Complete(Player player, object? selector, object? relic, bool skip)
+        {
+            lock(Owner.Gate)
+            {
+                if(!ReferenceEquals(player,Owner.Player)||!Current()||!NativeObjectIdentity.Matches(Identity,selector))return false;
+                RelicModel? selected=skip ? null : Options.SingleOrDefault(option=>NativeObjectIdentity.Matches(option,relic));
+                if(!skip&&selected==null)return false;
+                return Completion.TrySetResult(skip ? Array.Empty<RelicModel>() : new[]{selected!});
+            }
+        }
+    }
+    internal sealed class Frame(Binding owner,IReadOnlyList<RelicModel> offered)
+    {
+        internal Binding Owner { get; }=owner;
+        internal IReadOnlyList<RelicModel> Offered { get; }=offered;
+        internal RelicModel[] Options { get; }=offered.ToArray();
+        internal int ThreadId { get; }=Environment.CurrentManagedThreadId;
+        internal PlayerChoiceSynchronizer Synchronizer { get; }=RunManager.Instance.PlayerChoiceSynchronizer;
+        internal uint? ChoiceId;
+        internal int ReservationCalls;
+        internal Pending? Pending;
+        internal bool Consumed,Closed;
+    }
+    internal static Binding Bind(Player player,RunState run,Func<bool> noOtherSelection)
+    {
+        if(Owners.TryGetValue(player,out _))throw new InvalidOperationException("A native relic presentation owner is already bound");
+        var result=new Binding(player,run,noOtherSelection);Owners.Add(player,result);return result;
+    }
+    public static void CommandPrefix(Player player,IReadOnlyList<RelicModel> relics,out Frame? __state)
+    {
+        __state=null;
+        if(!TestMode.IsOn)return;
+        if(typeof(RelicSelectCmd).Assembly.ManifestModule.ModuleVersionId!=new Guid("57785517-0b16-42b9-8b36-bad6fb28384b")
+            || _current!=null || !Owners.TryGetValue(player,out var owner) || !owner.Current() || !owner.NoOtherSelection()
+            || owner.HasPending || relics.Count==0 || relics.Any(relic=>relic==null)
+            || relics.Distinct(ReferenceEqualityComparer.Instance).Count()!=relics.Count)
+            throw new InvalidOperationException("Exact native relic command presentation is unavailable, nested or overlapping");
+        __state=new Frame(owner,relics);_current=__state;
+    }
+    public static Exception? CommandFinalizer(Frame? __state,Task<RelicModel?>? __result,Exception? __exception)
+    {
+        if(__state!=null)
+        {
+            __state.Closed=true;
+            bool exact=ReferenceEquals(_current,__state)&&__state.ThreadId==Environment.CurrentManagedThreadId;
+            _current=null;
+            if(!exact||__exception!=null||__result is { IsFaulted:true } or { IsCanceled:true }
+                || __state.Pending!=null&&!__state.Consumed)
+                __state.Pending?.Completion.TrySetCanceled();
+        }
+        return __exception;
+    }
+    public static bool ShowPrefix(IReadOnlyList<RelicModel> relics,ref NChooseARelicSelection? __result)
+    {
+        if(!TestMode.IsOn)return true;
+        Frame? frame=_current;
+        if(frame==null||frame.Closed||frame.Consumed||frame.Pending!=null||frame.ThreadId!=Environment.CurrentManagedThreadId
+            ||!ReferenceEquals(relics,frame.Offered)||!frame.Options.SequenceEqual(relics,ReferenceEqualityComparer.Instance)
+            ||!frame.Owner.Current()||!frame.Owner.NoOtherSelection()||frame.ReservationCalls!=1||frame.ChoiceId==null)
+            throw new InvalidOperationException("Relic presentation does not match the exact native command frame");
+        lock(frame.Owner.Gate)
+        {
+            if(frame.Owner.Choice is { Completion.Task.IsCompleted:false })throw new InvalidOperationException("Native relic presentations overlap");
+            var pending=new Pending(frame.Owner,relics,frame.Synchronizer,frame.ChoiceId.Value);
+            frame.Owner.Choice=pending;frame.Pending=pending;Screens.Add(pending.Screen,pending);__result=pending.Screen;
+        }
+        return false;
+    }
+    public static bool SelectedPrefix(NChooseARelicSelection __instance,ref Task<IEnumerable<RelicModel>> __result)
+    {
+        if(!Screens.TryGetValue(__instance,out var pending))
+        {
+            if(TestMode.IsOn)throw new InvalidOperationException("No exact native relic presentation owns this callback");
+            return true;
+        }
+        Frame? frame=_current;
+        if(frame==null||frame.Closed||frame.Consumed||frame.ThreadId!=Environment.CurrentManagedThreadId
+            ||!ReferenceEquals(frame.Pending,pending)||!pending.Current())
+            throw new InvalidOperationException("Native relic callback is late, foreign or already consumed");
+        frame.Consumed=true;__result=pending.Completion.Task;return false;
+    }
+    public static void ReservePostfix(PlayerChoiceSynchronizer __instance,Player player,uint __result)
+    {
+        Frame? frame=_current;
+        if(frame==null||frame.Closed)return;
+        frame.ReservationCalls++;
+        if(frame.ThreadId==Environment.CurrentManagedThreadId&&ReferenceEquals(frame.Owner.Player,player)
+            &&ReferenceEquals(frame.Synchronizer,__instance)&&frame.ReservationCalls==1) frame.ChoiceId=__result;
+        else frame.ChoiceId=null;
+    }
+    internal static void Install(Harmony harmony)
+    {
+        if(HookReady)return;
+        harmony.Patch(AccessTools.Method(typeof(PlayerChoiceSynchronizer),nameof(PlayerChoiceSynchronizer.ReserveChoiceId),new[]{typeof(Player)})
+            ??throw new MissingMethodException("Exact native relic choice reservation changed"),
+            postfix:new HarmonyMethod(typeof(NativeRelicPresentation),nameof(ReservePostfix)));
+        harmony.Patch(AccessTools.Method(typeof(RelicSelectCmd),nameof(RelicSelectCmd.FromChooseARelicScreen),
+            new[]{typeof(Player),typeof(IReadOnlyList<RelicModel>)})??throw new MissingMethodException("Exact native relic command changed"),
+            prefix:new HarmonyMethod(typeof(NativeRelicPresentation),nameof(CommandPrefix)),
+            finalizer:new HarmonyMethod(typeof(NativeRelicPresentation),nameof(CommandFinalizer)));
+        harmony.Patch(AccessTools.Method(typeof(NChooseARelicSelection),nameof(NChooseARelicSelection.ShowScreen),new[]{typeof(IReadOnlyList<RelicModel>)})
+            ??throw new MissingMethodException("Exact native relic presentation changed"),prefix:new HarmonyMethod(typeof(NativeRelicPresentation),nameof(ShowPrefix)));
+        harmony.Patch(AccessTools.Method(typeof(NChooseARelicSelection),nameof(NChooseARelicSelection.RelicsSelected))
+            ??throw new MissingMethodException("Exact native relic completion changed"),prefix:new HarmonyMethod(typeof(NativeRelicPresentation),nameof(SelectedPrefix)));
+        HookReady=true;
+    }
+}
