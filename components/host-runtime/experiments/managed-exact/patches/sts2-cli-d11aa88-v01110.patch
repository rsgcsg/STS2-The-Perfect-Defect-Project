+        try
+        {
+            bool empty=false;try{RelicSelectCmd.FromChooseARelicScreen(player,Array.Empty<RelicModel>()).GetAwaiter().GetResult();}catch{empty=true;}
+            Check(empty&&synchronizer.ChoiceIds.Count==0,"empty unsupported screen refuses before reservation");
+            var task=RelicSelectCmd.FromChooseARelicScreen(player,offers);
+            Check(!task.IsCompleted,"actual native relic command must suspend on exact presentation");
+            Check(synchronizer.ChoiceIds.SequenceEqual(new[]{1U}),"native choice reservation must run once");
+            Check(progress.DiscoveredRelics.SetEquals(offers.Select(relic=>relic.Id)),"native mark-seen loop must run before selection await");
+            object pending=Pending();string selector=Ref(Prop(pending,"Identity"));
+            Check((uint)Prop(pending,"ChoiceId")==0,"pending owner retains exact native reservation result");
+            Check(!(bool)Invoke(pending.GetType(),"Complete",pending,Bare<Player>(),selector,Ref(first),false),"foreign player refuses");
+            Check(!Complete(pending,"stale-selector",Ref(first),false),"stale selector refuses");
