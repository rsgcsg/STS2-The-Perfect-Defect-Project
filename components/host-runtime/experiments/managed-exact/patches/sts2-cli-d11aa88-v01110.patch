+    private sealed record VisibleHoverFactsResult(
+        List<Dictionary<string, object?>> Keywords,
+        List<Dictionary<string, object?>> CardPreviews,
+        bool Complete);
+
+    private VisibleHoverFactsResult VisibleHoverFacts(IEnumerable<IHoverTip>? tips)
+    {
+        var keywords = new List<Dictionary<string, object?>>();
+        var cardPreviews = new List<Dictionary<string, object?>>();
+        var seen = new HashSet<string>(StringComparer.Ordinal);
+        var complete = true;
+        foreach (var tip in IHoverTip.RemoveDupes(tips ?? Array.Empty<IHoverTip>()))
+        {
+            switch (tip)
+            {
+                case HoverTip text:
+                {
+                    var name = StripVisibleText(text.Title);
+                    var description = StripVisibleText(text.Description);
+                    var key = name ?? description;
+                    if (key != null && seen.Add($"text:{key}"))
+                    {
+                        keywords.Add(new Dictionary<string, object?>
+                        {
+                            ["name"] = name ?? "Unnamed",
+                            ["description"] = description,
+                        });
+                    }
+                    break;
+                }
+                case CardHoverTip cardTip when seen.Add($"card:{cardTip.Id}"):
+                    cardPreviews.Add(VisibleHoverCard(cardTip.Card));
+                    break;
+                case CardHoverTip:
+                    break;
+                default:
+                    complete = false;
+                    break;
+            }
+        }
+        return new VisibleHoverFactsResult(keywords, cardPreviews, complete);
+    }
+
+    private Dictionary<string, object?> VisibleHoverCard(CardModel card)
+    {
+        string? description;
+        try { description = StripVisibleText(card.GetDescriptionForPile(PileType.None)); }
+        catch { description = StripVisibleText(card.Description.GetFormattedText()); }
+        var result = new Dictionary<string, object?>
+        {
+            ["id"] = card.Id.Entry,
+            ["name"] = StripVisibleText(card.Title),
+            ["type"] = card.Type.ToString(),
+            ["cost"] = card.EnergyCost.CostsX ? "X" : card.EnergyCost.GetAmountToSpend().ToString(),
+            ["star_cost"] = card.HasStarCostX
+                ? "X"
+                : card.CurrentStarCost >= 0 ? card.GetStarCostWithModifiers().ToString() : null,
+            ["description"] = description,
+            ["rarity"] = card.Rarity.ToString(),
+            ["is_upgraded"] = card.IsUpgraded,
+        };
+        if (card.Enchantment != null)
+        {
+            result["enchantment_id"] = card.Enchantment.Id.Entry;
+            result["enchantment"] = StripVisibleText(card.Enchantment.Title.GetFormattedText());
+            result["enchantment_description"] = StripVisibleText(card.Enchantment.DynamicDescription.GetFormattedText());
+            result["enchantment_amount"] = card.Enchantment.Amount;
+        }
+        return result;
+    }
+
+    private static string? StripVisibleText(string? value) => value == null
+        ? null
+        : System.Text.RegularExpressions.Regex.Replace(
+            value,
+            @"\[/?[a-zA-Z_][a-zA-Z0-9_=]*\]",
+            string.Empty).Replace("\n", " ");
+
+    private static string ResolveVisibleVariables(
+        string text,
+        IReadOnlyDictionary<string, object?> variables)
+    {
+        return System.Text.RegularExpressions.Regex.Replace(
+            text,
+            @"\{(?<name>[A-Za-z0-9_]+)(?::[^}]*)?\}",
+            match =>
+            {
+                string name = match.Groups["name"].Value;
+                KeyValuePair<string, object?> value = variables.FirstOrDefault(pair =>
+                    string.Equals(pair.Key, name, StringComparison.OrdinalIgnoreCase));
+                return value.Key == null ? match.Value : Convert.ToString(value.Value) ?? match.Value;
+            });
+    }
