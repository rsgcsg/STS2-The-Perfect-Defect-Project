+            Check(!task.IsCompleted&&received.Count==0,"rejected input must not synchronize a choice");
+            offers.Reverse();Check(!Complete(pending,selector,Ref(first),false),"changed native offer list refuses");offers.Reverse();
+            Set(player,"_runState",Bare<RunState>());Check(!Complete(pending,selector,Ref(first),false),"foreign run refuses");Set(player,"_runState",run);
+            bool late=false;try{((NChooseARelicSelection)Prop(pending,"Screen")).RelicsSelected().GetAwaiter().GetResult();}catch{late=true;}
+            Check(late&&!task.IsCompleted,"late callback cannot borrow a returned command frame");
+
+            bool overlap=false;try{RelicSelectCmd.FromChooseARelicScreen(player,offers).GetAwaiter().GetResult();}catch{overlap=true;}
+            Check(overlap&&synchronizer.ChoiceIds[0]==1,"overlap refused before reserve");
+            Check(Complete(pending,selector,Ref(second),false),"original offered relic completion accepted");
+            Check(ReferenceEquals(task.WaitAsync(TimeSpan.FromSeconds(2)).GetAwaiter().GetResult(),second),"native command returns original selected object");
+            Check(received.SequenceEqual(new[]{1}),"native synchronizer receives original offered index");
+            Check(!Complete(pending,selector,Ref(first),false),"repeated terminal input refuses");
+            var skip=RelicSelectCmd.FromChooseARelicScreen(player,offers);pending=Pending();selector=Ref(Prop(pending,"Identity"));
+            Check(Complete(pending,selector,null,true),"native empty selection accepted");
+            Check(skip.WaitAsync(TimeSpan.FromSeconds(2)).GetAwaiter().GetResult()==null&&received.SequenceEqual(new[]{1,-1}),"native skip resumes synchronizer with -1");
+            var canceled=RelicSelectCmd.FromChooseARelicScreen(player,offers);pending=Pending();selector=Ref(Prop(pending,"Identity"));
+            synchronizer.ReserveChoiceId(player);
+            Check(!Complete(pending,selector,Ref(first),false),"changed native choice reservation refuses without borrowing owner");
+            binding.Dispose();
+            bool cancellation=false;try{canceled.WaitAsync(TimeSpan.FromSeconds(2)).GetAwaiter().GetResult();}catch(OperationCanceledException){cancellation=true;}
+            Check(cancellation&&received.Count==2,"teardown cancels without inventing skip or awarding");
+            Check(!Complete(pending,selector,Ref(first),false),"late completion after teardown refuses");
+            Console.WriteLine($"{checks-before} exact native relic command checks passed");
+            TestCardReward(player, run, synchronizer);
+        }
+        finally {binding.Dispose();synchronizer.Dispose();SaveManager.ClearInstanceForTesting();Set(manager,"<State>k__BackingField",null);}
+    }
+}
