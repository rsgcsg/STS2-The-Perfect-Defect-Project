diff --git a/tests/Program.cs b/tests/Program.cs
new file mode 100644
index 0000000..f121a08
--- /dev/null
+++ b/tests/Program.cs
@@ -0,0 +1,251 @@
+using Sts2Headless;
+
+static void Require(bool condition, string caseName)
+{
+    if (!condition)
+        throw new InvalidOperationException($"Play-window contract failed: {caseName}");
+}
+
+static bool Open(
+    bool playerPlayPhase = true,
+    bool partOfPlayerTurn = true,
+    bool playerActionsEnabled = true,
+    bool notReadyToEndTurn = true,
+    bool actionQueuePlayPhase = true) => NativePlayWindowAdmission.IsOpen(
+        combatRoomCurrent: true,
+        currentRunOwned: true,
+        combatInProgress: true,
+        playerAlive: true,
+        playerPlayPhase: playerPlayPhase,
+        partOfPlayerTurn: partOfPlayerTurn,
+        playerActionsEnabled: playerActionsEnabled,
+        notReadyToEndTurn: notReadyToEndTurn,
+        actionQueuePlayPhase: actionQueuePlayPhase);
+
+Require(Open(), "all native owner facts open");
+Require(!Open(playerPlayPhase: false), "non-play player phase");
+Require(!Open(partOfPlayerTurn: false), "different player's turn");
+Require(!Open(playerActionsEnabled: false), "native actions disabled");
+Require(!Open(notReadyToEndTurn: false), "player already ready to end turn");
+Require(!Open(actionQueuePlayPhase: false), "action synchronizer outside PlayPhase");
+Console.WriteLine("5 native play-window blockers and positive case passed");
+
+var room = new object();
+var currentEvent = new object();
+var option = new EventOption(false);
+var identities = new Dictionary<object, string> {
+    [room] = "room-current", [currentEvent] = "event-current", [option] = "option-current"
+};
+bool Matches(object current, object? expected) => expected is string key
+    && identities.TryGetValue(current, out var identity) && key == identity;
+bool Admits(object? candidateRoom, object? candidateEvent, IReadOnlyList<EventOption>? options,
+            int index, string? expectedRoom = "room-current",
+            string? expectedEvent = "event-current", string? expectedOption = "option-current") =>
+    NativeEventOptionAdmission.Admits(candidateRoom, candidateEvent, options, index,
+        expectedRoom, expectedEvent, expectedOption, Matches, current => current.Locked);
+
+Require(Admits(room, currentEvent, [option], 0), "exact current event option admitted");
+Require(!Admits(room, currentEvent, [new EventOption(false)], 0),
+    "same-index replacement rejected");
+Require(!Admits(new object(), currentEvent, [option], 0), "replaced room rejected");
+Require(!Admits(room, new object(), [option], 0), "replaced event rejected");
+Require(!Admits(room, currentEvent, [new EventOption(true)], 0), "locked option rejected");
+Require(!Admits(room, currentEvent, [option], 1), "out-of-range option rejected");
+Require(!Admits(room, currentEvent, [option], 0, expectedOption: null),
+    "missing option binding rejected");
+Console.WriteLine("7 exact event-option admission cases passed");
+
+object? callbackRoom = room;
+object? callbackEvent = currentEvent;
+IReadOnlyList<EventOption>? callbackOptions = [option];
+var chosenCalls = 0;
+Func<Task> delayed = () => NativeEventOptionAdmission.InvokeCurrentAsync(
+    () => (callbackRoom, callbackEvent, callbackOptions), option, 0,
+    "room-current", "event-current", "option-current", Matches,
+    current => current.Locked,
+    _ => { chosenCalls++; return Task.CompletedTask; });
+async Task RejectDelayed(string caseName)
+{
+    var rejected = false;
+    try { await delayed(); }
+    catch (InvalidOperationException) { rejected = true; }
+    Require(rejected && chosenCalls == 0, caseName);
+}
+
+callbackRoom = new object();
+await RejectDelayed("delayed replaced room does not call Chosen");
+callbackRoom = room;
+callbackEvent = new object();
+await RejectDelayed("delayed replaced event does not call Chosen");
+callbackEvent = currentEvent;
+var replacement = new EventOption(false);
+identities[replacement] = "option-current"; // Even a colliding test identity cannot change the captured object.
+callbackOptions = [replacement];
+await RejectDelayed("delayed same-index replacement does not call Chosen");
+callbackOptions = [option];
+option.Locked = true;
+await RejectDelayed("delayed locked flip does not call Chosen");
+option.Locked = false;
+await delayed();
+Require(chosenCalls == 1, "unchanged delayed option calls Chosen exactly once");
+Console.WriteLine("5 delayed event callback cases passed");
+
+var treasureRoom = new object();
+object? currentTreasureRoom = treasureRoom;
+var treasureIdentities = new Dictionary<object, string> { [treasureRoom] = "treasure-room-current" };
+bool TreasureMatches(object current, object? expected) => expected is string key
+    && treasureIdentities.TryGetValue(current, out var identity) && key == identity;
+var chestOpened = false;
+var relicResolved = false;
+var openedCalls = 0;
+Func<Task> delayedTreasureOpen = () => NativeTreasureChestAdmission.InvokeCurrentAsync(
+    () => (currentTreasureRoom, chestOpened, relicResolved), treasureRoom,
+    "treasure-room-current", TreasureMatches,
+    () => { openedCalls++; return Task.CompletedTask; });
+async Task RejectTreasure(string caseName)
+{
+    var rejected = false;
+    try { await delayedTreasureOpen(); }
+    catch (InvalidOperationException) { rejected = true; }
+    Require(rejected && openedCalls == 0, caseName);
+}
+currentTreasureRoom = new object();
+await RejectTreasure("deferred chest opening rejects replaced room");
+currentTreasureRoom = treasureRoom;
+chestOpened = true;
+await RejectTreasure("deferred chest opening rejects already-opened chest");
+chestOpened = false;
+relicResolved = true;
+await RejectTreasure("deferred chest opening rejects resolved relic");
+relicResolved = false;
+await delayedTreasureOpen();
+Require(openedCalls == 1, "unchanged closed chest calls native opener exactly once");
+Console.WriteLine("4 deferred treasure chest cases passed");
+
+var merchantRoom = new object();
+var removalEntry = new object();
+object? currentMerchantRoom = merchantRoom;
+object? currentRemovalEntry = removalEntry;
+var merchantIdentities = new Dictionary<object, string> {
+    [merchantRoom] = "merchant-room-current", [removalEntry] = "removal-entry-current"
+};
+bool MerchantMatches(object current, object? expected) => expected is string key
+    && merchantIdentities.TryGetValue(current, out var identity) && key == identity;
+var stocked = true;
+var enoughGold = true;
+var purchaseCalls = 0;
+Func<Task> delayedRemoval = () => NativeMerchantRemovalAdmission.InvokeCurrentAsync(
+    () => (currentMerchantRoom, currentRemovalEntry, stocked, enoughGold),
+    merchantRoom, removalEntry, "merchant-room-current", "removal-entry-current",
+    MerchantMatches, () => { purchaseCalls++; return Task.CompletedTask; });
+async Task RejectRemoval(string caseName)
+{
+    var rejected = false;
+    try { await delayedRemoval(); }
+    catch (InvalidOperationException) { rejected = true; }
+    Require(rejected && purchaseCalls == 0, caseName);
+}
+currentMerchantRoom = new object();
+await RejectRemoval("deferred merchant removal rejects replaced room");
+currentMerchantRoom = merchantRoom;
+currentRemovalEntry = new object();
+await RejectRemoval("deferred merchant removal rejects same-slot replacement");
+currentRemovalEntry = removalEntry;
+stocked = false;
+await RejectRemoval("deferred merchant removal rejects unstocked entry");
+stocked = true;
+enoughGold = false;
+await RejectRemoval("deferred merchant removal rejects insufficient gold");
+enoughGold = true;
+await delayedRemoval();
+Require(purchaseCalls == 1, "unchanged merchant removal invokes native purchase exactly once");
+Console.WriteLine("5 deferred merchant removal cases passed");
+
+// The actual helper called by RunSimulator.VisiblePile, with synthetic visible
+// card DTOs. No native CardModel/gameplay or shipped UI parity is implied.
+Dictionary<string, object?> PileCard(string token, int index, string cost = "1") => new()
+{
+    ["native_ref"] = token, ["index"] = index, ["private_card_state"] = token + "-hidden",
+    ["id"] = "STRIKE", ["name"] = "Strike", ["type"] = "Attack", ["cost"] = cost,
+    ["description"] = "Deal 6 damage.", ["rarity"] = "Basic", ["is_upgraded"] = false,
+};
+string Json(object value) => System.Text.Json.JsonSerializer.Serialize(value);
+var originalPile = FairPileProjection.Create("draw",
+    [PileCard("native-200", 0), PileCard("native-100", 1, "0"), PileCard("native-300", 2)]);
+var hiddenPermutation = FairPileProjection.Create("draw",
+    [PileCard("native-9900", 45), PileCard("native-9800", 44), PileCard("native-9700", 43, "0")]);
+Require(Json(originalPile) == Json(hiddenPermutation), "draw ignores native order/index/identity/private state");
+Require((string)originalPile["ordering_semantics"]! == "unordered_multiset"
+    && !Json(originalPile).Contains("native-") && !Json(originalPile).Contains("index"),
+    "pile projection omits private fields before ordering");
+var visiblePile = (Dictionary<string, object?>[])originalPile["cards"]!;
+Require(visiblePile.Length == 3 && visiblePile.Count(card => (string)card["cost"]! == "1") == 2,
+    "draw retains duplicate occurrences and visible cost distinctions");
+Require(Json(originalPile) != Json(FairPileProjection.Create("draw", [PileCard("native-200", 0)])),
+    "visible multiplicity changes remain observable");
+foreach (string zone in new[] { "discard", "exhaust" })
+{
+    var orderedPile = FairPileProjection.Create(zone, [PileCard("a", 0), PileCard("b", 1, "0")]);
+    Require((string)orderedPile["ordering_semantics"]! == "native_visible_order" && Json(orderedPile) !=
+            Json(FairPileProjection.Create(zone, [PileCard("b", 0, "0"), PileCard("a", 1)])),
+        zone + " keeps its existing presented order");
+}
+Console.WriteLine("6 fair pile projection cases passed");
+Console.WriteLine("fair-pile-json=" + Json(originalPile));
+
+
+// Actual AnyPlayer domain adapter; legality is a declared fake delegate here.
+// The exact-game IsValidTarget predicate is a separate proprietary local gate.
+var potionPlayer = new object();
+var anotherPotionPlayer = new object();
+var potionPlayerIds = new Dictionary<object, string> {
+    [potionPlayer] = "native-1", [anotherPotionPlayer] = "native-player-replacement"
+};
+bool PotionPlayerMatches(object current, object? expected) => expected is string key
+    && potionPlayerIds.TryGetValue(current, out var identity) && key == identity;
+var nativeTargetValid = true;
+var nativeTargetChecks = new List<object>();
+bool NativeTargetValid(object current) { nativeTargetChecks.Add(current); return nativeTargetValid; }
+IReadOnlyList<object>? currentPotionPlayers = [potionPlayer];
+object currentPotionOwner = potionPlayer;
+object? ResolvePotionTarget(object? expected = null) => NativePotionTargetAdmission.Resolve(
+    currentPotionPlayers, potionPlayer, currentPotionOwner, expected, PotionPlayerMatches, NativeTargetValid);
+Require(ReferenceEquals(ResolvePotionTarget("native-1"), potionPlayer), "explicit AnyPlayer resolves current native object");
+Require(nativeTargetChecks.Count == 1 && ReferenceEquals(nativeTargetChecks[0], potionPlayer),
+    "native legality observes exactly the bound current player");
+Require(ResolvePotionTarget() == null, "missing AnyPlayer target cannot default to self");
+Require(ResolvePotionTarget("native-foreign") == null, "foreign AnyPlayer target rejected");
+currentPotionPlayers = [];
+Require(ResolvePotionTarget("native-1") == null, "zero-player domain rejected");
+currentPotionPlayers = [potionPlayer, anotherPotionPlayer];
+Require(ResolvePotionTarget("native-1") == null, "multi-player domain is not truncated");
+currentPotionPlayers = [anotherPotionPlayer];
+Require(ResolvePotionTarget("native-1") == null, "replaced run player rejected");
+currentPotionPlayers = [potionPlayer];
+currentPotionOwner = anotherPotionPlayer;
+Require(ResolvePotionTarget("native-1") == null, "replaced potion owner rejected");
+currentPotionOwner = potionPlayer;
+nativeTargetValid = false;
+Require(ResolvePotionTarget("native-1") == null, "current unavailable native target rejected");
+Require(NativePotionTargetAdmission.HasCompleteDomain(currentPotionPlayers, potionPlayer, currentPotionOwner)
+    && NativePotionTargetAdmission.ValidTargets(currentPotionPlayers, potionPlayer, currentPotionOwner, NativeTargetValid).Count == 0,
+    "complete unavailable target domain is empty");
+nativeTargetValid = true;
+var usablePotionTargets = NativePotionTargetAdmission.ValidTargets(
+    currentPotionPlayers, potionPlayer, currentPotionOwner, NativeTargetValid);
+Require(usablePotionTargets.Count == 1 && ReferenceEquals(usablePotionTargets[0], potionPlayer),
+    "complete valid target domain preserves the actual native player");
+Require(NativePotionTargetAdmission.ValidTargets(new[] { potionPlayer, anotherPotionPlayer },
+    potionPlayer, potionPlayer, NativeTargetValid).Count == 0,
+    "multi-player catalog cannot publish one local target");
+Console.WriteLine("12 AnyPlayer target admission cases passed");
+Console.WriteLine("any-player-target-json=" + Json(new {
+    binding_supported = NativePotionTargetAdmission.HasCompleteDomain(currentPotionPlayers, potionPlayer, currentPotionOwner),
+    valid_target_refs = usablePotionTargets.Select(current => potionPlayerIds[current]).ToArray()
+}));
+
+internal sealed class EventOption
+{
+    public EventOption(bool locked) => Locked = locked;
+    public bool Locked { get; set; }
+}
