+        var reward=Bare<CardReward>();Set(reward,"<Player>k__BackingField",player);
+        var original=new List<CardCreationResult>{new(card)};Set(reward,"_cards",original);
+        Set(reward,"<CanSkip>k__BackingField",true);reward.CanReroll=false;
+        var skip=NativeCardRewardAlternativePreview.Capture(reward);
+        Check(skip.Complete,"actual native Skip preview must be complete: "+skip.Gap);
+        Check(skip.Alternatives!.Select(x=>x.OptionId).SequenceEqual(new[]{"Skip"}),"actual Skip domain");
+        Check(skip.CanSkipSelection==true&&skip.CanReroll==false&&skip.SelectionCompletesReward==true,"actual native flags");
