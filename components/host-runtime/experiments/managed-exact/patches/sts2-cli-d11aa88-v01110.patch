+        Check((string)enchantSummary["description"]! == displayEnchant.DynamicDescription.GetFormattedText(),
+            "enchantment summary uses original native amount/recalculate display and raw label markup");
+        Check((string)enchantSummary["name"]! == displayEnchant.Title.GetFormattedText(),"native enchantment title");
