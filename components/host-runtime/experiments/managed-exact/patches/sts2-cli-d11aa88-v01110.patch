--- /dev/null
+++ b/src/Sts2Headless/NativeTreasureChestAdmission.cs
@@ -0,0 +1,18 @@
+namespace Sts2Headless;
+
+internal static class NativeTreasureChestAdmission
+{
+    public static Task InvokeCurrentAsync(
+        Func<(object? Room, bool ChestOpened, bool RelicResolved)> readCurrent,
+        object selectedRoom, object? expectedRoom,
+        Func<object, object?, bool> matches, Func<Task> open)
+    {
+        var current = readCurrent();
+        if (!ReferenceEquals(current.Room, selectedRoom)
+            || !matches(selectedRoom, expectedRoom)
+            || current.ChestOpened || current.RelicResolved)
+            throw new InvalidOperationException(
+                "The bound closed treasure chest changed before native invocation.");
+        return open();
+    }
+}
