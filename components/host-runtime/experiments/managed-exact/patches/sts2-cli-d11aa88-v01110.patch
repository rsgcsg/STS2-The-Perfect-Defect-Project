+        var map=new MockCraftedActMap(2,2,start,boss);map.Put(0,0);map.Put(1,0);map.Put(0,1);start.AddChildPoint(map.GetPoint(0,0)!);
+        var run=Bare<RunState>();Set(run,"<Map>k__BackingField",map);var visited=new List<MapCoord>{start.coord};Set(run,"_visitedMapCoords",visited);
+        Set(run,"<Modifiers>k__BackingField",Array.Empty<ModifierModel>());Set(run,"<BadgeModels>k__BackingField",Array.Empty<BadgeModel>());
