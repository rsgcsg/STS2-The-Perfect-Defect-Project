@@ -0,0 +1,82 @@
+using MegaCrit.Sts2.Core.CardSelection;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Models;
+
+namespace Sts2Headless;
+
+// Headless presentation state for one game-owned FromDeckForUpgrade choice.
+// Completion still returns the exact selected CardModel objects to STS2.
+internal sealed class DeckUpgradeSelection
+{
+    internal DeckUpgradeSelection(Player player, CardSelectorPrefs preferences, List<CardModel> options)
+    {
+        Player = player;
+        Preferences = preferences;
+        Options = options;
+    }
+
+    internal object Identity { get; } = new();
+    internal Player Player { get; }
+    internal CardSelectorPrefs Preferences { get; }
+    internal List<CardModel> Options { get; }
+    internal List<CardModel> Selected { get; } = new();
+    internal bool IsPreview { get; private set; }
+
+    internal string? Validate(object? selectorRef, Player currentPlayer)
+    {
+        if (!ReferenceEquals(Player, currentPlayer)
+            || !NativeObjectIdentity.Matches(Identity, selectorRef))
+            return "The exact deck-upgrade selector is no longer current";
+        return null;
+    }
+
+    internal string? Select(object? cardRef)
+    {
+        if (IsPreview) return "The deck-upgrade preview owns input";
+        CardModel[] matches = Options.Where(card => NativeObjectIdentity.Matches(card, cardRef)).Take(2).ToArray();
+        if (matches.Length != 1) return "The exact upgrade card is no longer an option";
+        CardModel card = matches[0];
+        if (Selected.Any(value => ReferenceEquals(value, card))
+            || Selected.Count >= Preferences.MaxSelect || !card.IsUpgradable
+            || !PileType.Deck.GetPile(Player).Cards.Any(value => ReferenceEquals(value, card)))
+            return "The exact upgrade card is no longer selectable";
+        Selected.Add(card);
+        if (Selected.Count == Preferences.MaxSelect) IsPreview = true;
+        return null;
+    }
+
+    internal string? Deselect(object? cardRef)
+    {
+        if (IsPreview) return "The deck-upgrade preview owns input";
+        int index = Selected.FindIndex(card => NativeObjectIdentity.Matches(card, cardRef));
+        if (index < 0) return "The exact upgrade card is no longer selected";
+        Selected.RemoveAt(index);
+        return null;
+    }
+
+    internal string? CancelPreview()
+    {
+        if (!IsPreview) return "The deck-upgrade preview is no longer current";
+        Selected.Clear();
+        IsPreview = false;
+        return null;
+    }
+
+    internal string? CanCancelSelection() => IsPreview || !Preferences.Cancelable
+        ? "Native deck-upgrade selection cancel is unavailable"
+        : null;
+
+    internal string? CanConfirm(object? selectedRefs)
+    {
+        if (!IsPreview || Selected.Count < Preferences.MinSelect
+            || Selected.Count > Preferences.MaxSelect
+            || Selected.Any(card => !card.IsUpgradable
+                || !Options.Any(option => ReferenceEquals(option, card))
+                || !PileType.Deck.GetPile(Player).Cards.Any(value => ReferenceEquals(value, card))))
+            return "The exact deck-upgrade selection is no longer confirmable";
+        string expected = string.Join(",", Selected.Select(NativeObjectIdentity.Get));
+        return selectedRefs is string value && value == expected
+            ? null : "The exact selected upgrade cards changed";
+    }
+}
