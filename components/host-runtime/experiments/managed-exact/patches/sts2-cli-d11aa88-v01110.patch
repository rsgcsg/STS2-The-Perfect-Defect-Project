+        Check(repeated.Complete&&wing.DisplayAmount==0&&ReferenceEquals(reward.Cards.Single(),card),"repeated capture has no selection effect");
+        reward.CanReroll=true;
+        Check(!NativeCardRewardAlternativePreview.Capture(reward).Complete,"native factory's >2 alternatives failure must be preserved");
+        var registry=(IList)typeof(ModHelper).GetField("_runHookSubscribers",BindingFlags.Static|BindingFlags.NonPublic)!.GetValue(null)!;
+        int calls=0;
