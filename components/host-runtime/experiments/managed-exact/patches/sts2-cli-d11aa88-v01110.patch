@@ -0,0 +1,37 @@
+using System;
+using System.Linq;
+using System.Runtime.CompilerServices;
+using MegaCrit.Sts2.Core.Rewards;
+
+namespace STS2Platform.NativeFoundation;
+
+/// <summary>Membership observed at the exact native RewardsSet presentation seam.</summary>
+public static class NativeRewardSetObservation
+{
+    private sealed record Owner(RewardsSet Set, bool Ambiguous);
+    private static readonly ConditionalWeakTable<Reward, Owner> Owners = new();
+    private static readonly object Gate = new();
+    public static void Register(RewardsSet set)
+    {
+        ArgumentNullException.ThrowIfNull(set);
+        lock (Gate)
+            foreach (Reward reward in set.Rewards)
+            {
+                bool ambiguous = Owners.TryGetValue(reward, out Owner? prior)
+                    && (prior.Ambiguous || !ReferenceEquals(prior.Set, set));
+                Owners.Remove(reward);
+                Owners.Add(reward, new Owner(set, ambiguous));
+            }
+    }
+    private static readonly System.Reflection.FieldInfo? LinkedParent = typeof(Reward).GetField("<ParentRewardSet>k__BackingField",
+        System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic);
+    public static string Relation(Reward reward) => Capture(reward) == null || LinkedParent == null ? "unavailable"
+        : LinkedParent.GetValue(reward) == null && reward is not LinkedRewardSet ? "independent" : "linked";
+    public static RewardsSet? Capture(Reward reward)
+    {
+        lock (Gate)
+            return Owners.TryGetValue(reward, out Owner? owner) && !owner.Ambiguous
+                && owner.Set.Rewards.Count(member => ReferenceEquals(member, reward)) == 1
+                ? owner.Set : null;
+    }
+}
diff --git a/src/Sts2Headless/NativeRunHookReadQualification.cs b/src/Sts2Headless/NativeRunHookReadQualification.cs
new file mode 100644
index 0000000..9e2ddd1
--- /dev/null
+++ b/src/Sts2Headless/NativeRunHookReadQualification.cs
@@ -0,0 +1,107 @@
+using System;
+using System.Collections;
+using System.Collections.Generic;
+using System.Linq;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Modding;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Runs;
+
+namespace STS2Platform.NativeFoundation;
+
+/// <summary>
+/// Shared bounded read qualification for the exact native run-listener iterator.
+/// Operation-specific native override qualification remains with its provider.
+/// Mod subscribers are rejected BEFORE enumeration can invoke their delegates.
+/// </summary>
+public static class NativeRunHookReadQualification
+{
+    private static readonly Guid AuditedGameMvid = new("57785517-0b16-42b9-8b36-bad6fb28384b");
+    private static readonly FieldInfo? Subscribers = typeof(ModHelper).GetField("_runHookSubscribers",
+        BindingFlags.Static | BindingFlags.NonPublic);
+    public static bool IsUnpatched(MethodBase? method)
+    {
+        try { return method != null && (Harmony.GetPatchInfo(method) is not { } patches || patches.Owners.Count == 0); }
+        catch { return false; }
+    }
+
+    private static bool IteratorIsUnpatched(MethodInfo? method)
+    {
+        Type? stateMachine = method?.GetCustomAttribute<IteratorStateMachineAttribute>()?.StateMachineType;
+        return IsUnpatched(method) && stateMachine != null
+            && IsUnpatched(stateMachine.GetMethod("MoveNext", BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic));
+    }
+
+    private static bool GetterIsUnpatched(Type owner, string property) =>
+        IsUnpatched(owner.GetProperty(property, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)?.GetMethod);
+
+    private static bool NativeLambdaIsUnpatched(Type owner, string sourceMethod)
+    {
+        MethodInfo[] methods = owner.GetNestedType("<>c", BindingFlags.NonPublic)?
+            .GetMethods(BindingFlags.Instance | BindingFlags.Static | BindingFlags.Public | BindingFlags.NonPublic)
+            .Where(method => method.Name.StartsWith("<" + sourceMethod + ">b__", StringComparison.Ordinal)).ToArray()
+            ?? Array.Empty<MethodInfo>();
+        return methods.Length == 1 && IsUnpatched(methods[0]);
+    }
+
+    // Exact direct game-call closure of the audited iterator and Contains.
+    // All checks happen before its first MoveNext, including deferred LINQ
+    // predicates and mutable-owner assertions reached by native membership.
+    private static bool IteratorReadClosureIsUnpatched() =>
+        new[] { "Players", "Modifiers", "BadgeModels", "MultiplayerScalingModel" }
+            .All(name => GetterIsUnpatched(typeof(RunState), name))
+        && new[] { "IsActiveForHooks", "Deck", "Relics", "Potions" }
+            .All(name => GetterIsUnpatched(typeof(Player), name))
+        && GetterIsUnpatched(typeof(CardPile), "Cards")
+        && new[] { "Enchantment", "HasBeenRemovedFromState", "Owner" }
+            .All(name => GetterIsUnpatched(typeof(CardModel), name))
+        && new[] { "IsMelted", "HasBeenRemovedFromState", "Owner" }
+            .All(name => GetterIsUnpatched(typeof(RelicModel), name))
+        && new[] { "HasBeenRemovedFromState", "Owner" }
+            .All(name => GetterIsUnpatched(typeof(PotionModel), name))
+        && new[] { "HasCard", "Card" }.All(name => GetterIsUnpatched(typeof(EnchantmentModel), name))
+        && IsUnpatched(typeof(AbstractModel).GetMethod(nameof(AbstractModel.AssertMutable)))
+        && GetterIsUnpatched(typeof(AbstractModel), "IsMutable")
+        && NativeLambdaIsUnpatched(typeof(RunState), "IterateHookListeners")
+        && NativeLambdaIsUnpatched(typeof(Player), "get_Potions");
+
+    public static bool Preflight(IRunState run)
+    {
+        try
+        {
+            return run.GetType() == typeof(RunState)
+                && typeof(RunState).Assembly.ManifestModule.ModuleVersionId == AuditedGameMvid
+                && Subscribers?.GetValue(null) is ICollection { Count: 0 }
+                && IteratorReadClosureIsUnpatched()
+                && IteratorIsUnpatched(typeof(RunState).GetMethod(nameof(RunState.IterateHookListeners), new[] { typeof(ICombatState) }))
+                && IteratorIsUnpatched(typeof(ModHelper).GetMethod(nameof(ModHelper.IterateAllRunStateSubscribers)))
+                && IsUnpatched(typeof(RunState).GetMethod("Contains", BindingFlags.Static | BindingFlags.NonPublic));
+        }
+        catch { return false; }
+    }
+
+    public static bool TryCaptureListeners(IRunState run, out IReadOnlyList<AbstractModel> listeners, out string? gap)
+    {
+        listeners = Array.Empty<AbstractModel>();
+        gap = "native_run_hook_iterator_not_pure_qualified";
+        try
+        {
+            if (!Preflight(run)) return false;
+            AbstractModel[] current = run.IterateHookListeners(null).ToArray();
+            if (!Preflight(run) || current.Any(model => model == null || model.GetType().Assembly != typeof(RunState).Assembly))
+                return false;
+            listeners = current;
+            gap = null;
+            return true;
+        }
+        catch { return false; }
+    }
+
+    public static bool StillCurrent(IRunState run, IReadOnlyList<AbstractModel> listeners) =>
+        TryCaptureListeners(run, out var current, out _) && listeners.SequenceEqual(current, ReferenceEqualityComparer.Instance);
+}
diff --git a/src/Sts2Headless/NativeSelectorCallScope.cs b/src/Sts2Headless/NativeSelectorCallScope.cs
new file mode 100644
index 0000000..0dc1e17
--- /dev/null
+++ b/src/Sts2Headless/NativeSelectorCallScope.cs
@@ -0,0 +1,81 @@
+using MegaCrit.Sts2.Core.CardSelection;
+using MegaCrit.Sts2.Core.Commands;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.GameActions.Multiplayer;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.TestSupport;
+
+namespace Sts2Headless;
+
+// Each pinned command invokes ICardSelector synchronously before its first await
+// when Selector is nonnull. Finalizer closes the call frame at Task return, not
+// at native continuation completion. Only the consumed pending owner survives.
+internal static class NativeSelectorCallScope
+{
+    internal static bool ChooseHookReady { get; set; }
+    internal static bool CombatHookReady { get; set; }
+    internal static bool SimpleHookReady { get; set; }
+    internal enum Kind { Choose, CombatPile, Simple }
+    internal sealed record Context(Kind Kind, PlayerChoiceContext ChoiceContext, Player Player,
+        ICardSelector? Selector, CardModel[]? Offered, CardPile? Pile,
+        CardSelectorPrefs Preferences, Func<CardModel,bool>? Filter, bool CanSkip);
+    internal sealed class Frame(Context context, Frame? previous)
+    {
+        internal Context Context { get; } = context;
+        internal Frame? Previous { get; } = previous;
+        internal bool Consumed { get; set; }
+        internal bool Closed { get; set; }
+    }
+    [ThreadStatic] private static Frame? _current;
+    public static void ChoosePrefix(PlayerChoiceContext context, IReadOnlyList<CardModel> cards,
+        Player player, bool canSkip, out Frame __state)
+    {
+        __state = new(new(Kind.Choose,context,player,CardSelectCmd.Selector,cards.ToArray(),null,default,null,canSkip),_current);
+        _current = __state;
+    }
+    public static void CombatPrefix(PlayerChoiceContext context, CardPile pile, Player player,
+        CardSelectorPrefs prefs, Func<CardModel,bool>? filter, out Frame __state)
+    {
+        __state = new(new(Kind.CombatPile,context,player,CardSelectCmd.Selector,null,pile,prefs,filter,false),_current);
+        _current = __state;
+    }
+    public static void SimplePrefix(PlayerChoiceContext context, IReadOnlyList<CardModel> cardsIn,
+        Player player, CardSelectorPrefs prefs, out Frame __state)
+    {
+        __state = new(new(Kind.Simple,context,player,CardSelectCmd.Selector,cardsIn.ToArray(),null,prefs,null,false),_current);
+        _current = __state;
+    }
+    public static void SimpleRewardsPrefix(PlayerChoiceContext context, List<CardCreationResult> cards,
+        Player player, CardSelectorPrefs prefs, out Frame __state)
+    {
+        __state = new(new(Kind.Simple,context,player,CardSelectCmd.Selector,cards.Select(result => result.Card).ToArray(),null,prefs,null,false),_current);
+        _current = __state;
+    }
+    public static Exception? Finalizer(Frame? __state, Exception? __exception)
+    {
+        if (__state != null)
+        {
+            __state.Closed = true;
+            _current = ReferenceEquals(_current,__state) ? __state.Previous : null;
+        }
+        return __exception;
+    }
+    internal static Context? Take(ICardSelector selector, IReadOnlyList<CardModel> options,
+        int min, int max, out bool mismatch)
+    {
+        Frame? frame = _current;
+        mismatch = frame != null;
+        if (frame == null) return null;
+        Context c = frame.Context;
+        if (frame.Closed || frame.Consumed || frame.Previous != null || !ReferenceEquals(c.Selector,selector)
+            || !ReferenceEquals(CardSelectCmd.Selector,selector)
+            || (c.Kind == Kind.Choose ? min != 0 || max != 1
+                || !options.SequenceEqual(c.Offered!,ReferenceEqualityComparer.Instance)
+                : min != c.Preferences.MinSelect || max != c.Preferences.MaxSelect
+                    || c.Kind == Kind.Simple && !options.SequenceEqual(c.Offered!,ReferenceEqualityComparer.Instance))) return null;
+        frame.Consumed = true;
+        mismatch = false;
+        return c;
+    }
+}
