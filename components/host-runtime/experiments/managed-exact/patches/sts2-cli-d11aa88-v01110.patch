+++ b/terminal-tests/Program.cs
@@ -0,0 +1,125 @@
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Runtime.Loader;
+using System.Security.Cryptography;
+using System.Text.Json;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Context;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Map;
+using MegaCrit.Sts2.Core.Models.Badges;
+using MegaCrit.Sts2.Core.Models.Characters;
+using MegaCrit.Sts2.Core.Multiplayer;
+using MegaCrit.Sts2.Core.Nodes.Screens.GameOverScreen;
+using MegaCrit.Sts2.Core.Rooms;
+using MegaCrit.Sts2.Core.Runs;
+using MegaCrit.Sts2.Core.Saves;
+using MegaCrit.Sts2.Core.Saves.Managers;
+using MegaCrit.Sts2.Core.Saves.Test;
+using MegaCrit.Sts2.Core.Saves.Validation;
+using MegaCrit.Sts2.Core.TestSupport;
+using MegaCrit.Sts2.Core.Unlocks;
+using Sts2Headless;
+
+class Program
+{
+    static int checks;
+    static int ends;
+    static void Check(bool b, string message) { if (!b) throw new Exception(message); checks++; }
+    static void Set(object obj, string name, object? value) => obj.GetType().GetField(name,
+        BindingFlags.Instance | BindingFlags.NonPublic)!.SetValue(obj, value);
+    public static void CountEnd() => ends++;
+    static void Main(string[] args)
+    {
+        string root = Path.GetFullPath(Path.Combine(AppContext.BaseDirectory, "..", "..", "..", "..", ".."));
+        AssemblyLoadContext.Default.Resolving += (_, n) => File.Exists(Path.Combine(root, "lib", n.Name + ".dll"))
+            ? AssemblyLoadContext.Default.LoadFromAssemblyPath(Path.Combine(root, "lib", n.Name + ".dll")) : null;
+        Test(args.Length > 0 && args[0] == "win");
+    }
+    static ProgressState CloneProgress(ProgressState progress)
+    {
+        var copy = SaveManager.FromJson<SerializableProgress>(SaveManager.ToJson(progress.ToSerializable()));
+        return ProgressState.FromSerializable(copy.SaveData!, new DeserializationContext());
+    }
+    static void Test(bool win)
+    {
+        // Native models only: no Launch, EnterAct/Room, game action or Godot UI.
+        var simulatorType = typeof(ManagedGameOverPresentation).Assembly.GetType("Sts2Headless.RunSimulator")!;
+        simulatorType.GetMethod("EnsureModelDbInitialized", BindingFlags.Static | BindingFlags.NonPublic)!.Invoke(null, null);
+        var saves = SaveManager.Instance;
+        var store = (MockGodotFileIo)typeof(SaveManager).GetField("_saveStore", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(saves)!;
+        var player = Player.CreateForNewRun<Defect>(UnlockState.all, 1uL);
+        var run = RunState.CreateForTest(new[] { player }, seed: "TERMINAL_PRODUCTION_FIXTURE");
+        RunManager.Instance.SetUpTest(run, new NetSingleplayerGameService());
+        LocalContext.NetId = RunManager.Instance.NetService.NetId;
+        run.AppendToMapPointHistory(MapPointType.RestSite, RoomType.RestSite, null);
+        int originalRuns = saves.Progress.NumberOfRuns;
+        long originalFloors = saves.Progress.FloorsClimbed;
+        int historyCount = saves.GetRunHistoryCount();
+        saves.Progress.CurrentScore = NGameOverScreen.GetScoreThreshold(saves.GetUnlocksRemaining()) - 10;
+        var owner = new ManagedGameOverPresentation(run, player, saves);
+        Check(!saves.PrefsSave.UploadData && owner.ProfileIdentity()["store_kind"]!.Equals("native_in_memory"), "isolated native profile explicitly opts out of telemetry");
+        string initialProgress = owner.InitialProgressJson;
+        var harmony = new Harmony("terminal.production.fixture.counter");
+        harmony.Patch(AccessTools.DeclaredMethod(typeof(RunManager), nameof(RunManager.OnEnded)), postfix: new HarmonyMethod(typeof(Program), nameof(CountEnd)));
+        if (win) RunManager.Instance.OnEnded(true); // exact original WinRun first call; no gameplay kill action
+        player.Creature.SetCurrentHpInternal(0);
+        owner.AfterOriginalKill(Task.CompletedTask).GetAwaiter().GetResult();
+        owner.AfterOriginalKill(Task.CompletedTask).GetAwaiter().GetResult();
+        Check(ends == 1 && owner.Victory == win && owner.EndedRun != null, "original native end exactly once with actual result");
+        Check(!RunManager.Instance.ShouldSave && TestMode.IsOn, "native ShouldSave and TestMode restored after synchronous scopes");
+        Check(saves.Progress.NumberOfRuns == originalRuns + 1 && saves.Progress.FloorsClimbed == originalFloors + 1, "original end composition commits native run data once");
+        Check(saves.GetRunHistoryCount() == historyCount + 1 && ReferenceEquals(owner.History, RunManager.Instance.History) && owner.History!.Win == win, "original native history owner and real memory-store history persisted");
+        var entry = owner.EndedRun!.MapPointHistory.Single().Single().GetEntry(player.NetId);
+        Check(entry.CurrentHp == (win ? player.Creature.MaxHp : 0) && entry.MaxHp == player.Creature.MaxHp && entry.CurrentGold == player.Gold, "original stats method captures exact last-map player data at end boundary");
+        Check(owner.InitialProgressJson == initialProgress && SaveManager.ToJson(saves.Progress.ToSerializable()) != initialProgress, "initial native profile bytes remain frozen while real progress changes");
+        Check(owner.Stage == "intro" && owner.CanAdvance, "real intro owns an executable Continue");
+        var before = owner.Capture();
+        Check(before["complete"]!.Equals(true) && before["can_return"]!.Equals(false), "intro facts complete without invented Return");
+
+        // Direct original private-method differential is TEST ONLY. No native
+        // NGameOver receiver is created in production or registered as a screen.
+        var actualProgress = saves.Progress;
+        var referenceProgress = CloneProgress(actualProgress);
+        var bridgeProgress = CloneProgress(actualProgress);
+        var badges = BadgePool.CreateAll(owner.EndedRun, player.NetId, win).Take(2).ToList();
+        Check(badges.Count == 2, "differential uses real native Badge objects");
+        var receiver = (NGameOverScreen)RuntimeHelpers.GetUninitializedObject(typeof(NGameOverScreen));
+        typeof(NGameOverScreen).GetField("_localPlayer", BindingFlags.Instance | BindingFlags.NonPublic)!.SetValue(receiver, player);
+        var originalBadgeCommit = typeof(NGameOverScreen).GetMethod("SaveBadgesToProgress", BindingFlags.Instance | BindingFlags.NonPublic)!;
+        try
+        {
+            saves.Progress = referenceProgress;
+            originalBadgeCommit.Invoke(receiver, new object[] { badges });
+            originalBadgeCommit.Invoke(receiver, new object[] { badges });
+            ManagedGameOverPresentation.ApplyNativeBadgeMutation(bridgeProgress, player, badges);
+            ManagedGameOverPresentation.ApplyNativeBadgeMutation(bridgeProgress, player, badges);
+            Check(SaveManager.ToJson(referenceProgress.ToSerializable()) == SaveManager.ToJson(bridgeProgress.ToSerializable()), "new and existing badge counts exactly match original native private commit");
+        }
+        finally { saves.Progress = actualProgress; }
+
+        var simulator = Activator.CreateInstance(simulatorType)!;
+        Set(simulator, "_runState", run); Set(simulator, "_gameOverPresentation", owner);
+        var advance = simulatorType.GetMethod("DoAdvanceGameOver", BindingFlags.Instance | BindingFlags.NonPublic)!;
+        var args = new Dictionary<string, object?> { ["owner_ref"] = before["owner_ref"], ["control_ref"] = before["continue_control_ref"] };
+        var successor = (Dictionary<string, object?>)advance.Invoke(simulator, new object[] { args })!;
+        var facts = (Dictionary<string, object?>)successor["terminal_public"]!;
+        Check(successor["decision"]!.Equals("game_over") && facts["stage"]!.Equals("summary"), "actual production Continue route produces a real summary successor");
+        Check(facts["complete"]!.Equals(false) && facts["can_return"]!.Equals(false)
+            && ((string[])facts["missing"]!).Contains("managed_game_over_return_navigation"), "summary honestly incomplete while navigation owner is absent");
+        Check(owner.Discoveries != null && ((string[])owner.Discoveries["epochs"]!).SequenceEqual(player.DiscoveredEpochs), "summary captures original discovered epoch facts after native effects");
+        string path = ProgressSaveManager.GetProgressPathForProfile(saves.CurrentProfileId);
+        var persisted = SaveManager.FromJson<SerializableProgress>(store.ReadFile(path) ?? throw new Exception("Native progress bytes missing"));
+        Check(persisted.Success && persisted.SaveData!.CurrentScore == saves.Progress.CurrentScore, "native progress save actually readable in original memory store");
+        int writes = store.Calls.Count(x => x.Method == MockGodotFileIo.Methods.writeFile);
+        var repeated = (Dictionary<string, object?>)advance.Invoke(simulator, new object[] { args })!;
+        Check(repeated["type"]!.Equals("error") && store.Calls.Count(x => x.Method == MockGodotFileIo.Methods.writeFile) == writes && ends == 1, "old Continue rejects without another native end or profile commit");
+        Check(!RunManager.Instance.ShouldSave && TestMode.IsOn, "native flags remain restored after summary");
+        Console.WriteLine(JsonSerializer.Serialize(new { mode = win ? "win" : "loss", checks, native_end_calls = ends,
+            original_runs = originalRuns, final_runs = saves.Progress.NumberOfRuns, score = owner.Score,
+            history_count = saves.GetRunHistoryCount(), stage = owner.Stage, summary_complete = facts["complete"], profile = owner.ProfileIdentity(),
+            discoveries = owner.Discoveries, no_game = true, assembly_sha256 = Convert.ToHexString(SHA256.HashData(File.ReadAllBytes(typeof(ManagedGameOverPresentation).Assembly.Location))).ToLowerInvariant(),
+            assembly_mvid = typeof(ManagedGameOverPresentation).Assembly.ManifestModule.ModuleVersionId }));
+        Console.WriteLine($"{checks} terminal production native mechanism checks passed");
+    }
+}
