+        Set(player,"<IsActiveForHooks>k__BackingField",true);Set(player,"<Deck>k__BackingField",new CardPile(PileType.Deck));
+        Set(player,"_relics",new List<RelicModel>{wing});Set(player,"_potionSlots",new List<PotionModel?>());
+        reward.CanReroll=false;
