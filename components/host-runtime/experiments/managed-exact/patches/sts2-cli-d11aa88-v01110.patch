+    private static void TestSelectorView(Player player, CardModel card)
+    {
+        int before = checks;
+        var assembly = typeof(NativeCardRewardAlternativePreview).Assembly;
+        Type type = assembly.GetType("Sts2Headless.DeckUpgradeSelection")!;
+        object prefs = Activator.CreateInstance(typeof(MegaCrit.Sts2.Core.CardSelection.CardSelectorPrefs))!;
+        object owner = Activator.CreateInstance(type, BindingFlags.Instance | BindingFlags.NonPublic, null,
+            new object[] { player, prefs, new List<CardModel> { card } }, null)!;
+        const BindingFlags flags = BindingFlags.Instance | BindingFlags.NonPublic;
+        var completion = new TaskCompletionSource<IEnumerable<CardModel>>();
+        type.GetProperty("Completion", flags)!.SetValue(owner, completion.Task);
+        var selected = (List<CardModel>)type.GetProperty("Selected", flags)!.GetValue(owner)!;
+        selected.Add(card);
+        var toggle = type.GetMethod("ToggleUpgradeView", flags)!;
+        Check(toggle.Invoke(owner, null) == null && (bool)type.GetProperty("ShowingUpgradePreviews", flags)!.GetValue(owner)!,
+            "actual Managed selector presentation toggles upgrade view");
+        Check(selected.Count == 1 && ReferenceEquals(selected[0], card) && !completion.Task.IsCompleted
+            && ReferenceEquals(type.GetProperty("Completion", flags)!.GetValue(owner), completion.Task),
+            "view toggle preserves original card operands and original callback Task");
+        Check(toggle.Invoke(owner, null) == null && !(bool)type.GetProperty("ShowingUpgradePreviews", flags)!.GetValue(owner)!,
+            "upgrade view can return to original presentation");
+        Set(owner, "<IsPreview>k__BackingField", true);
+        Check(toggle.Invoke(owner, null) is string && !(bool)type.GetProperty("ShowingUpgradePreviews", flags)!.GetValue(owner)!,
+            "active confirmation preview cannot toggle the selection-grid view");
