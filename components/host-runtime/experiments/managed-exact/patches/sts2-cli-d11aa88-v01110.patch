@@ -0,0 +1,24 @@
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Entities.Merchant;
+using MegaCrit.Sts2.Core.TestSupport;
+
+namespace Sts2Headless;
+
+// The shipped synchronous CalcCost consumes the Shops stream. TestMode skips
+// that gameplay branch; only this original call runs with its shipped flag.
+// No inventory/capture recalculation, replacement RNG, or async scope.
+internal static class NativeMerchantPotionCost
+{
+    internal static void Install(Harmony harmony)
+    {
+        var method = AccessTools.DeclaredMethod(typeof(MerchantPotionEntry), nameof(MerchantPotionEntry.CalcCost), Type.EmptyTypes)
+            ?? throw new MissingMethodException(typeof(MerchantPotionEntry).FullName, nameof(MerchantPotionEntry.CalcCost));
+        harmony.Patch(method,
+            prefix: new HarmonyMethod(typeof(NativeMerchantPotionCost), nameof(Prefix)),
+            finalizer: new HarmonyMethod(typeof(NativeMerchantPotionCost), nameof(Finalizer)));
+    }
+    public static void Prefix(out bool __state)
+    { __state = TestMode.IsOn; TestMode.IsOn = false; }
+    public static Exception? Finalizer(bool __state, Exception? __exception)
+    { TestMode.IsOn = __state; return __exception; }
+}
