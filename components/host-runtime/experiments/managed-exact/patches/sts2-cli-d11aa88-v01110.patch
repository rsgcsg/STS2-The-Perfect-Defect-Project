+
+// In the pinned build FromDeckForTransformation invokes ICardSelector before its first
+// suspension. The callback interface loses prefs, so retain only this exact
+// invocation frame. It never authorizes a different selector or later callback.
+internal static class DeckTransformCallScope
+{
+    internal static bool HookReady { get; set; }
+    internal sealed class Frame
+    {
+        internal Frame(Player player, CardSelectorPrefs preferences,
+            ICardSelector? selector, bool isDefaultTransformation, Frame? previous)
+        {
+            Player = player;
+            Preferences = preferences;
+            Selector = selector;
+            IsDefaultTransformation = isDefaultTransformation;
+            Previous = previous;
+        }
+        internal Player Player { get; }
+        internal CardSelectorPrefs Preferences { get; }
+        internal ICardSelector? Selector { get; }
+        internal Frame? Previous { get; }
+        internal bool IsDefaultTransformation { get; }
+        internal bool Consumed { get; set; }
+        internal bool Closed { get; set; }
+    }
+
+    [ThreadStatic] private static Frame? _current;
+
+    public static void Prefix(Player player, CardSelectorPrefs prefs,
+        Func<CardModel, CardTransformation>? cardToTransformation, out Frame __state)
+    {
+        // The original method assigns its random default after this entry seam.
+        // A custom delegate can expose deterministic after facts; never invoke it to probe.
+        __state = new Frame(player, prefs, CardSelectCmd.Selector, cardToTransformation == null, _current);
+        _current = __state;
+    }
+
+    public static Exception? Finalizer(Frame? __state, Exception? __exception)
+    {
+        if (__state != null)
+        {
+            __state.Closed = true;
+            if (ReferenceEquals(_current, __state)) _current = __state.Previous;
+            else _current = null;
+        }
+        return __exception;
+    }
+
+    internal static bool TryTake(ICardSelector selector, int minSelect, int maxSelect,
+        out Player? player, out CardSelectorPrefs preferences, out bool isDefaultTransformation, out bool mismatch)
+    {
+        player = null;
+        preferences = default;
+        isDefaultTransformation = false;
+        Frame? frame = _current;
+        mismatch = frame != null;
+        if (frame == null || frame.Closed || frame.Consumed
+            || !ReferenceEquals(frame.Selector, selector)
+            || frame.Preferences.MinSelect != minSelect
+            || frame.Preferences.MaxSelect != maxSelect)
+            return false;
+        frame.Consumed = true;
+        player = frame.Player;
+        preferences = frame.Preferences;
+        isDefaultTransformation = frame.IsDefaultTransformation;
+        mismatch = false;
+        return true;
+    }
+}
diff --git a/src/Sts2Headless/DeckUpgradeCallScope.cs b/src/Sts2Headless/DeckUpgradeCallScope.cs
new file mode 100644
index 0000000..09a76de
--- /dev/null
+++ b/src/Sts2Headless/DeckUpgradeCallScope.cs
@@ -0,0 +1,72 @@
+using MegaCrit.Sts2.Core.CardSelection;
+using MegaCrit.Sts2.Core.Commands;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.TestSupport;
+
+namespace Sts2Headless;
+
+// CardSelectCmd.FromDeckForUpgrade invokes ICardSelector synchronously before its
+// first await in the pinned game build. Carry its actual preferences through
+// that exact call, never through a process-wide latest selector or room guess.
+internal static class DeckUpgradeCallScope
+{
+    internal static bool HookReady { get; set; }
+    internal sealed class Frame
+    {
+        internal Frame(Player player, CardSelectorPrefs preferences, ICardSelector? selector, Frame? previous)
+        {
+            Player = player;
+            Preferences = preferences;
+            Selector = selector;
+            Previous = previous;
+        }
+
+        internal Player Player { get; }
+        internal CardSelectorPrefs Preferences { get; }
+        internal ICardSelector? Selector { get; }
+        internal Frame? Previous { get; }
+        internal bool Consumed { get; set; }
+        internal bool Closed { get; set; }
+    }
+
+    [ThreadStatic] private static Frame? _current;
+
+    public static void Prefix(Player player, CardSelectorPrefs prefs, out Frame __state)
+    {
+        __state = new Frame(player, prefs, CardSelectCmd.Selector, _current);
+        _current = __state;
+    }
+
+    public static Exception? Finalizer(Frame? __state, Exception? __exception)
+    {
+        if (__state != null)
+        {
+            __state.Closed = true;
+            if (ReferenceEquals(_current, __state)) _current = __state.Previous;
+            else _current = null; // Unexpected nesting cannot authorize a later callback.
+        }
+        return __exception;
+    }
+
+    // A null frame means some other selector source. A present but mismatched
+    // frame is an exact-build drift/error, and the caller must fail closed.
+    internal static bool TryTake(
+        ICardSelector selector, int minSelect, int maxSelect,
+        out Player? player, out CardSelectorPrefs preferences, out bool mismatch)
+    {
+        player = null;
+        preferences = default;
+        Frame? frame = _current;
+        mismatch = frame != null;
+        if (frame == null || frame.Closed || frame.Consumed
+            || !ReferenceEquals(frame.Selector, selector)
+            || frame.Preferences.MinSelect != minSelect
+            || frame.Preferences.MaxSelect != maxSelect)
+            return false;
+        frame.Consumed = true;
+        player = frame.Player;
+        preferences = frame.Preferences;
+        mismatch = false;
+        return true;
+    }
+}
diff --git a/src/Sts2Headless/DeckUpgradeSelection.cs b/src/Sts2Headless/DeckUpgradeSelection.cs
new file mode 100644
index 0000000..6493751
--- /dev/null
+++ b/src/Sts2Headless/DeckUpgradeSelection.cs
@@ -0,0 +1,91 @@
+using MegaCrit.Sts2.Core.CardSelection;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Models;
+
+namespace Sts2Headless;
+
+// Headless presentation state for one game-owned FromDeckForUpgrade choice.
+// Completion still returns the exact selected CardModel objects to STS2.
+internal sealed class DeckUpgradeSelection
+{
+    internal DeckUpgradeSelection(Player player, CardSelectorPrefs preferences, List<CardModel> options)
+    {
+        Player = player;
+        Preferences = preferences;
+        Options = options;
+    }
+
+    internal object Identity { get; } = new();
+    internal Task? Completion { get; set; }
+    internal Player Player { get; }
+    internal CardSelectorPrefs Preferences { get; }
+    internal List<CardModel> Options { get; }
+    internal List<CardModel> Selected { get; } = new();
+    internal bool IsPreview { get; private set; }
+    internal bool ShowingUpgradePreviews { get; private set; }
+    internal string? ToggleUpgradeView()
+    {
+        if (IsPreview) return "Upgrade view is unavailable on this current selector stage";
+        ShowingUpgradePreviews = !ShowingUpgradePreviews;
+        return null;
+    }
+
+
+    internal string? Validate(object? selectorRef, Player currentPlayer)
+    {
+        if (!ReferenceEquals(Player, currentPlayer)
+            || !NativeObjectIdentity.Matches(Identity, selectorRef))
+            return "The exact deck-upgrade selector is no longer current";
+        return null;
+    }
+
+    internal string? Select(object? cardRef)
+    {
+        if (IsPreview) return "The deck-upgrade preview owns input";
+        CardModel[] matches = Options.Where(card => NativeObjectIdentity.Matches(card, cardRef)).Take(2).ToArray();
+        if (matches.Length != 1) return "The exact upgrade card is no longer an option";
+        CardModel card = matches[0];
+        if (Selected.Any(value => ReferenceEquals(value, card))
+            || Selected.Count >= Preferences.MaxSelect || !card.IsUpgradable
+            || !PileType.Deck.GetPile(Player).Cards.Any(value => ReferenceEquals(value, card)))
+            return "The exact upgrade card is no longer selectable";
+        Selected.Add(card);
+        if (Selected.Count == Preferences.MaxSelect) IsPreview = true;
+        return null;
+    }
+
+    internal string? Deselect(object? cardRef)
+    {
+        if (IsPreview) return "The deck-upgrade preview owns input";
+        int index = Selected.FindIndex(card => NativeObjectIdentity.Matches(card, cardRef));
+        if (index < 0) return "The exact upgrade card is no longer selected";
+        Selected.RemoveAt(index);
+        return null;
+    }
+
+    internal string? CancelPreview()
+    {
+        if (!IsPreview) return "The deck-upgrade preview is no longer current";
+        Selected.Clear();
+        IsPreview = false;
+        return null;
+    }
+
+    internal string? CanCancelSelection() => IsPreview || !Preferences.Cancelable
+        ? "Native deck-upgrade selection cancel is unavailable"
+        : null;
+
+    internal string? CanConfirm(object? selectedRefs)
+    {
+        if (!IsPreview || Selected.Count < Preferences.MinSelect
+            || Selected.Count > Preferences.MaxSelect
+            || Selected.Any(card => !card.IsUpgradable
+                || !Options.Any(option => ReferenceEquals(option, card))
+                || !PileType.Deck.GetPile(Player).Cards.Any(value => ReferenceEquals(value, card))))
+            return "The exact deck-upgrade selection is no longer confirmable";
+        string expected = string.Join(",", Selected.Select(NativeObjectIdentity.Get));
+        return selectedRefs is string value && value == expected
+            ? null : "The exact selected upgrade cards changed";
+    }
+}
diff --git a/src/Sts2Headless/FairPileProjection.cs b/src/Sts2Headless/FairPileProjection.cs
new file mode 100644
index 0000000..b11b0f2
--- /dev/null
+++ b/src/Sts2Headless/FairPileProjection.cs
@@ -0,0 +1,30 @@
+using System.Text.Json;
+
+namespace Sts2Headless;
+
+// A read-only information projection. Native cards, RNG and pile mutation stay
+// in RunSimulator/game code; only the declared visible DTO facts enter here.
+internal static class FairPileProjection
+{
+    private static readonly string[] VisibleFields =
+        ["id", "name", "type", "cost", "description", "rarity", "is_upgraded"];
+
+    public static Dictionary<string, object?> Create(
+        string pile, IEnumerable<Dictionary<string, object?>> source)
+    {
+        var visible = source.Select(card => VisibleFields
+            .Where(card.ContainsKey)
+            .ToDictionary(field => field, field => card[field], StringComparer.Ordinal));
+        // A native Draw pile is not its normally inspectable presentation order.
+        // Project first, sort only visible values, retain equal occurrences.
+        var cards = (pile == "draw"
+            ? visible.OrderBy(card => JsonSerializer.Serialize(card), StringComparer.Ordinal)
+            : visible).ToArray();
+        return new Dictionary<string, object?>
+        {
+            ["pile"] = pile,
+            ["ordering_semantics"] = pile == "draw" ? "unordered_multiset" : "native_visible_order",
+            ["cards"] = cards,
+        };
+    }
+}
diff --git a/src/Sts2Headless/ManagedEventPresentation.cs b/src/Sts2Headless/ManagedEventPresentation.cs
new file mode 100644
index 0000000..749d9ee
--- /dev/null
+++ b/src/Sts2Headless/ManagedEventPresentation.cs
@@ -0,0 +1,38 @@
+using MegaCrit.Sts2.Core.Events;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Rooms;
+
+namespace Sts2Headless;
+
+// NEventRoom.SetOptions replaces a finished event's empty CurrentOptions with
+// one real native EventOption. NEventRoom.Proceed opens the map presentation;
+// the later native map vote owns the room exit. Retain that explicit control.
+internal sealed class ManagedEventPresentation
+{
+    internal EventRoom Room { get; }
+    internal EventModel Event { get; }
+    private EventOption? _proceed;
+    private readonly Action _openMap;
+
+    internal ManagedEventPresentation(EventRoom room, EventModel model, Action openMap)
+    {
+        Room = room;
+        Event = model;
+        _openMap = openMap;
+    }
+
+    internal bool Matches(EventRoom room, EventModel model) =>
+        ReferenceEquals(Room, room) && ReferenceEquals(Event, model)
+        && ReferenceEquals(room.LocalMutableEvent, model);
+
+    internal IReadOnlyList<EventOption> CurrentOptions
+    {
+        get
+        {
+            if (!Event.IsFinished) return Event.CurrentOptions;
+            _proceed ??= new EventOption(Event, () => { _openMap(); return Task.CompletedTask; },
+                "PROCEED", false, true);
+            return new[] { _proceed };
+        }
+    }
+}
diff --git a/src/Sts2Headless/ManagedGameOverPresentation.cs b/src/Sts2Headless/ManagedGameOverPresentation.cs
new file mode 100644
index 0000000..9ecb038
--- /dev/null
+++ b/src/Sts2Headless/ManagedGameOverPresentation.cs
@@ -0,0 +1,270 @@
+using System.Reflection;
+using System.Security.Cryptography;
+using System.Text;
+using System.Runtime.CompilerServices;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Commands;
+using MegaCrit.Sts2.Core.Context;
+using MegaCrit.Sts2.Core.Entities.Creatures;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Models.Badges;
+using MegaCrit.Sts2.Core.Nodes.Screens.GameOverScreen;
+using MegaCrit.Sts2.Core.Platform.Steam;
+using MegaCrit.Sts2.Core.Runs;
+using MegaCrit.Sts2.Core.Runs.History;
+using MegaCrit.Sts2.Core.Saves;
+using MegaCrit.Sts2.Core.Saves.Test;
+using MegaCrit.Sts2.Core.TestSupport;
+
+namespace Sts2Headless;
+
+// The input/presentation owner is a real headless shell over the ended native
+// run. It never claims to be a Godot node. STS2 still calculates/commits run
+// history, progress, badges and epoch unlocks; no screen or navigation is faked.
+public sealed class ManagedGameOverPresentation : IDisposable
+{
+    public static bool HookReady { get; private set; }
+    private static readonly ConditionalWeakTable<RunState, ManagedGameOverPresentation> Owners = new();
+    private static readonly PropertyInfo ShouldSaveProperty = typeof(RunManager).GetProperty(nameof(RunManager.ShouldSave))!;
+    [ThreadStatic] private static EndScope? ActiveEnd;
+    private readonly RunState run;
+    private readonly Player player;
+    private readonly SaveManager saves;
+    private readonly ProgressState progress;
+    private readonly int profileId;
+    private bool disposed;
+    private bool endAttempted;
+    private bool continueStarted;
+    private readonly object continueControl = new();
+    private readonly object viewRunControl = new();
+    public string InitialProgressJson { get; }
+    public Dictionary<string, object?> ProfileIdentity() => new()
+    {
+        ["profile_id"] = profileId, ["store_kind"] = "native_in_memory",
+        ["initial_progress_json_sha256"] = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(InitialProgressJson))).ToLowerInvariant(),
+        ["upload_data"] = saves.PrefsSave.UploadData, ["steam_initialized"] = SteamInitializer.Initialized,
+    };
+    public SerializableRun? EndedRun { get; private set; }
+    public RunHistory? History { get; private set; }
+    public bool? Victory { get; private set; }
+    public string Stage { get; private set; } = "end_pending";
+    public int? Score { get; private set; }
+    public IReadOnlyDictionary<string, object?>? Discoveries { get; private set; }
+    public bool CanAdvance => Current() && Stage == "intro" && !continueStarted;
+
+    public ManagedGameOverPresentation(RunState run, Player player, SaveManager saves)
+    {
+        if (!HookReady) throw new InvalidOperationException("Exact native terminal capture hooks are unavailable");
+        var store = typeof(SaveManager).GetField("_saveStore", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(saves);
+        if (!TestMode.IsOn || store is not MockGodotFileIo || SteamInitializer.Initialized)
+            throw new InvalidOperationException("Managed terminal requires the isolated native memory profile without Steam");
+        if (run.GameMode != GameMode.Standard || !ReferenceEquals(player.RunState, run) ||
+            run.Players.Count != 1 || !ReferenceEquals(run.Players[0], player))
+            throw new InvalidOperationException("Managed terminal requires the original standard single-player run");
+        this.run = run;
+        this.player = player;
+        this.saves = saves;
+        progress = saves.Progress;
+        profileId = saves.CurrentProfileId;
+        InitialProgressJson = SaveManager.ToJson(progress.ToSerializable());
+        // This is the isolated in-memory profile, never a user's preferences.
+        // OnEnded includes native metrics; TestMode does not disable uploads.
+        saves.PrefsSave.UploadData = false;
+        Owners.Add(run, this);
+    }
+
+    private bool Current() => !disposed && ReferenceEquals(SaveManager.Instance, saves)
+        && ReferenceEquals(saves.Progress, progress) && saves.CurrentProfileId == profileId
+        && ReferenceEquals(RunManager.Instance.DebugOnlyGetState(), run)
+        && ReferenceEquals(LocalContext.GetMe(run), player);
+
+    private void RequireCurrent()
+    {
+        if (!Current()) throw new InvalidOperationException("Managed terminal original run/profile owner changed");
+    }
+
+    public static void Install(Harmony harmony)
+    {
+        harmony.Patch(AccessTools.DeclaredMethod(typeof(RunManager), nameof(RunManager.OnEnded)),
+            prefix: new HarmonyMethod(typeof(ManagedGameOverPresentation), nameof(BeforeEnd)),
+            postfix: new HarmonyMethod(typeof(ManagedGameOverPresentation), nameof(AfterEnd)),
+            finalizer: new HarmonyMethod(typeof(ManagedGameOverPresentation), nameof(EndFinalizer)));
+        harmony.Patch(AccessTools.DeclaredMethod(typeof(RunManager), "UpdatePlayerStatsInMapPointHistory"),
+            prefix: new HarmonyMethod(typeof(ManagedGameOverPresentation), nameof(BeforeEndStats)),
+            finalizer: new HarmonyMethod(typeof(ManagedGameOverPresentation), nameof(StatsFinalizer)));
+        harmony.Patch(AccessTools.DeclaredMethod(typeof(CreatureCmd), nameof(CreatureCmd.Kill),
+            new[] { typeof(IReadOnlyCollection<Creature>), typeof(bool) }),
+            prefix: new HarmonyMethod(typeof(ManagedGameOverPresentation), nameof(BeforeKill)),
+            postfix: new HarmonyMethod(typeof(ManagedGameOverPresentation), nameof(AfterKill)));
+        HookReady = true;
+    }
+
+    public sealed record EndScope(ManagedGameOverPresentation Owner, bool OldShouldSave, EndScope? Previous);
+    public static void BeforeEnd(RunManager __instance, out EndScope? __state)
+    {
+        __state = null;
+        if (__instance.DebugOnlyGetState() is not { } nativeRun || !Owners.TryGetValue(nativeRun, out var owner)) return;
+        owner.RequireCurrent();
+        if (owner.EndedRun != null) return;
+        if (owner.endAttempted) throw new InvalidOperationException("Original native end already failed; it cannot be retried");
+        owner.endAttempted = true;
+        owner.Stage = "end_committing";
+        __state = new EndScope(owner, __instance.ShouldSave, ActiveEnd);
+        ActiveEnd = __state;
+        // Run the existing OnEnded composition once, including actual native
+        // UpdateProgressWithRunData/CreateRunHistoryEntry on the memory store.
+        ShouldSaveProperty.SetValue(__instance, true);
+    }
+
+    public static void AfterEnd(RunManager __instance, bool isVictory, SerializableRun __result, EndScope? __state)
+    {
+        if (__state == null) return;
+        var owner = __state.Owner;
+        owner.RequireCurrent();
+        owner.History = __instance.History ?? throw new InvalidOperationException("Original native end did not create run history");
+        owner.EndedRun = __result;
+        owner.Victory = isVictory;
+        owner.Score = ScoreUtility.CalculateScore(__result, isVictory);
+        owner.Stage = "intro";
+    }
+
+    public static Exception? EndFinalizer(RunManager __instance, EndScope? __state, Exception? __exception)
+    {
+        if (__state != null)
+        {
+            ShouldSaveProperty.SetValue(__instance, __state.OldShouldSave);
+            ActiveEnd = __state.Previous;
+            if (__exception != null) __state.Owner.Stage = "end_failed";
+        }
+        return __exception;
+    }
+
+    public static void BeforeEndStats(RunManager __instance, out bool? __state)
+    {
+        __state = null;
+        if (ActiveEnd is not { } frame || !ReferenceEquals(__instance.DebugOnlyGetState(), frame.Owner.run)) return;
+        // Only this original synchronous stats method needs the non-TestMode
+        // branch. No async Kill/OnEnded scope runs with TestMode disabled.
+        __state = TestMode.IsOn;
+        TestMode.IsOn = false;
+    }
+    public static Exception? StatsFinalizer(bool? __state, Exception? __exception)
+    { if (__state.HasValue) TestMode.IsOn = __state.Value; return __exception; }
+
+    public static void BeforeKill(IReadOnlyCollection<Creature> creatures, out RunState? __state)
+    { __state = creatures.FirstOrDefault(c => c.IsPlayer)?.Player?.RunState as RunState; }
+    public static void AfterKill(RunState? __state, ref Task __result)
+    {
+        if (__state != null && Owners.TryGetValue(__state, out var owner))
+            __result = owner.AfterOriginalKill(__result);
+    }
+    public async Task AfterOriginalKill(Task original)
+    {
+        await original;
+        var manager = RunManager.Instance;
+        if (EndedRun != null || endAttempted || !Current() || !manager.IsInProgress || manager.IsCleaningUp ||
+            !run.Players.All(p => p.Creature.IsDead)) return;
+        // Native TestMode Kill omits this one loss call. WinRun's original
+        // OnEnded(true) is captured above before GuaranteeKillAllPlayers.
+        manager.OnEnded(false);
+    }
+
+    public bool Matches(object? owner, object? control) => CanAdvance
+        && NativeObjectIdentity.Matches(this, owner) && NativeObjectIdentity.Matches(continueControl, control);
+
+    public void Advance(object? owner, object? control)
+    {
+        RequireCurrent();
+        if (!Matches(owner, control) || EndedRun == null || Victory == null)
+            throw new InvalidOperationException("The current terminal Continue control changed or already committed");
+        continueStarted = true;
+        Stage = "summary_committing";
+        // NGameOverScreen.AnimateRunSummary order: score lines (read-only),
+        // badges, score bar, discoveries. UI animations add no native effects.
+        var badges = ScoreUtility.GetBadges(EndedRun, player.NetId, Victory.Value);
+        if (!EndedRun.GameMode.AreAchievementsAndEpochsLocked())
+        {
+            ApplyNativeBadgeMutation(progress, player, badges);
+            saves.SaveProgressFile();
+        }
+        ApplyNativeScoreBarEffects(EndedRun, Victory.Value);
+        Discoveries = new Dictionary<string, object?>
+        {
+            ["cards"] = player.DiscoveredCards.ToArray(), ["relics"] = player.DiscoveredRelics.ToArray(),
+            ["potions"] = player.DiscoveredPotions.ToArray(), ["enemies"] = player.DiscoveredEnemies.ToArray(),
+            ["epochs"] = player.DiscoveredEpochs.ToArray(),
+        };
+        Stage = "summary";
+    }
+
+    // Exact nonvisual mutation from this build's NGameOverScreen.SaveBadgesToProgress.
+    // Badge outcomes/rarity are calculated by native GetBadges. The bridge owns
+    // only this missing headless presentation commit, tested against that method.
+    public static void ApplyNativeBadgeMutation(ProgressState progress, Player player, List<Badge> badges)
+    {
+        var stats = progress.CharacterStats[player.Character.Id];
+        foreach (var badge in badges)
+        {
+            var existing = stats.Badges.FirstOrDefault(x => x.Id.Equals(badge.Id) && x.Rarity == badge.Rarity);
+            if (existing == null) stats.Badges.Add(new BadgeStats { Id = badge.Id, Count = 1, Rarity = badge.Rarity });
+            else existing.Count++;
+        }
+    }
+
+    private void ApplyNativeScoreBarEffects(SerializableRun ended, bool victory)
+    {
+        int score = ScoreUtility.CalculateScore(ended, victory);
+        int remaining = saves.GetUnlocksRemaining();
+        if (remaining <= 0) return;
+        int current = saves.GetCurrentScore();
+        int threshold = NGameOverScreen.GetScoreThreshold(remaining);
+        if (current + score >= threshold)
+        {
+            int next = NGameOverScreen.GetScoreThreshold(remaining - 1);
+            var epoch = saves.GrantNextUnlock();
+            if (epoch != null)
+            {
+                player.DiscoveredEpochs.Add(epoch.Id);
+                LocalContext.GetMe(ended)!.DiscoveredEpochs.Add(epoch.Id);
+            }
+            int overflow = current - threshold + score;
+            progress.CurrentScore = next == 0 || overflow == 0 ? 0 : Math.Min(overflow, next - 1);
+        }
+        else progress.CurrentScore += score;
+        saves.SaveProgressFile();
+    }
+
+    public Dictionary<string, object?> Capture()
+    {
+        RequireCurrent();
+        bool intro = Stage == "intro" && EndedRun != null && History != null;
+        bool summary = Stage == "summary";
+        return new Dictionary<string, object?>
+        {
+            ["kind"] = "managed_game_over_presentation", ["stage"] = Stage,
+            ["owner_ref"] = NativeObjectIdentity.Get(this), ["run_ref"] = NativeObjectIdentity.Get(run),
+            ["player_ref"] = NativeObjectIdentity.Get(player),
+            ["ended_run_ref"] = EndedRun == null ? null : NativeObjectIdentity.Get(EndedRun),
+            ["history_ref"] = History == null ? null : NativeObjectIdentity.Get(History),
+            ["continue_control_ref"] = NativeObjectIdentity.Get(continueControl),
+            ["result"] = Victory.HasValue ? Victory.Value ? "win" : "loss" : null,
+            ["game_mode"] = "standard", ["can_advance_summary"] = intro && CanAdvance, ["can_return"] = false,
+            ["score"] = summary ? Score : null, ["floors_climbed"] = summary ? run.TotalFloor : null,
+            ["ascension"] = summary ? run.AscensionLevel : null,
+            ["complete"] = intro,
+            ["missing"] = intro ? Array.Empty<string>() : new[] { summary ? "managed_game_over_return_navigation" : "native_game_over_end_commit" },
+            ["other_controls"] = new[] { new Dictionary<string, object?>
+            {
+                ["control_ref"] = NativeObjectIdentity.Get(viewRunControl), ["semantic_id"] = "view_run",
+                ["label"] = "View Run", ["enabled"] = false, ["action_support"] = "visible_unsupported",
+                ["blocked_reason"] = "Run-history navigation is outside the C1 ordinary journey envelope.",
+            } },
+        };
+    }
+
+    public void Dispose()
+    {
+        disposed = true;
+        if (Owners.TryGetValue(run, out var current) && ReferenceEquals(current, this)) Owners.Remove(run);
+    }
+}
diff --git a/src/Sts2Headless/ManagedInitialProgress.cs b/src/Sts2Headless/ManagedInitialProgress.cs
new file mode 100644
index 0000000..bde41ea
--- /dev/null
+++ b/src/Sts2Headless/ManagedInitialProgress.cs
@@ -0,0 +1,75 @@
+using System.Reflection;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using MegaCrit.Sts2.Core.Combat;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Platform.Steam;
+using MegaCrit.Sts2.Core.Runs;
+using MegaCrit.Sts2.Core.Saves;
+using MegaCrit.Sts2.Core.Saves.Managers;
+using MegaCrit.Sts2.Core.Saves.Test;
+using MegaCrit.Sts2.Core.Saves.Validation;
+using MegaCrit.Sts2.Core.TestSupport;
+using MegaCrit.Sts2.Core.Timeline;
+using MegaCrit.Sts2.Core.Unlocks;
+
+namespace Sts2Headless;
+
+// One fixed manager-provided initial profile, before the native run freezes it.
+internal sealed class ManagedInitialProgress
+{
+    private bool attempted;
+    private string? inputSha;
+    private string? normalizedSha;
+    private string? unlockJson;
+    internal static string Sha(string value) => Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(value))).ToLowerInvariant();
+    internal static object DescribeUnlocks(UnlockState unlocks)
+    {
+        var native = unlocks.ToSerializable();
+        return new { unlocked_epochs = native.UnlockedEpochs.Order(StringComparer.Ordinal).ToArray(),
+            encounters_seen = native.EncountersSeen.Select(id => id.ToString()).Order(StringComparer.Ordinal).ToArray(),
+            number_of_runs = native.NumberOfRuns };
+    }
+    internal void Prepare(JsonElement? input)
+    {
+        if (input == null) return;
+        if (attempted) throw new InvalidOperationException("initial_progress_already_attempted");
+        var value = input.Value;
+        if (value.ValueKind != JsonValueKind.Object || value.GetProperty("recipe").GetString() != "normal-sp-all-unlocked-v1")
+            throw new InvalidOperationException("initial_progress_recipe_invalid");
+        string json = value.GetProperty("progress_json").GetString() ?? throw new InvalidOperationException("initial_progress_missing");
+        string sha = value.GetProperty("progress_sha256").GetString() ?? "";
+        if (Sha(json) != sha) throw new InvalidOperationException("initial_progress_sha_mismatch");
+        var saves = SaveManager.Instance;
+        if (!TestMode.IsOn || SteamInitializer.Initialized || !saves.IsProfileInitialized
+            || RunManager.Instance.DebugOnlyGetState() != null || RunManager.Instance.IsInProgress || CombatManager.Instance.IsInProgress)
+            throw new InvalidOperationException("initial_progress_requires_idle_managed_profile");
+        var store = typeof(SaveManager).GetField("_saveStore", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(saves);
+        if (store is not MockGodotFileIo memory) throw new InvalidOperationException("initial_progress_requires_native_memory_store");
+        var parsed = SaveManager.FromJson<SerializableProgress>(json);
+        if (!parsed.Success || parsed.SaveData == null) throw new InvalidOperationException("initial_progress_native_parse_failed");
+        string expected = SaveManager.ToJson(ProgressState.FromSerializable(parsed.SaveData, new DeserializationContext()).ToSerializable());
+        attempted = true; // A write or reload with uncertain outcome is never repeated.
+        memory.WriteFile(ProgressSaveManager.GetProgressPathForProfile(saves.CurrentProfileId), json);
+        var loaded = saves.InitProgressData();
+        string actual = SaveManager.ToJson(saves.Progress.ToSerializable());
+        if (!loaded.Success || loaded.SaveData == null || actual != expected)
+            throw new InvalidOperationException("initial_progress_native_reload_mismatch");
+        var unlocks = saves.GenerateUnlockStateFromProgress();
+        if (saves.Progress.EnableFtues || unlocks.NumberOfRuns <= 0
+            || !unlocks.ToSerializable().UnlockedEpochs.ToHashSet(StringComparer.Ordinal).SetEquals(EpochModel.AllEpochIds)
+            || ModelDb.AllEncounters.Any(encounter => !unlocks.HasSeenEncounter(encounter))
+            || ModelDb.AllCharacters.Any(character => saves.Progress.GetStatsForCharacter(character.Id)?.MaxAscension != 10))
+            throw new InvalidOperationException("initial_progress_baseline_incomplete");
+        inputSha = sha;
+        normalizedSha = Sha(actual);
+        unlockJson = JsonSerializer.Serialize(DescribeUnlocks(unlocks));
+    }
+    internal object? Observe(RunState? run) => inputSha == null ? null : new {
+        recipe = "normal-sp-all-unlocked-v1", progress_sha256 = inputSha,
+        normalized_progress_sha256 = normalizedSha,
+        unlock_state = run == null ? null : DescribeUnlocks(run.UnlockState),
+        run_unlock_state_matches = run != null && JsonSerializer.Serialize(DescribeUnlocks(run.UnlockState)) == unlockJson
+    };
+}
diff --git a/src/Sts2Headless/ManagedMerchantPresentation.cs b/src/Sts2Headless/ManagedMerchantPresentation.cs
new file mode 100644
index 0000000..18afe29
--- /dev/null
+++ b/src/Sts2Headless/ManagedMerchantPresentation.cs
@@ -0,0 +1,55 @@
+using MegaCrit.Sts2.Core.Entities.Merchant;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Rooms;
+using MegaCrit.Sts2.Core.Saves;
+
+namespace Sts2Headless;
+
+// UI transport over the original native room/inventory/player. The model
+// inventory is generated by MerchantRoom.Enter, not by opening its presentation.
+// Managed has no Godot NMerchantInventory; this owner replaces only that UI state.
+internal sealed class ManagedMerchantPresentation(MerchantRoom room, MerchantInventory inventory, Player player)
+{
+    internal MerchantRoom Room { get; } = room;
+    internal MerchantInventory Inventory { get; } = inventory;
+    internal Player Player { get; } = player;
+    internal bool IsOpen { get; private set; }
+    // One real Managed presentation slot per original inventory entry. These
+    // are shell-owned bindings, not Godot NMerchantSlot instances.
+    private readonly Dictionary<MerchantEntry, object> _slots = new(ReferenceEqualityComparer.Instance);
+    internal object SlotFor(MerchantEntry entry)
+    {
+        if (!_slots.TryGetValue(entry, out var slot)) _slots.Add(entry, slot = new object());
+        return slot;
+    }
+
+    internal bool Matches(MerchantRoom currentRoom, MerchantInventory currentInventory, Player currentPlayer) =>
+        ReferenceEquals(Room, currentRoom) && ReferenceEquals(Inventory, currentInventory)
+        && ReferenceEquals(Player, currentPlayer) && ReferenceEquals(currentInventory.Player, currentPlayer);
+
+    internal void Open()
+    {
+        if (IsOpen) throw new InvalidOperationException("The exact merchant inventory presentation is already open");
+        // Exact NMerchantInventory.Open's only persistent nonvisual side effect.
+        // The other native open operations are Godot animation, audio, dialogue,
+        // focus, and card relic flashes; they do not mutate the inventory model.
+        if (!SaveManager.Instance.SeenFtue("merchant_ftue"))
+            SaveManager.Instance.MarkFtueAsComplete("merchant_ftue");
+        IsOpen = true;
+    }
+
+    internal void Close()
+    {
+        if (!IsOpen) throw new InvalidOperationException("The exact merchant inventory presentation is not open");
+        // NMerchantInventory.Close changes UI ownership only; no FTUE, inventory
+        // model, RNG, or gameplay hook runs on that native path.
+        IsOpen = false;
+    }
+
+    internal Dictionary<string, object?> Capture() => new()
+    {
+        ["kind"] = "managed_merchant_presentation", ["stage"] = IsOpen ? "inventory" : "room",
+        ["room_ref"] = NativeObjectIdentity.Get(Room), ["inventory_ref"] = NativeObjectIdentity.Get(Inventory),
+        ["player_ref"] = NativeObjectIdentity.Get(Player)
+    };
+}
diff --git a/src/Sts2Headless/ManagedSelectorPublicCapture.cs b/src/Sts2Headless/ManagedSelectorPublicCapture.cs
new file mode 100644
index 0000000..ef66b55
--- /dev/null
+++ b/src/Sts2Headless/ManagedSelectorPublicCapture.cs
@@ -0,0 +1,129 @@
+using MegaCrit.Sts2.Core.CardSelection;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Models;
+using STS2Platform.NativeFoundation;
+
+namespace Sts2Headless;
+
+// Same public selector fact shape as Connector's NativeSelectorPublicProjection.
+// The Managed presentation owner and its ORIGINAL ICardSelector Task bind this
+// capture. Detached after cards remain presentation values, never input operands.
+internal static class ManagedSelectorPublicCapture
+{
+    internal sealed record Result(Dictionary<string, object?> Facts, List<Dictionary<string, object?>> Cards);
+
+    internal static Result Capture(object owner, Task? completion, string family,
+        CardSelectorPrefs prefs, IReadOnlyList<CardModel> options, IReadOnlyList<CardModel> selected,
+        bool preview, bool mechanicsQualified, bool canPreview, bool canConfirm, bool canCancel,
+        Func<CardModel, bool> selectable, EnchantmentModel? enchantment = null, int amount = 0,
+        Dictionary<string, object?>? summary = null, bool isDefaultTransformation = false,
+        PileType displayPile = PileType.Deck)
+    {
+        var missing = new HashSet<string>(StringComparer.Ordinal);
+        if (completion == null || completion.IsCompleted)
+            missing.Add("native_selector_original_request_not_pending");
+        if (!mechanicsQualified) missing.Add("native_selector_mechanics_call_closure_unqualified");
+        if (family == "deck_transform" && !isDefaultTransformation)
+            missing.Add("custom_transform_preview_unqualified");
+        var previews = new List<Dictionary<string, object?>>();
+        var cards = new List<Dictionary<string, object?>>();
+        bool requiresAfter = family == "deck_upgrade" || family == "deck_enchant" && prefs.MaxSelect == 1;
+        foreach (CardModel original in options)
+        {
+            string subject = NativeObjectIdentity.Get(original);
+            bool isSelected = selected.Contains(original, ReferenceEqualityComparer.Instance);
+            var beforeCapture = NativePublicCardDetails.Capture(original, displayPile);
+            var before = beforeCapture.PublicCard;
+            before["entity_id"] = subject;
+            before["is_selected"] = isSelected;
+            var candidateMissing = new HashSet<string>(beforeCapture.Missing, StringComparer.Ordinal);
+            NativeDetachedCardPreview? detached = null;
+            string? gap = null;
+            string displayContext = "native_original_only";
+            if (family == "deck_upgrade")
+            {
+                displayContext = "native_deck_upgrade_after";
+                NativeDetachedCardPreviewFactory.TryDeckUpgrade(original, out detached, out gap);
+            }
+            else if (family == "deck_enchant" && prefs.MaxSelect == 1 && enchantment != null)
+            {
+                displayContext = "native_single_enchantment_after";
+                NativeDetachedCardPreviewFactory.TrySingleEnchant(original, enchantment, amount, out detached, out gap);
+            }
+            if (gap != null) candidateMissing.Add(gap);
+            Dictionary<string, object?>? after = null;
+            string[] afterMissing = Array.Empty<string>();
+            string availability = requiresAfter ? "unavailable" : "not_applicable";
+            if (detached != null)
+            {
+                var afterCapture = NativePublicCardDetails.Capture(detached.Display, detached.DisplayPile, detached.PreviewMode);
+                afterMissing = afterCapture.Missing;
+                candidateMissing.UnionWith(afterCapture.Missing);
+                after = afterCapture.PublicCard;
+                after["entity_id"] = subject;
+                after["is_selected"] = false;
+                availability = afterCapture.Complete ? "available" : "unavailable";
+            }
+            if (requiresAfter && detached == null)
+                candidateMissing.Add("native_selector_required_after_presentation_unavailable");
+            if (candidateMissing.Count > 0) missing.Add("native_selector_candidate_presentation_incomplete");
+            missing.UnionWith(candidateMissing);
+            previews.Add(new()
+            {
+                ["subject_entity_id"] = subject, ["before"] = before, ["after"] = after,
+                ["display_context"] = displayContext, ["after_availability"] = availability,
+                ["before_missing"] = beforeCapture.Missing, ["after_missing"] = afterMissing,
+                ["missing"] = candidateMissing.Order(StringComparer.Ordinal).ToArray()
+            });
+            cards.Add(new(before)
+            {
+                ["index"] = cards.Count, ["id"] = before.GetValueOrDefault("definition_id"),
+                ["native_ref"] = subject, ["is_selectable"] = !preview && selectable(original),
+                ["is_deselectable"] = !preview && isSelected
+            });
+        }
+        Dictionary<string, object?>? enchantmentSummary = null;
+        if (family == "deck_enchant")
+        {
+            if (summary?.GetValueOrDefault("name") is string title && !string.IsNullOrWhiteSpace(title)
+                && summary.GetValueOrDefault("description") is string description && !string.IsNullOrWhiteSpace(description))
+                enchantmentSummary = new() { ["title"] = title, ["description"] = description, ["amount"] = amount };
+            else missing.Add("native_selector_current_enchantment_summary_unavailable");
+        }
+        var controls = new List<Dictionary<string, object?>>();
+        void Control(bool available, string operation)
+        { if (available) controls.Add(new() { ["operation"] = operation }); }
+        Control(canPreview, "open_preview");
+        Control(canConfirm, family == "deck_upgrade" ? "confirm" : "confirm_selection");
+        Control(preview, "cancel_preview");
+        Control(canCancel, "cancel_selection");
+        Control(!preview && (family == "deck_upgrade" || family == "deck_transform"), "toggle_upgrade_view");
+        bool finish = canPreview || canConfirm;
+        var request = new Dictionary<string, object?>
+        {
+            ["entity_id"] = completion == null ? null : NativeObjectIdentity.Get(completion),
+            ["owner_entity_id"] = NativeObjectIdentity.Get(owner), ["family"] = family,
+            ["stage"] = preview ? "preview" : "selecting", ["selection_model"] = "native_selected_original_set",
+            ["add_transition"] = family == "simple"
+                ? prefs.RequireManualConfirmation ? "native_manual_completion" : "native_completion_at_max"
+                : family == "combat_pile" ? "native_completion_with_display_count_clamp" : "native_preview_at_max", ["min_select"] = prefs.MinSelect, ["max_select"] = prefs.MaxSelect,
+            ["require_manual_confirmation"] = prefs.RequireManualConfirmation, ["displayed_holder_count"] = null,
+            ["selected_entity_ids"] = selected.Select(NativeObjectIdentity.Get).ToArray(),
+            ["can_finish_now"] = finish, ["can_decline_now"] = canCancel || selected.Count == 0 && finish,
+            ["mechanics_qualified"] = mechanicsQualified,
+            ["preview_information_complete"] = missing.Count == 0,
+            // This Host's preview is the same pending callback presentation; it
+            // has no Godot grid holder. All original options/prefs and the Task
+            // above remain bound, and the complete after values are frozen here.
+            ["preview_projection_qualified"] = missing.Count == 0,
+            ["capability_revision"] = "sts2.native-selector-public-facts/1",
+            ["missing"] = missing.Order(StringComparer.Ordinal).ToArray()
+        };
+        return new(new()
+        {
+            ["selector_request"] = request, ["preview_options"] = previews,
+            ["enchantment_summary"] = enchantmentSummary, ["current_controls"] = controls,
+            ["missing"] = missing.Order(StringComparer.Ordinal).ToArray()
+        }, cards);
+    }
+}
