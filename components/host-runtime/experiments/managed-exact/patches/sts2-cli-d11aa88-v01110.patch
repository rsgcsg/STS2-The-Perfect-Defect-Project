diff --git a/src/Sts2Headless/DeckGenericSelection.cs b/src/Sts2Headless/DeckGenericSelection.cs
new file mode 100644
index 0000000..d73aa87
--- /dev/null
+++ b/src/Sts2Headless/DeckGenericSelection.cs
@@ -0,0 +1,117 @@
+using MegaCrit.Sts2.Core.CardSelection;
+using MegaCrit.Sts2.Core.Entities.Cards;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Models;
+
+namespace Sts2Headless;
+
+// Presentation state for one exact game-owned FromDeckGeneric callback. Tentative
+// selections are Host-local; completing the callback returns original CardModel
+// instances and lets the suspended native command own the effect and Commit.
+internal sealed class DeckGenericSelection
+{
+    internal DeckGenericSelection(Player player, CardSelectorPrefs preferences,
+        Func<CardModel, bool>? filter, List<CardModel> options, string family = "deck_card", bool isDefaultTransformation = false)
+    {
+        Player = player;
+        Preferences = preferences;
+        Filter = filter;
+        Options = options;
+        Family = family;
+        IsDefaultTransformation = isDefaultTransformation;
+    }
+
+    internal DeckGenericSelection(Player player, CardSelectorPrefs preferences,
+        EnchantmentModel enchantment, int amount, List<CardModel> options)
+        : this(player, preferences, card => enchantment.CanEnchant(card), options)
+    {
+        Family = "deck_enchant";
+        Enchantment = enchantment;
+        Amount = amount;
+    }
+
+    internal string Family { get; }
+    internal bool IsDefaultTransformation { get; }
+    internal object Identity { get; } = new();
+    internal Task? Completion { get; set; }
+    internal Player Player { get; }
+    internal CardSelectorPrefs Preferences { get; }
+    internal Func<CardModel, bool>? Filter { get; }
+    internal List<CardModel> Options { get; }
+    // Set only for the exact FromDeckForEnchantment callback.
+    internal EnchantmentModel? Enchantment { get; }
+    internal int Amount { get; }
+    internal List<CardModel> Selected { get; } = new();
+    internal bool IsPreview { get; private set; }
+    internal bool ShowingUpgradePreviews { get; private set; }
+    internal string? ToggleUpgradeView()
+    {
+        if (IsPreview || Family != "deck_transform") return "Upgrade view is unavailable on this current selector stage";
+        ShowingUpgradePreviews = !ShowingUpgradePreviews;
+        return null;
+    }
+
+
+    internal string? Validate(object? selectorRef, Player currentPlayer)
+        => ReferenceEquals(Player, currentPlayer) && NativeObjectIdentity.Matches(Identity, selectorRef)
+            ? null : "The exact deck-card selector is no longer current";
+
+    private bool Current(CardModel card) =>
+        Options.Any(option => ReferenceEquals(option, card))
+        && PileType.Deck.GetPile(Player).Cards.Any(value => ReferenceEquals(value, card))
+        && (Filter == null || Filter(card));
+
+    internal bool CanSelect(CardModel card) => !IsPreview && Selected.Count < Preferences.MaxSelect
+        && !Selected.Any(value => ReferenceEquals(value, card))
+        && Options.Any(option => ReferenceEquals(option, card));
+
+    internal string? Select(object? cardRef)
+    {
+        if (IsPreview) return "The deck-card preview owns input";
+        CardModel[] matches = Options.Where(card => NativeObjectIdentity.Matches(card, cardRef)).Take(2).ToArray();
+        if (matches.Length != 1 || !CanSelect(matches[0]) || !Current(matches[0]))
+            return "The exact deck card is no longer selectable";
+        Selected.Add(matches[0]);
+        if (Selected.Count == Preferences.MaxSelect) IsPreview = true;
+        return null;
+    }
+
+    internal string? Deselect(object? cardRef)
+    {
+        if (IsPreview) return "The deck-card preview owns input";
+        int index = Selected.FindIndex(card => NativeObjectIdentity.Matches(card, cardRef));
+        if (index < 0) return "The exact deck card is no longer selected";
+        Selected.RemoveAt(index);
+        return null;
+    }
+
+    internal string? BeginPreview()
+    {
+        if (IsPreview || Preferences.MinSelect == Preferences.MaxSelect
+            || Selected.Count < Preferences.MinSelect)
+            return "The deck-card selection is not ready for preview";
+        IsPreview = true;
+        return null;
+    }
+
+    internal string? CancelPreview()
+    {
+        if (!IsPreview) return "The deck-card preview is no longer current";
+        Selected.Clear();
+        IsPreview = false;
+        return null;
+    }
+
+    internal string? CanCancelSelection() => IsPreview || !Preferences.Cancelable
+        ? "Native deck-card selection cancel is unavailable" : null;
+
+    internal string? CanConfirm(object? selectedRefs)
+    {
+        if (!IsPreview || Selected.Count < Preferences.MinSelect
+            || Selected.Count > Preferences.MaxSelect || Selected.Any(card => !Current(card)))
+            return "The exact deck-card selection is no longer confirmable";
+        string expected = string.Join(",", Selected.Select(NativeObjectIdentity.Get));
+        return selectedRefs is string value && value == expected
+            ? null : "The exact selected deck cards changed";
+    }
+}
