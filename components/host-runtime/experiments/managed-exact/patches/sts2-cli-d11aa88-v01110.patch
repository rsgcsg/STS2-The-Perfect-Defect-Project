+using System.Reflection;
+using System.Text.Json;
+using MegaCrit.Sts2.Core.DevConsole.ConsoleCommands;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Models;
+using MegaCrit.Sts2.Core.Models.Characters;
+using MegaCrit.Sts2.Core.Runs;
+using MegaCrit.Sts2.Core.Saves;
+using MegaCrit.Sts2.Core.Saves.Test;
+using Sts2Headless;
+
+class Program
+{
+    static int checks;
+    static void Check(bool value, string message) { if (!value) throw new Exception(message); checks++; }
+    static JsonElement Input(string json, string? sha = null) => JsonSerializer.SerializeToElement(new {
+        recipe = "normal-sp-all-unlocked-v1", progress_json = json,
+        progress_sha256 = sha ?? ManagedInitialProgress.Sha(json) });
+    static void Main()
+    {
+        typeof(RunSimulator).GetMethod("EnsureModelDbInitialized", BindingFlags.Static | BindingFlags.NonPublic)!.Invoke(null, null);
+        var save = SaveManager.Instance;
+        new UnlockConsoleCmd().Process(null, new[] { "all" });
+        foreach (var encounter in ModelDb.AllEncounters) save.Progress.GetOrCreateEncounterStats(encounter.Id);
+        save.Progress.GetOrCreateCharacterStats(ModelDb.GetId<Defect>()).TotalLosses = 1;
+        save.SetFtuesEnabled(false);
+        save.SaveProgressFile();
+        var loaded = save.InitProgressData();
+        Check(loaded.Success, "actual native prepared progress reloads");
+        string json = SaveManager.ToJson(loaded.SaveData!);
+        string normalized = SaveManager.ToJson(save.Progress.ToSerializable());
+        var memory = (MockGodotFileIo)typeof(SaveManager).GetField("_saveStore", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(save)!;
+        int Writes() => memory.Calls.Count(call => call.Method == MockGodotFileIo.Methods.writeFile);
+        int before = Writes();
+        try { new ManagedInitialProgress().Prepare(Input(json, new string('0', 64))); throw new Exception("hash accepted"); }
+        catch (InvalidOperationException ex) { Check(ex.Message == "initial_progress_sha_mismatch" && Writes() == before, "invalid bytes fail before writes"); }
+        var failed = new ManagedInitialProgress();
+        memory.ShouldFailWrites = true;
+        try { failed.Prepare(Input(json)); throw new Exception("write failure swallowed"); }
+        catch (InvalidOperationException ex) { Check(ex.Message == "Simulated write failure", "actual memory-store failure remains explicit"); }
+        memory.ShouldFailWrites = false;
+        before = Writes();
+        try { failed.Prepare(Input(json)); throw new Exception("retried uncertain write"); }
+        catch (InvalidOperationException ex) { Check(ex.Message == "initial_progress_already_attempted" && Writes() == before, "unknown write never retried"); }
+        var owner = new ManagedInitialProgress();
+        owner.Prepare(Input(json));
+        Check(SaveManager.ToJson(save.Progress.ToSerializable()) == normalized, "same native progress normalization survives memory write and reload");
+        var unlocks = save.GenerateUnlockStateFromProgress();
+        var player = Player.CreateForNewRun<Defect>(unlocks, 1uL);
+        var run = RunState.CreateForNewRun(new[] { player }, ActModel.GetDefaultList().Select(act => act.ToMutable()).ToList(),
+            Array.Empty<ModifierModel>(), GameMode.Standard, 0, "BASELINE_FIXTURE");
+        var proof = JsonSerializer.SerializeToElement(owner.Observe(run));
+        Check(proof.GetProperty("progress_sha256").GetString() == ManagedInitialProgress.Sha(json)
+            && proof.GetProperty("run_unlock_state_matches").GetBoolean(), "normal Standard initializer freezes the same native UnlockState");
+        Check(run.Rng.StringSeed == "BASELINE_FIXTURE" && player.Gold == ModelDb.Character<Defect>().StartingGold,
+            "original run seed and initial gold remain native");
+        RunManager.Instance.SetUpTest(run, new MegaCrit.Sts2.Core.Multiplayer.NetSingleplayerGameService());
+        before = Writes();
+        try { new ManagedInitialProgress().Prepare(Input(json)); throw new Exception("active run accepted"); }
+        catch (InvalidOperationException ex) { Check(ex.Message == "initial_progress_requires_idle_managed_profile" && Writes() == before, "active native run refuses profile replacement"); }
+        Console.WriteLine($"PASS {checks} native initial-progress checks; no Launch or game input");
+    }
+}
