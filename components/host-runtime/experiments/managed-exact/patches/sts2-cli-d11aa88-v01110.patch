+using Sts2Headless;
+
+static void Require(bool condition, string caseName)
+{
+    if (!condition)
+        throw new InvalidOperationException($"Play-window contract failed: {caseName}");
+}
+
+static bool Open(
+    bool playerPlayPhase = true,
+    bool partOfPlayerTurn = true,
+    bool playerActionsEnabled = true,
+    bool notReadyToEndTurn = true,
+    bool actionQueuePlayPhase = true) => NativePlayWindowAdmission.IsOpen(
+        combatRoomCurrent: true,
+        currentRunOwned: true,
+        combatInProgress: true,
+        playerAlive: true,
+        playerPlayPhase: playerPlayPhase,
+        partOfPlayerTurn: partOfPlayerTurn,
+        playerActionsEnabled: playerActionsEnabled,
+        notReadyToEndTurn: notReadyToEndTurn,
+        actionQueuePlayPhase: actionQueuePlayPhase);
+
+Require(Open(), "all native owner facts open");
+Require(!Open(playerPlayPhase: false), "non-play player phase");
+Require(!Open(partOfPlayerTurn: false), "different player's turn");
+Require(!Open(playerActionsEnabled: false), "native actions disabled");
+Require(!Open(notReadyToEndTurn: false), "player already ready to end turn");
+Require(!Open(actionQueuePlayPhase: false), "action synchronizer outside PlayPhase");
+Console.WriteLine("5 native play-window blockers and positive case passed");
