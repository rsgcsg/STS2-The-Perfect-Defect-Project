{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2.policy-runtime/policy-manifest-1",
  "title": "STS2 Policy Manifest identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_id", "policy", "adapter", "artifact", "representation", "requirements", "support", "adapter_config", "claims"],
  "properties": {
    "schema": { "const": "sts2.policy-runtime/policy-manifest-1" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "policy": { "type": "object", "additionalProperties": false, "required": ["id", "version", "provider", "architecture"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "provider": { "type": "string", "minLength": 1 }, "architecture": { "type": "string", "minLength": 1 } } },
    "adapter": { "type": "object", "additionalProperties": false, "required": ["id", "version", "protocol", "code_sha256"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "protocol": { "const": "sts2.policy-runtime/decision-only-ndjson-1" }, "code_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["id", "path", "sha256"], "properties": { "id": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
    "representation": { "type": "object", "additionalProperties": false, "required": ["id", "version", "input_schema"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "input_schema": { "enum": ["sts2.player-environment/snapshot-1", "sts2.player-environment/text-menu-snapshot-1"] } } },
    "requirements": { "type": "object", "additionalProperties": false, "required": ["connector_protocol_version", "environment", "reads", "whole_decision_admission", "candidate_order_digest", "score_count_matches_candidate_count", "selected_index", "successor_required"], "properties": { "connector_protocol_version": { "type": "string", "minLength": 1 }, "environment": { "type": "object", "additionalProperties": false, "required": ["host_kind", "connector_version", "connector_source_revision", "connector_artifact_sha256", "connector_module_version_id", "modset_status", "modset_fingerprint", "loaded_mod_ids"], "properties": { "host_kind": { "enum": ["live_ui", "headless", "replay", "test"] }, "connector_version": { "type": "string", "minLength": 1 }, "connector_source_revision": { "type": "string", "minLength": 1 }, "connector_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "connector_module_version_id": { "type": "string", "minLength": 1 }, "modset_status": { "type": "string", "minLength": 1 }, "modset_fingerprint": { "type": "string", "minLength": 1 }, "loaded_mod_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } }, "reads": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "whole_decision_admission": { "const": true }, "candidate_order_digest": { "enum": ["sha256-json-bound-action-id-order", "sha256-json-menu-action-id-order"] }, "score_count_matches_candidate_count": { "const": true }, "selected_index": { "const": true }, "successor_required": { "const": true } } },
    "support": { "type": "object", "additionalProperties": false, "required": ["game_versions", "game_commits", "interaction_kinds", "action_verbs"], "properties": { "game_versions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }, "game_commits": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }, "interaction_kinds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true }, "action_verbs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true } } },
    "adapter_config": { "type": "object" },
    "claims": { "type": "object", "additionalProperties": false, "required": ["full_run", "selector", "catalog_filtered", "creates_action_authority", "creates_native_operands"], "properties": { "full_run": { "type": "boolean" }, "selector": { "type": "boolean" }, "catalog_filtered": { "const": false }, "creates_action_authority": { "const": false }, "creates_native_operands": { "const": false } } }
  }
,
  "allOf": [{
    "if": { "properties": { "representation": { "properties": { "input_schema": { "const": "sts2.player-environment/text-menu-snapshot-1" } } } } },
    "then": { "properties": { "requirements": { "properties": { "candidate_order_digest": { "const": "sha256-json-menu-action-id-order" }, "reads": { "maxItems": 0 } } } } },
    "else": { "properties": { "requirements": { "properties": { "candidate_order_digest": { "const": "sha256-json-bound-action-id-order" } } } } }
  }]
}
