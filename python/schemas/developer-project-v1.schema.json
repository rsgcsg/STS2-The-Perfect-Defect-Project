{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://stpd.dev/schemas/developer-project-v1.schema.json",
  "properties": {
    "schema": {
      "const": "stpd/developer-project-v1"
    },
    "state_dir": {
      "type": "string",
      "minLength": 1
    },
    "hub_url": {
      "type": "string"
    },
    "platform_url": {
      "type": "string"
    },
    "delivery_config": {
      "type": [
        "string",
        "null"
      ]
    },
    "research_workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "store_dir": {
          "type": "string",
          "minLength": 1
        },
        "registry_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "store_dir",
        "registry_path"
      ]
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "stpd/developer-combination-v1"
        },
        "platform_repository": {
          "enum": [
            "https://github.com/rsgcsg/STS2-AI-PLATFORM.git",
            "https://github.com/rsgcsg/STS2-The-Pefect-Defect-Project.git",
            "https://github.com/rsgcsg/STS2-The-Perfect-Defect-Project.git"
          ]
        },
        "platform_source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "evidence_source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "policy_mode": {
          "const": "existing-adapter-only"
        },
        "node_packages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "package": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "source_revision": {
                "type": "string",
                "minLength": 1
              },
              "component_tree_revision": {
                "type": "string",
                "minLength": 1
              },
              "release_asset_sha256": {
                "type": "string",
                "minLength": 1
              },
              "package_content_sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "package",
              "version",
              "source_revision",
              "component_tree_revision",
              "release_asset_sha256",
              "package_content_sha256"
            ]
          }
        }
      },
      "required": [
        "schema",
        "platform_repository",
        "platform_source_revision",
        "evidence_source_revision",
        "policy_mode",
        "node_packages"
      ]
    },
    "remote_training": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "spireagent/remote-training-configuration-v1"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schema": {
                "const": "spireagent/configured-training-target-v1"
              },
              "placement_id": {
                "enum": [
                  "modal-cpu",
                  "modal-cuda"
                ]
              },
              "recipe_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "worker_capability": {
                "const": "structured-m2-slice-v1"
              },
              "placement": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "provider": {
                    "const": "modal"
                  },
                  "account_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "environment": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "image_object_id": {
                    "type": "string",
                    "pattern": "^im-[A-Za-z0-9_-]{1,96}$"
                  },
                  "gpu": {
                    "enum": [
                      "none",
                      "L4",
                      "A10",
                      "L40S",
                      "A100-40GB",
                      "A100-80GB",
                      "H100!"
                    ]
                  },
                  "device": {
                    "enum": [
                      "cpu",
                      "cuda:0"
                    ]
                  }
                },
                "required": [
                  "provider",
                  "account_id",
                  "environment",
                  "image_object_id",
                  "gpu",
                  "device"
                ]
              },
              "runtime": {
                "type": "object",
                "properties": {
                  "device": {
                    "enum": [
                      "cpu",
                      "cuda:0"
                    ]
                  },
                  "dtype": {
                    "const": "float32"
                  },
                  "torch_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 96
                  },
                  "python_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 96
                  }
                },
                "required": [
                  "device",
                  "dtype",
                  "torch_version",
                  "python_version"
                ]
              },
              "producer": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "uv_lock_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "repository",
                  "source_revision",
                  "uv_lock_sha256"
                ]
              },
              "code_closure_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "qualification_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "limits": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_optimizer_updates": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "max_boundaries": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "wall_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  "startup_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  },
                  "max_request_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65536
                  },
                  "max_projection_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 268435456
                  },
                  "max_candidate_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 268435456
                  },
                  "max_artifacts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4096
                  },
                  "cpu_millicores": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64000
                  },
                  "memory_mib": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 262144
                  },
                  "cost_authorization_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "max_cost_microusd": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000000000
                  }
                },
                "required": [
                  "max_optimizer_updates",
                  "max_boundaries",
                  "wall_seconds",
                  "startup_seconds",
                  "max_request_bytes",
                  "max_projection_bytes",
                  "max_candidate_bytes",
                  "max_artifacts",
                  "cpu_millicores",
                  "memory_mib",
                  "cost_authorization_id",
                  "max_cost_microusd"
                ]
              },
              "max_operation_cost_microusd": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "cleanup_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600
              }
            },
            "required": [
              "schema",
              "placement_id",
              "recipe_id",
              "worker_capability",
              "placement",
              "runtime",
              "producer",
              "code_closure_sha256",
              "qualification_id",
              "limits",
              "max_operation_cost_microusd",
              "cleanup_seconds"
            ]
          }
        }
      },
      "required": [
        "schema",
        "targets"
      ]
    }
  },
  "required": [
    "schema",
    "state_dir",
    "hub_url",
    "platform_url",
    "delivery_config",
    "combination"
  ]
}
